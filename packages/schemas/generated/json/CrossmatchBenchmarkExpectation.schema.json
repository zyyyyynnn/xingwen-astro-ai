{
  "$defs": {
    "CrossmatchMethod": {
      "enum": [
        "exact_identifier",
        "curated_entity_alias",
        "coordinate",
        "compound"
      ],
      "title": "CrossmatchMethod",
      "type": "string"
    },
    "MatchTopology": {
      "enum": [
        "one_to_one",
        "one_to_many",
        "many_to_one",
        "many_to_many"
      ],
      "title": "MatchTopology",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conflict_codes": {
      "default": [],
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Conflict Codes",
      "type": "array"
    },
    "conflict_group_count": {
      "minimum": 0,
      "title": "Conflict Group Count",
      "type": "integer"
    },
    "expected_error_code": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Error Code"
    },
    "inconclusive_count": {
      "minimum": 0,
      "title": "Inconclusive Count",
      "type": "integer"
    },
    "manual_adjudication_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manual Adjudication Count"
    },
    "methods": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CrossmatchMethod"
      },
      "title": "Methods",
      "type": "array"
    },
    "paired_count": {
      "minimum": 0,
      "title": "Paired Count",
      "type": "integer"
    },
    "planet_assertion_count": {
      "minimum": 0,
      "title": "Planet Assertion Count",
      "type": "integer"
    },
    "review_required_count": {
      "minimum": 0,
      "title": "Review Required Count",
      "type": "integer"
    },
    "topologies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MatchTopology"
      },
      "title": "Topologies",
      "type": "array"
    },
    "unmatched_count": {
      "minimum": 0,
      "title": "Unmatched Count",
      "type": "integer"
    }
  },
  "required": [
    "paired_count",
    "conflict_group_count",
    "unmatched_count",
    "inconclusive_count",
    "review_required_count",
    "planet_assertion_count"
  ],
  "title": "CrossmatchBenchmarkExpectation",
  "type": "object"
}
