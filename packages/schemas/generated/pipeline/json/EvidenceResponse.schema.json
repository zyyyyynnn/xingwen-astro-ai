{
  "$defs": {
    "EvidenceType": {
      "enum": [
        "database_query",
        "paper_search",
        "paper_metadata",
        "paper_text",
        "model_extraction",
        "reasoning_trace",
        "user_feedback",
        "cache_record"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "Locator": {
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Locator",
      "type": "object"
    },
    "SourceSnapshot": {
      "description": "Compact SourceSnapshot projection returned by task-read endpoints.",
      "properties": {
        "query_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Hash"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        }
      },
      "required": [
        "retrieved_at"
      ],
      "title": "SourceSnapshot",
      "type": "object"
    }
  },
  "properties": {
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "content": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "extraction_method": {
      "title": "Extraction Method",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "locator": {
      "anyOf": [
        {
          "$ref": "#/$defs/Locator"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "paper_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Paper Id"
    },
    "quote_or_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote Or Value"
    },
    "source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Id"
    },
    "source_snapshot": {
      "$ref": "#/$defs/SourceSnapshot"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    },
    "target_type": {
      "title": "Target Type",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/EvidenceType"
    }
  },
  "required": [
    "id",
    "task_id",
    "type",
    "target_type",
    "target_id",
    "extraction_method",
    "source_snapshot",
    "confidence",
    "created_at"
  ],
  "title": "EvidenceResponse",
  "type": "object"
}
