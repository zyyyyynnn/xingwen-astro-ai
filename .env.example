# App
# development：本地默认；integration/test：挂载 test-only bootstrap（仅真实 Compose/Browser 集成使用）；
# production：启用全部安全校验，禁止默认凭据。
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 本地 HTTP 默认关闭；production 配置必须显式设为 true。
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400
SESSION_CREATE_RATE_LIMIT=30
SESSION_RETENTION_SECONDS=2592000
SHARE_CREATE_RATE_LIMIT=20
SHARE_RETENTION_SECONDS=2592000
CURSOR_SIGNING_KEY=development-only-cursor-signing-key

# Local service ports
SITE_PORT=4321
WORKSPACE_PORT=5173
API_PORT=8000
POSTGRES_PORT=5432

# Frontend
# PUBLIC_* 与 VITE_* 会进入浏览器输出，只能包含非敏感配置。
PUBLIC_WORKSPACE_URL=http://localhost:5173/workspace
# 仅为 API origin，不得预带 /api 路径；路径来自生成的 operation metadata。
VITE_API_BASE_URL=http://localhost:8000
VITE_SITE_URL=http://localhost:4321

# Database
# 本地占位值仅用于 Docker Compose；production 必须覆盖且禁止使用 postgres 默认密码。
POSTGRES_DB=xingwen_astro_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/xingwen_astro_ai
# 后端 PostgreSQL 集成测试使用的隔离数据库，库名必须包含 test。
# 不设时 PostgreSQL 门控测试按设计 skip；CI backend job 已配置。
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/xingwen_test_db

# Research assistant (server-only; never expose these values through PUBLIC_* or VITE_*).
# Use the official environment name documented by the Qwen AI Platform.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
DASHSCOPE_MODEL_REVISION=qwen3.7-plus-2026-05-26
DASHSCOPE_TIMEOUT_SECONDS=45

# Research Input ingestion
RESEARCH_INPUT_MAX_SIZE_BYTES=26214400
RESEARCH_INPUT_ALLOWED_MIME_TYPES=application/pdf,text/csv,application/json,image/png,image/jpeg,image/webp,image/gif,text/plain
RESEARCH_INPUT_UPLOAD_DIR=.data/research-inputs
RESEARCH_INPUT_RATE_LIMIT=30
REVISION_WRITE_RATE_LIMIT=30
# Idempotency 预留的租约窗口必须大于 URL fetch 的最大超时预算。
RESEARCH_INPUT_IDEMPOTENCY_LEASE_SECONDS=300
# URL 抓取默认 fail closed：只允许 HTTPS，空 host allowlist 拒绝所有外部抓取。
URL_FETCH_ALLOWED_PROTOCOLS=https
URL_FETCH_ALLOWED_HOSTS=
URL_FETCH_TIMEOUT_SECONDS=15
URL_FETCH_MAX_REDIRECTS=3
URL_FETCH_MAX_RESPONSE_BYTES=26214400
