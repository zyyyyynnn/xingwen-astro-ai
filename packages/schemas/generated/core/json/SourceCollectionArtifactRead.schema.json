{
  "$defs": {
    "CrossmatchSide": {
      "enum": [
        "left",
        "right"
      ],
      "title": "CrossmatchSide",
      "type": "string"
    },
    "DataArtifactProducer": {
      "additionalProperties": false,
      "properties": {
        "conversion_catalog_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Conversion Catalog Content Hash",
          "type": "string"
        },
        "conversion_catalog_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Conversion Catalog Id",
          "type": "string"
        },
        "conversion_catalog_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Conversion Catalog Version",
          "type": "string"
        },
        "mapping_rule_set_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Mapping Rule Set Content Hash",
          "type": "string"
        },
        "mapping_rule_set_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Mapping Rule Set Id",
          "type": "string"
        },
        "mapping_rule_set_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Mapping Rule Set Version",
          "type": "string"
        },
        "producer_name": {
          "minLength": 1,
          "title": "Producer Name",
          "type": "string"
        },
        "producer_type": {
          "const": "algorithm",
          "default": "algorithm",
          "title": "Producer Type",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Producer Version",
          "type": "string"
        }
      },
      "required": [
        "producer_name",
        "producer_version",
        "mapping_rule_set_id",
        "mapping_rule_set_version",
        "mapping_rule_set_content_hash",
        "conversion_catalog_id",
        "conversion_catalog_version",
        "conversion_catalog_content_hash"
      ],
      "title": "DataArtifactProducer",
      "type": "object"
    },
    "DataQualityProjection": {
      "additionalProperties": false,
      "description": "Persisted Data Quality Evaluation attestation bound to one published data candidate.",
      "properties": {
        "bundle_commitment": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Bundle Commitment",
          "type": "string"
        },
        "candidate_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Content Hash",
          "type": "string"
        },
        "candidate_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate_input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Input Hash",
          "type": "string"
        },
        "candidate_kind": {
          "enum": [
            "dataset",
            "field_dictionary",
            "source_collection"
          ],
          "title": "Candidate Kind",
          "type": "string"
        },
        "candidate_output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Output Hash",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "evaluation_commitment": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evaluation Commitment",
          "type": "string"
        },
        "evaluation_plan_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evaluation Plan Content Hash",
          "type": "string"
        },
        "overall_status": {
          "const": "pass",
          "title": "Overall Status",
          "type": "string"
        },
        "quality_input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Quality Input Hash",
          "type": "string"
        },
        "quality_result_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Quality Result Content Hash",
          "type": "string"
        },
        "quality_result_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Quality Result Id",
          "type": "string"
        },
        "quality_result_input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Quality Result Input Hash",
          "type": "string"
        },
        "quality_result_output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Quality Result Output Hash",
          "type": "string"
        },
        "research_contract": {
          "$ref": "#/$defs/DataQualityProjectionReference"
        },
        "rule_set": {
          "$ref": "#/$defs/DataQualityProjectionReference"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "candidate_kind",
        "candidate_id",
        "candidate_input_hash",
        "candidate_output_hash",
        "candidate_content_hash",
        "quality_input_hash",
        "quality_result_id",
        "quality_result_input_hash",
        "quality_result_output_hash",
        "quality_result_content_hash",
        "evaluation_plan_content_hash",
        "evaluation_commitment",
        "bundle_commitment",
        "rule_set",
        "research_contract",
        "overall_status",
        "content_hash"
      ],
      "title": "DataQualityProjection",
      "type": "object"
    },
    "DataQualityProjectionReference": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Version"
        }
      },
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "title": "DataQualityProjectionReference",
      "type": "object"
    },
    "DataQueryCursor": {
      "additionalProperties": false,
      "properties": {
        "tid": {
          "minimum": 0,
          "title": "Tid",
          "type": "integer"
        },
        "toi": {
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
          "title": "Toi",
          "type": "string"
        }
      },
      "required": [
        "tid",
        "toi"
      ],
      "title": "DataQueryCursor",
      "type": "object"
    },
    "DataSourceCompletion": {
      "additionalProperties": false,
      "description": "Typed source-completion semantics consumed by downstream data stages.",
      "properties": {
        "continuation_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataQueryCursor"
            },
            {
              "$ref": "#/$defs/SupplementalDataQueryCursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation Cursor"
        },
        "status": {
          "$ref": "#/$defs/DataSourceCompletionStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "DataSourceCompletion",
      "type": "object"
    },
    "DataSourceCompletionStatus": {
      "description": "Whether the bounded acquisition proved that its source scope is complete.",
      "enum": [
        "complete",
        "truncated",
        "unknown"
      ],
      "title": "DataSourceCompletionStatus",
      "type": "string"
    },
    "DataSourceDataLevel": {
      "description": "Acquisition evidence level, kept separate from the source origin.",
      "enum": [
        "live_result",
        "recorded_response",
        "fixture",
        "seed"
      ],
      "title": "DataSourceDataLevel",
      "type": "string"
    },
    "EvidenceDetail": {
      "additionalProperties": false,
      "description": "Evidence bound to one immutable version and source snapshot.",
      "properties": {
        "artifact_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Version Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evidence Type",
          "type": "string"
        },
        "extraction_method": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Extraction Method",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Locator",
          "type": "object"
        },
        "paper_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Id"
        },
        "quote_or_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "target_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "target_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "artifact_version_id",
        "target_type",
        "target_id",
        "evidence_type",
        "source_snapshot_id",
        "locator",
        "extraction_method",
        "confidence",
        "created_at"
      ],
      "title": "EvidenceDetail",
      "type": "object"
    },
    "JsonValue": {},
    "ManifestPins": {
      "additionalProperties": false,
      "properties": {
        "case_manifest_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Case Manifest Content Hash",
          "type": "string"
        },
        "case_manifest_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Case Manifest Id",
          "type": "string"
        },
        "case_manifest_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Case Manifest Version",
          "type": "string"
        },
        "field_manifest_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Field Manifest Content Hash",
          "type": "string"
        },
        "field_manifest_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Field Manifest Id",
          "type": "string"
        },
        "field_manifest_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Field Manifest Version",
          "type": "string"
        }
      },
      "required": [
        "case_manifest_id",
        "case_manifest_version",
        "case_manifest_content_hash",
        "field_manifest_id",
        "field_manifest_version",
        "field_manifest_content_hash"
      ],
      "title": "ManifestPins",
      "type": "object"
    },
    "ProducerExecutionDetail": {
      "additionalProperties": false,
      "description": "Reproducible producer metadata with private execution state excluded.",
      "properties": {
        "error_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "output_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "parameters_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Parameters Hash",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerReference"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "failed",
            "rejected",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "step_attempt_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Step Attempt Id",
          "type": "string"
        },
        "step_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Step Key",
          "type": "string"
        },
        "token_usage": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Usage"
        }
      },
      "required": [
        "id",
        "run_id",
        "step_key",
        "step_attempt_id",
        "producer",
        "parameters",
        "parameters_hash",
        "input_hash",
        "status",
        "started_at"
      ],
      "title": "ProducerExecutionDetail",
      "type": "object"
    },
    "ProducerReference": {
      "additionalProperties": false,
      "properties": {
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "model_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Provider"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parameters_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters Hash"
        },
        "prompt_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Hash"
        },
        "prompt_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Name"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "type": {
          "enum": [
            "pipeline",
            "model",
            "algorithm"
          ],
          "title": "Type",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "version"
      ],
      "title": "ProducerReference",
      "type": "object"
    },
    "RawSourceRecordReference": {
      "additionalProperties": false,
      "properties": {
        "query_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Query Hash",
          "type": "string"
        },
        "raw_record_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Raw Record Content Hash",
          "type": "string"
        },
        "row_key": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "minLength": 1,
                "type": "string"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Row Key",
          "type": "array"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_snapshot_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Snapshot Content Hash",
          "type": "string"
        },
        "source_snapshot_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_snapshot_id",
        "source_snapshot_content_hash",
        "query_hash",
        "row_key",
        "raw_record_content_hash"
      ],
      "title": "RawSourceRecordReference",
      "type": "object"
    },
    "SourceCollectionArtifactCandidate": {
      "additionalProperties": false,
      "properties": {
        "alignment_record_keys": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Alignment Record Keys",
          "type": "array"
        },
        "candidate_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "conflict_record_keys": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Conflict Record Keys",
          "type": "array"
        },
        "conversion_catalog_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Conversion Catalog Content Hash",
          "type": "string"
        },
        "conversion_catalog_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Conversion Catalog Id",
          "type": "string"
        },
        "conversion_catalog_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Conversion Catalog Version",
          "type": "string"
        },
        "crossmatch_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Crossmatch Content Hash",
          "type": "string"
        },
        "crossmatch_result_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Crossmatch Result Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "inconclusive_record_keys": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Inconclusive Record Keys",
          "type": "array"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "kind": {
          "const": "source_collection",
          "default": "source_collection",
          "title": "Kind",
          "type": "string"
        },
        "manifest_pins": {
          "$ref": "#/$defs/ManifestPins"
        },
        "mapping_rule_set_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Mapping Rule Set Content Hash",
          "type": "string"
        },
        "mapping_rule_set_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Mapping Rule Set Id",
          "type": "string"
        },
        "mapping_rule_set_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Mapping Rule Set Version",
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/SourceCollectionMember"
          },
          "title": "Members",
          "type": "array"
        },
        "output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/DataArtifactProducer"
        },
        "quality_evaluation_status": {
          "const": "not_evaluated",
          "default": "not_evaluated",
          "title": "Quality Evaluation Status",
          "type": "string"
        },
        "review_required_record_keys": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Review Required Record Keys",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_snapshot_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "source_value_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Source Value Ids",
          "type": "array"
        }
      },
