        },
        "producer_name": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Producer Name",
          "type": "string"
        },
        "producer_type": {
          "const": "model",
          "default": "model",
          "title": "Producer Type",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Producer Version",
          "type": "string"
        },
        "prompt_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Prompt Hash",
          "type": "string"
        },
        "prompt_name": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Prompt Name",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 512,
          "minLength": 1,
