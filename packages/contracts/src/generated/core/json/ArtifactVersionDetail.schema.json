        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "identity"
      ],
      "title": "PublicPresentationTableRow",
      "type": "object"
    },
    "PublicPresentationTrace": {
      "additionalProperties": false,
      "description": "Presentation-safe reasoning trace with private execution facts removed.",
      "properties": {
        "conclusion": {
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "facts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicPresentationFact"
          },
          "title": "Facts",
          "type": "array"
        },
        "steps": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        },
        "trace_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "conclusion",
        "steps"
      ],
      "title": "PublicPresentationTrace",
      "type": "object"
    },
    "SourceMode": {
      "description": "Actual origin of an ArtifactVersion-compatible pipeline payload.",
      "enum": [
        "fixture",
        "recorded",
        "live",
        "cached"
      ],
      "title": "SourceMode",
      "type": "string"
    },
    "SourceSnapshotDetail": {
      "additionalProperties": false,
      "description": "Reproducible source metadata after the application redaction boundary.",
      "properties": {
        "cache_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Version"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "license_note": {
          "minLength": 1,
          "title": "License Note",
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/JsonValue"
