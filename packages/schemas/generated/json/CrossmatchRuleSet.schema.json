{
  "$defs": {
    "ConfidencePolicy": {
      "additionalProperties": false,
      "properties": {
        "high_minimum": {
          "maximum": 1,
          "minimum": 0,
          "title": "High Minimum",
          "type": "number"
        },
        "low_minimum": {
          "maximum": 1,
          "minimum": 0,
          "title": "Low Minimum",
          "type": "number"
        },
        "medium_minimum": {
          "maximum": 1,
          "minimum": 0,
          "title": "Medium Minimum",
          "type": "number"
        }
      },
      "required": [
        "high_minimum",
        "medium_minimum",
        "low_minimum"
      ],
      "title": "ConfidencePolicy",
      "type": "object"
    },
    "CoordinatePolicy": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "const": "ICRS",
          "default": "ICRS",
          "title": "Frame",
          "type": "string"
        },
        "manual_review_separation_arcsec": {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Manual Review Separation Arcsec",
          "type": "number"
        },
        "strict_separation_arcsec": {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Strict Separation Arcsec",
          "type": "number"
        },
        "unit": {
          "const": "degree",
          "default": "degree",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "strict_separation_arcsec",
        "manual_review_separation_arcsec"
      ],
      "title": "CoordinatePolicy",
      "type": "object"
    },
    "CrossmatchCapacityPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_candidate_pairs": {
          "exclusiveMinimum": 0,
          "maximum": 10000000,
          "title": "Max Candidate Pairs",
          "type": "integer"
        },
        "max_left_records": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Max Left Records",
          "type": "integer"
        },
        "max_right_records": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Max Right Records",
          "type": "integer"
        }
      },
      "required": [
        "max_left_records",
        "max_right_records",
        "max_candidate_pairs"
      ],
      "title": "CrossmatchCapacityPolicy",
      "type": "object"
    },
    "CrossmatchMethod": {
      "enum": [
        "exact_identifier",
        "curated_entity_alias",
        "coordinate",
        "compound"
      ],
      "title": "CrossmatchMethod",
      "type": "string"
    },
    "EntityLevel": {
      "enum": [
        "host_star",
        "planet_candidate",
        "planet_assertion"
      ],
      "title": "EntityLevel",
      "type": "string"
    },
    "MethodConfidencePolicy": {
      "additionalProperties": false,
      "properties": {
        "compound": {
          "maximum": 1,
          "minimum": 0,
          "title": "Compound",
          "type": "number"
        },
        "coordinate_review": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coordinate Review",
          "type": "number"
        },
        "coordinate_strict": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coordinate Strict",
          "type": "number"
        },
        "curated_entity_alias": {
          "maximum": 1,
          "minimum": 0,
          "title": "Curated Entity Alias",
          "type": "number"
        },
        "exact_identifier": {
          "maximum": 1,
          "minimum": 0,
          "title": "Exact Identifier",
          "type": "number"
        }
      },
      "required": [
        "exact_identifier",
        "curated_entity_alias",
        "coordinate_strict",
        "coordinate_review",
        "compound"
      ],
      "title": "MethodConfidencePolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alias_policy_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Alias Policy Version",
      "type": "string"
    },
    "alias_requires_corroboration": {
      "title": "Alias Requires Corroboration",
      "type": "boolean"
    },
    "capacity": {
      "$ref": "#/$defs/CrossmatchCapacityPolicy"
    },
    "capacity_policy_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Capacity Policy Version",
      "type": "string"
    },
    "case_manifest_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Case Manifest Content Hash",
      "type": "string"
    },
    "case_manifest_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Case Manifest Id",
      "type": "string"
    },
    "case_manifest_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Case Manifest Version",
      "type": "string"
    },
    "confidence": {
      "$ref": "#/$defs/ConfidencePolicy"
    },
    "conflict_policy_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Conflict Policy Version",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "coordinate": {
      "$ref": "#/$defs/CoordinatePolicy"
    },
    "coordinate_policy_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Coordinate Policy Version",
      "type": "string"
    },
    "created_at": {
      "format": "date",
      "title": "Created At",
      "type": "string"
    },
    "entity_alias_catalog_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Entity Alias Catalog Content Hash",
      "type": "string"
    },
    "entity_alias_catalog_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Entity Alias Catalog Version",
      "type": "string"
    },
    "field_manifest_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Field Manifest Content Hash",
      "type": "string"
    },
    "field_manifest_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Field Manifest Id",
      "type": "string"
    },
    "field_manifest_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Field Manifest Version",
      "type": "string"
    },
    "identifier_policy_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Identifier Policy Version",
      "type": "string"
    },
    "maintained_by": {
      "minLength": 1,
      "title": "Maintained By",
      "type": "string"
    },
    "method_confidence": {
      "$ref": "#/$defs/MethodConfidencePolicy"
    },
    "method_priority": {
      "items": {
        "$ref": "#/$defs/CrossmatchMethod"
      },
      "minItems": 1,
      "title": "Method Priority",
      "type": "array"
    },
    "name_policy_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Name Policy Version",
      "type": "string"
    },
    "producer_name": {
      "minLength": 1,
      "title": "Producer Name",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Producer Version",
      "type": "string"
    },
    "rule_set_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Rule Set Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_policy_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Policy Content Hash",
      "type": "string"
    },
    "source_policy_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Source Policy Version",
      "type": "string"
    },
    "supported_entity_levels": {
      "items": {
        "$ref": "#/$defs/EntityLevel"
      },
      "minItems": 1,
      "title": "Supported Entity Levels",
      "type": "array"
    },
    "version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "rule_set_id",
    "schema_version",
    "version",
    "content_hash",
    "producer_name",
    "producer_version",
    "case_manifest_id",
    "case_manifest_version",
    "case_manifest_content_hash",
    "field_manifest_id",
    "field_manifest_version",
    "field_manifest_content_hash",
    "source_policy_version",
    "source_policy_content_hash",
    "identifier_policy_version",
    "name_policy_version",
    "alias_policy_version",
    "coordinate_policy_version",
    "entity_alias_catalog_version",
    "entity_alias_catalog_content_hash",
    "capacity_policy_version",
    "conflict_policy_version",
    "supported_entity_levels",
    "method_priority",
    "alias_requires_corroboration",
    "capacity",
    "coordinate",
    "confidence",
    "method_confidence",
    "created_at",
    "maintained_by"
  ],
  "title": "CrossmatchRuleSet",
  "type": "object"
}
