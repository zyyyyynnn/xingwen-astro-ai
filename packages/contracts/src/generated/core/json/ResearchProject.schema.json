{
  "$defs": {
    "ResearchThreadSummary": {
      "additionalProperties": false,
      "description": "Bounded server-derived Thread facts used by Project navigation reads.",
      "properties": {
        "has_thread_entries": {
          "title": "Has Thread Entries",
          "type": "boolean"
        },
        "has_unanswered_clarification": {
          "title": "Has Unanswered Clarification",
          "type": "boolean"
        },
        "latest_thread_actor": {
          "anyOf": [
            {
              "enum": [
                "user",
                "assistant",
                "system"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Thread Actor"
        }
      },
      "required": [
        "has_thread_entries",
        "latest_thread_actor",
        "has_unanswered_clarification"
      ],
      "title": "ResearchThreadSummary",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "queued",
        "planning",
        "fetching_data",
        "cleaning_data",
        "acquiring_observations",
        "analyzing_data",
        "training_models",
        "building_visualizations",
        "searching_papers",
        "summarizing_papers",
        "reasoning_literature",
        "building_graph",
        "waiting_for_input",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "active_draft_id": null,
      "case_key": "exoplanet_host_star",
      "created_at": "2026-07-21T08:00:00Z",
      "description": "Evidence-bound integration for the frozen main case",
      "id": "proj_01JEXAMPLE",
      "name": "Exoplanet host-star integration",
      "revision": 1,
      "session_id": "sess_01JEXAMPLE",
      "thread_summary": {
        "has_thread_entries": false,
        "has_unanswered_clarification": false,
        "latest_thread_actor": null
      },
      "updated_at": "2026-07-21T08:00:00Z"
    }
  ],
  "properties": {
    "active_contract_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Contract Id"
    },
    "active_draft_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Draft Id"
    },
    "case_key": {
      "const": "exoplanet_host_star",
      "title": "Case Key",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "latest_run_failure_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Run Failure Summary"
    },
    "latest_run_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Run Id"
    },
    "latest_run_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "thread_summary": {
      "$ref": "#/$defs/ResearchThreadSummary"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "session_id",
    "name",
    "case_key",
    "thread_summary",
    "created_at",
    "updated_at",
    "revision"
  ],
  "title": "ResearchProject",
  "type": "object"
}
