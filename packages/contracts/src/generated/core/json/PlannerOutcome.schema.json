{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "dataset",
        "field_dictionary",
        "source_collection",
        "analysis_report",
        "visualization",
        "model_evaluation",
        "paper_collection",
        "paper_summary",
        "literature_claims",
        "literature_relations",
        "reasoning_traces",
        "graph",
        "export"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "DataRequirements": {
      "additionalProperties": false,
      "properties": {
        "unit_policy": {
          "$ref": "#/$defs/UnitPolicy",
          "default": "canonical"
        }
      },
      "title": "DataRequirements",
      "type": "object"
    },
    "EvidenceRequirements": {
      "additionalProperties": false,
      "properties": {
        "minimum_coverage": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Coverage",
          "type": "number"
        },
        "require_locator": {
          "default": true,
          "title": "Require Locator",
          "type": "boolean"
        },
        "require_source_snapshot": {
          "default": true,
          "title": "Require Source Snapshot",
          "type": "boolean"
        }
      },
      "title": "EvidenceRequirements",
      "type": "object"
    },
    "JsonValue": {},
    "PaperSearchScope": {
      "additionalProperties": false,
      "properties": {
        "keywords": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "max_candidates": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Candidates",
          "type": "integer"
        },
        "source_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "year_from": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year From"
        },
        "year_to": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year To"
        }
      },
      "title": "PaperSearchScope",
      "type": "object"
    },
    "PlannerClarificationRequired": {
      "additionalProperties": false,
      "properties": {
        "assistant_message": {
          "minLength": 1,
          "title": "Assistant Message",
          "type": "string"
        },
        "outcome": {
          "const": "clarification_required",
          "title": "Outcome",
          "type": "string"
        },
        "public_analysis": {
          "minLength": 1,
          "title": "Public Analysis",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "question_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "public_analysis",
        "assistant_message",
        "question_id",
        "question"
      ],
      "title": "PlannerClarificationRequired",
      "type": "object"
    },
    "PlannerDraftReady": {
      "additionalProperties": false,
      "properties": {
        "assistant_message": {
          "minLength": 1,
          "title": "Assistant Message",
          "type": "string"
        },
        "contract": {
          "$ref": "#/$defs/ResearchContractInput"
        },
        "outcome": {
          "const": "draft_ready",
          "title": "Outcome",
          "type": "string"
        },
        "public_analysis": {
          "minLength": 1,
          "title": "Public Analysis",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "public_analysis",
        "assistant_message",
        "contract"
      ],
      "title": "PlannerDraftReady",
      "type": "object"
    },
    "PlannerPartial": {
      "additionalProperties": false,
      "properties": {
        "assistant_message": {
          "minLength": 1,
          "title": "Assistant Message",
          "type": "string"
        },
        "missing_information": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Missing Information",
          "type": "array"
        },
        "outcome": {
          "const": "partial",
          "title": "Outcome",
          "type": "string"
        },
        "public_analysis": {
          "minLength": 1,
          "title": "Public Analysis",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "public_analysis",
        "assistant_message",
        "missing_information"
      ],
      "title": "PlannerPartial",
      "type": "object"
    },
    "PlannerRefused": {
      "additionalProperties": false,
      "properties": {
        "assistant_message": {
          "minLength": 1,
          "title": "Assistant Message",
          "type": "string"
        },
        "outcome": {
          "const": "refused",
          "title": "Outcome",
          "type": "string"
        },
        "public_analysis": {
          "minLength": 1,
          "title": "Public Analysis",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "public_analysis",
        "assistant_message",
        "reason"
      ],
      "title": "PlannerRefused",
      "type": "object"
    },
    "PlannerUnsupported": {
      "additionalProperties": false,
      "properties": {
        "assistant_message": {
          "minLength": 1,
          "title": "Assistant Message",
          "type": "string"
        },
        "outcome": {
          "const": "unsupported",
          "title": "Outcome",
          "type": "string"
        },
        "public_analysis": {
          "minLength": 1,
          "title": "Public Analysis",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "public_analysis",
        "assistant_message",
        "reason"
      ],
      "title": "PlannerUnsupported",
      "type": "object"
    },
    "QualityConstraints": {
      "additionalProperties": false,
      "properties": {
        "source_completeness_min": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Source Completeness Min",
          "type": "number"
        },
        "unit_consistency_min": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Unit Consistency Min",
          "type": "number"
        }
      },
      "title": "QualityConstraints",
      "type": "object"
    },
    "ResearchContractInput": {
      "additionalProperties": false,
      "description": "Shared scientific payload for an editable draft and immutable contract.",
      "properties": {
        "data_requirements": {
          "$ref": "#/$defs/DataRequirements"
        },
        "evidence_requirements": {
          "$ref": "#/$defs/EvidenceRequirements"
        },
        "output_requirements": {
          "items": {
            "$ref": "#/$defs/ArtifactKind"
          },
          "minItems": 1,
          "title": "Output Requirements",
          "type": "array"
        },
        "paper_search_scope": {
          "$ref": "#/$defs/PaperSearchScope"
        },
        "quality_constraints": {
          "$ref": "#/$defs/QualityConstraints"
        },
        "requested_fields": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Requested Fields",
          "type": "array"
        },
        "research_goal": {
          "maxLength": 500,
          "minLength": 4,
          "title": "Research Goal",
          "type": "string"
        },
        "scientific_tasks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScientificTaskInput"
          },
          "title": "Scientific Tasks",
          "type": "array"
        },
        "source_scope": {
          "$ref": "#/$defs/SourceScope"
        },
        "target_objects": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Objects",
          "type": "array"
        }
      },
      "required": [
        "research_goal",
        "target_objects",
        "data_requirements",
        "requested_fields",
        "source_scope",
        "paper_search_scope",
        "output_requirements",
        "evidence_requirements",
        "quality_constraints"
      ],
      "title": "ResearchContractInput",
      "type": "object"
    },
    "ScientificSkillId": {
      "enum": [
        "catalog_crossmatch",
        "data_profile",
        "statistical_analysis",
        "correlation_analysis",
        "chart_visualization",
        "simbad_lookup",
        "skyview_fits",
        "ephemeris",
        "celestial_events",
        "fits_image_analysis",
        "tabular_machine_learning",
        "time_series_forecast",
        "image_classification",
        "wwt_scene"
      ],
      "title": "ScientificSkillId",
      "type": "string"
    },
    "ScientificTaskInput": {
      "additionalProperties": false,
      "description": "One bounded invocation of a registered scientific skill.",
      "properties": {
        "input_refs": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Parameters",
          "type": "object"
        },
        "skill_id": {
          "$ref": "#/$defs/ScientificSkillId"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "skill_id"
      ],
      "title": "ScientificTaskInput",
      "type": "object"
    },
    "SourceScope": {
      "additionalProperties": false,
      "properties": {
        "allowed_sources": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Sources",
          "type": "array"
        }
      },
      "required": [
        "allowed_sources"
      ],
      "title": "SourceScope",
      "type": "object"
    },
    "UnitPolicy": {
      "enum": [
        "canonical"
      ],
      "title": "UnitPolicy",
      "type": "string"
    }
  },
  "discriminator": {
    "mapping": {
      "clarification_required": "#/$defs/PlannerClarificationRequired",
      "draft_ready": "#/$defs/PlannerDraftReady",
      "partial": "#/$defs/PlannerPartial",
      "refused": "#/$defs/PlannerRefused",
      "unsupported": "#/$defs/PlannerUnsupported"
    },
    "propertyName": "outcome"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/PlannerClarificationRequired"
    },
    {
      "$ref": "#/$defs/PlannerDraftReady"
    },
    {
      "$ref": "#/$defs/PlannerPartial"
    },
    {
      "$ref": "#/$defs/PlannerUnsupported"
    },
    {
      "$ref": "#/$defs/PlannerRefused"
    }
  ]
}
