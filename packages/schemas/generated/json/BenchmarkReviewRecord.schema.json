{
  "$defs": {
    "BenchmarkReviewPurpose": {
      "enum": [
        "pr_technical_review",
        "benchmark_scientific_review"
      ],
      "title": "BenchmarkReviewPurpose",
      "type": "string"
    },
    "BenchmarkReviewScope": {
      "additionalProperties": false,
      "properties": {
        "target_ids": {
          "items": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
                "type": "string"
              },
              {
                "pattern": "^zyyyyynnn/xingwen-astro-ai#[1-9][0-9]*$",
                "type": "string"
              }
            ]
          },
          "minItems": 1,
          "title": "Target Ids",
          "type": "array"
        },
        "target_type": {
          "$ref": "#/$defs/BenchmarkReviewTargetType"
        }
      },
      "required": [
        "target_type",
        "target_ids"
      ],
      "title": "BenchmarkReviewScope",
      "type": "object"
    },
    "BenchmarkReviewTargetType": {
      "enum": [
        "pull_request",
        "benchmark_package",
        "source_policy",
        "seed_paper",
        "paper_summary",
        "evidence",
        "claim",
        "relation",
        "reasoning_trace",
        "graph_edge"
      ],
      "title": "BenchmarkReviewTargetType",
      "type": "string"
    },
    "BenchmarkReviewVerdict": {
      "enum": [
        "pass",
        "blocked"
      ],
      "title": "BenchmarkReviewVerdict",
      "type": "string"
    },
    "BenchmarkReviewerType": {
      "enum": [
        "web_gpt",
        "automation"
      ],
      "title": "BenchmarkReviewerType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blocking_findings": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Blocking Findings",
      "type": "array"
    },
    "evidence_actor_identity": {
      "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Evidence Actor Identity",
      "type": "string"
    },
    "non_blocking_findings": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Non Blocking Findings",
      "type": "array"
    },
    "notes": {
      "minLength": 1,
      "title": "Notes",
      "type": "string"
    },
    "review_evidence_body": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Evidence Body"
    },
    "review_evidence_state": {
      "enum": [
        "COMMENTED",
        "APPROVED",
        "CHANGES_REQUESTED"
      ],
      "title": "Review Evidence State",
      "type": "string"
    },
    "review_evidence_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Review Evidence Url",
      "type": "string"
    },
    "review_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Review Id",
      "type": "string"
    },
    "review_purpose": {
      "$ref": "#/$defs/BenchmarkReviewPurpose"
    },
    "review_sequence": {
      "minimum": 1,
      "title": "Review Sequence",
      "type": "integer"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewed_benchmark_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Reviewed Benchmark Version",
      "type": "string"
    },
    "reviewed_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Reviewed Content Hash",
      "type": "string"
    },
    "reviewed_head_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Reviewed Head Sha",
      "type": "string"
    },
    "reviewer_identity": {
      "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Reviewer Identity",
      "type": "string"
    },
    "reviewer_role": {
      "minLength": 1,
      "title": "Reviewer Role",
      "type": "string"
    },
    "reviewer_type": {
      "$ref": "#/$defs/BenchmarkReviewerType"
    },
    "scope": {
      "items": {
        "$ref": "#/$defs/BenchmarkReviewScope"
      },
      "minItems": 1,
      "title": "Scope",
      "type": "array"
    },
    "supersedes_review_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Review Id"
    },
    "verdict": {
      "$ref": "#/$defs/BenchmarkReviewVerdict"
    }
  },
  "required": [
    "review_id",
    "review_sequence",
    "reviewed_at",
    "reviewer_type",
    "reviewer_identity",
    "reviewer_role",
    "review_purpose",
    "verdict",
    "reviewed_head_sha",
    "reviewed_benchmark_version",
    "reviewed_content_hash",
    "scope",
    "notes",
    "evidence_actor_identity",
    "review_evidence_state",
    "review_evidence_url"
  ],
  "title": "BenchmarkReviewRecord",
  "type": "object"
}
