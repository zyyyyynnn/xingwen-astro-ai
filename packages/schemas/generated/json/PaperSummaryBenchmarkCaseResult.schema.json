{
  "additionalProperties": false,
  "properties": {
    "benchmark_summary_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Benchmark Summary Id",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Case Id",
      "type": "string"
    },
    "core_item_count": {
      "minimum": 0,
      "title": "Core Item Count",
      "type": "integer"
    },
    "input_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "model_response_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Model Response Hash",
      "type": "string"
    },
    "output_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Hash"
    },
    "schema_valid": {
      "title": "Schema Valid",
      "type": "boolean"
    },
    "supported_core_item_count": {
      "minimum": 0,
      "title": "Supported Core Item Count",
      "type": "integer"
    },
    "unsupported_blocked": {
      "title": "Unsupported Blocked",
      "type": "boolean"
    },
    "unsupported_expected": {
      "title": "Unsupported Expected",
      "type": "boolean"
    }
  },
  "required": [
    "case_id",
    "benchmark_summary_id",
    "schema_valid",
    "core_item_count",
    "supported_core_item_count",
    "unsupported_expected",
    "unsupported_blocked",
    "input_hash",
    "model_response_hash"
  ],
  "title": "PaperSummaryBenchmarkCaseResult",
  "type": "object"
}
