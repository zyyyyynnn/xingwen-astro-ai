---
import BrandMark from "../components/BrandMark.astro";

import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /**
   * "default" renders the standalone site header; "hidden" omits it so a
   * page can host its own brand mark inside an editorial frame (homepage).
   * Other pages keep the default behavior.
   */
  masthead?: "default" | "hidden";
  /**
   * "default" renders the site footer; "hidden" omits it so the homepage
   * can present a compact editorial frame without a large footer pushing
   * the visual region above the fold.
   */
  footer?: "default" | "hidden";
}

const {
  title,
  description,
  masthead = "default",
  footer = "default",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      {
        masthead === "default" && (
          <header class="site-header">
            <BrandMark showSubtitle={true} />
          </header>
        )
      }
      <main class="site-main">
        <slot />
      </main>
      {
        footer === "default" && (
          <footer class="site-footer">星文智析 · 天文科研智能工作平台</footer>
        )
      }
    </div>
  </body>
</html>
