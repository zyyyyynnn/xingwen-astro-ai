{
  "$defs": {
    "LiteratureReasoningTraceCandidate": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        },
        "conditions": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "limitations": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "model_response_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Model Response Hash",
          "type": "string"
        },
        "premise_claim_ids": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            }
          ],
          "title": "Premise Claim Ids",
          "type": "array"
        },
        "producer_execution_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Producer Execution Id",
          "type": "string"
        },
        "relation_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Relation Id",
          "type": "string"
        },
        "relation_status": {
          "$ref": "#/$defs/LiteratureRelationStatus"
        },
        "scientific_review_status": {
          "const": "pending_scientific_review",
          "default": "pending_scientific_review",
          "title": "Scientific Review Status",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/LiteratureReasoningTraceStepCandidate"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "trace_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Trace Id",
          "type": "string"
        },
        "trace_protocol_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Trace Protocol Version",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "relation_id",
        "premise_claim_ids",
        "steps",
        "conditions",
        "limitations",
        "conflicts",
        "conclusion",
        "evidence_ids",
        "trace_protocol_version",
        "relation_status",
        "producer_execution_id",
        "input_hash",
        "model_response_hash"
      ],
      "title": "LiteratureReasoningTraceCandidate",
      "type": "object"
    },
    "LiteratureReasoningTraceStepCandidate": {
      "additionalProperties": false,
      "description": "One public, verifiable operation; never a private reasoning token log.",
      "properties": {
        "claim_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "operation": {
          "$ref": "#/$defs/LiteratureTraceOperation"
        },
        "order": {
          "maximum": 32,
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "statement": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "order",
        "operation",
        "statement",
        "claim_ids",
        "evidence_ids"
      ],
      "title": "LiteratureReasoningTraceStepCandidate",
      "type": "object"
    },
    "LiteratureRelationStatus": {
      "enum": [
        "candidate",
        "accepted",
        "rejected"
      ],
      "title": "LiteratureRelationStatus",
      "type": "string"
    },
    "LiteratureTraceOperation": {
      "enum": [
        "identify_premises",
        "compare_objects",
        "compare_metric",
        "compare_unit",
        "check_conditions",
        "check_evidence",
        "classify_relation",
        "record_limitation"
      ],
      "title": "LiteratureTraceOperation",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Reviewable public traces projected from one admitted Relation candidate.",
  "properties": {
    "input_hash": {
      "title": "Input Hash",
      "type": "string"
    },
    "kind": {
      "const": "reasoning_traces",
      "default": "reasoning_traces",
      "title": "Kind",
      "type": "string"
    },
    "output_hash": {
      "title": "Output Hash",
      "type": "string"
    },
    "reasoning_traces": {
      "items": {
        "$ref": "#/$defs/LiteratureReasoningTraceCandidate"
      },
      "title": "Reasoning Traces",
      "type": "array"
    },
    "relation_output_hash": {
      "title": "Relation Output Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "relation_output_hash",
    "reasoning_traces",
    "input_hash",
    "output_hash"
  ],
  "title": "ReasoningTracesArtifactContent",
  "type": "object"
}
