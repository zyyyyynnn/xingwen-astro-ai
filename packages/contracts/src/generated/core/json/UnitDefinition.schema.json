{
  "$defs": {
    "QuantityKind": {
      "description": "Physical dimensions used for static compatibility checks only.",
      "enum": [
        "none",
        "angle",
        "time",
        "length",
        "mass",
        "temperature",
        "logarithmic_abundance"
      ],
      "title": "QuantityKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A canonical or source unit registered by identifier.",
  "properties": {
    "label": {
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "quantity_kind": {
      "$ref": "#/$defs/QuantityKind"
    },
    "symbol": {
      "title": "Symbol",
      "type": "string"
    },
    "unit_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Unit Id",
      "type": "string"
    }
  },
  "required": [
    "unit_id",
    "label",
    "symbol",
    "quantity_kind"
  ],
  "title": "UnitDefinition",
  "type": "object"
}
