{
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Claim Id",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Evidence Id",
      "type": "string"
    },
    "paper_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Paper Id",
      "type": "string"
    },
    "source_snapshot_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Snapshot Content Hash",
      "type": "string"
    },
    "source_snapshot_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Snapshot Id",
      "type": "string"
    },
    "source_snapshot_version": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Source Snapshot Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "supported",
        "unsupported",
        "unverifiable"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary_statement_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Summary Statement Id",
      "type": "string"
    },
    "validation_code": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Validation Code",
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "evidence_id",
    "summary_statement_id",
    "paper_id",
    "source_snapshot_id",
    "source_snapshot_version",
    "source_snapshot_content_hash",
    "status",
    "validation_code"
  ],
  "title": "LiteratureClaimEvidenceReference",
  "type": "object"
}
