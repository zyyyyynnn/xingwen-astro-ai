[
    {
        "id": "1",
        "工具名":"wwt.local",
        "作用": "在地球观测视图下（不是太阳系视图，在太阳系视图下该工具不可用），设置在地球的上的观测位置（默认在观测目标具有太阳，月球和八大行星时会使用）",
        "必要参数输入": "经纬度",
        "可用工具":
        [
            {
                "sub_id":"1",
                "工具名":"wwt.local_horizon_mode",
                "导入方式": "无需导入，直接调用",
                "作用":"设置是否启用本地模式",
                "输入参数方式":"赋值输入，如 wwt.local_horizon_mode=True",
                "参数":
                {
                    "":"True 为启动本地模式，False 为关闭本地模式"
                }
            },
            {
                "sub_id":"2",
                "工具名":"wwt.location_latitude",
                "导入方式": "无需导入，直接调用",
                "作用":"在WWT为本地地平模式下，设置观测地点的地理纬度",
                "输入参数方式":"赋值输入，如 wwt.location_latitude = -33.33*u.deg ",
                "参数":
                {
                    "":"浮点型*天文的角度单位,如输入值为浮点数，然后使用‘*’符号相乘单位，如-33.33*u.deg，表示南纬33.33度"
                }
            },
            {
                "sub_id":"3",
                "工具名":"wwt.location_longitude",
                "导入方式": "无需导入，直接调用",
                "作用":"在WWT为本地地平模式下，设置观测地点的地理经度",
                "输入参数方式":"赋值输入，如 wwt.location_longitude = -33.33*u.deg",
                "参数":
                {
                    "":"浮点型 * 天文的角度单位,如输入值为浮点数，然后使用‘*’符号相乘单位，如-33.33*u.deg，表示西经33.33度"
                }
            }
        ]
    },
    {
        "id": "2",
        "工具名":"wwt.center_on_coordinates",
        "作用": "在地球观测视图下（不是太阳系视图，在太阳系视图下该工具不可用），定位观测目标（包括太阳、月亮、八大行星，恒星，星系等等星体）",
        "必要参数输入": "目标星体的赤经赤纬坐标",
        "可用工具":
        [
            {
                "sub_id":"1",
                "工具名":"wwt.center_on_coordinates",
                "导入方式": "无需导入，直接调用",
                "作用":"定位太阳、月亮、八大行星，恒星，星系",
                "输入参数方式":"括号输入",
                "参数":
                {
                    "coord":"星体的赤经赤纬坐标，格式为astropy.coordinates的SkyCoord，在SkyCoord中填入天体的赤经赤纬。单位全为u.deg。赤经的单位为u.deg（而不是u.hourangle），赤纬的单位也为u.deg",
                    "fov":"默认为5*u.deg。格式为输入浮点型 * 天文的角度单位",
                    "instant": "默认为False"

                }
            }
        ]
    },
    {
        "id": "3",
        "工具名":"wwt.time",
        "作用": "在WWT中设置观测的时间",
        "必要参数输入": "时间",
        "可用工具":
        [
            {
                "sub_id":"1",
                "工具名":"wwt.pause_time",
                "导入方式": "无需导入，直接调用",
                "作用":"暂停 WWT 中时间的流逝",
                "输入参数方式":"括号输入",
                "参数": "无"
            },
            {
                "sub_id":"2",
                "工具名":"wwt.get_current_time",
                "导入方式": "无需导入，直接调用",
                "作用":"获取 WWT 当前时间",
                "输入参数方式":"括号输入",
                "参数": "无"
            },
            {
                "sub_id":"3",
                "工具名":"wwt.set_current_time",
                "导入方式": "无需导入，直接调用",
                "作用":"在启动 WWT 的时间播放的属性的前提下，设置当前时间",
                "输入参数方式":"括号输入",
                "参数":
                {
                    "dt":"传入一个观测的开始时间，如格式为dt=Time('2017-03-09')"
                }
            },
            {
                "sub_id":"4",
                "工具名":"wwt.play_time",
                "导入方式": "无需导入，直接调用",
                "作用":"在WWT中设置观测的时，第一步必须是启动 WWT 的时间播放，并设置播放速度",
                "输入参数方式":"括号输入",
                "参数":
                {
                    "rate":"默认值为100，输入非零的整数，表示时间流逝的速率系数，正数表示正向播放，负数表示反向播放"
                }
            }       
        ]

    },
    {
        "id": "4",
        "工具名":"wwt.add",
        "作用": "在地球观测视图下（不是太阳系视图，在太阳系视图下该工具不可用），在WWT显示批注，添加连线、圆圈",
        "必要参数输入": "赤经赤纬或者多个赤经赤纬坐标",
        "可用工具":
        [
            {
                "sub_id":"1",
                "工具名":"wwt.add_line",
                "导入方式": "无需导入，直接调用",
                "作用":"在wwt中添加连线",
                "输入参数方式":"括号输入",
                "参数":
                {
                    "":"第一个参数填入必须为astropy的coordinates的concatenate函数，其中concatenate接受的输入为astropy的多个SkyCoord对象传入多个需要连接的天文坐标点序列。如：concatenate(((这里是SkyCoord对象),..,(这里是SkyCoord对象)))。值得注意的是，WWT绘制连线时，不会自动定位到绘制连线的位置上，WWT绘制连线时无需提供星体间连线的顺序",
                    "width":"线的宽度，默认为3*u.pixel"
                },
                "可用方法":
                [
                    {
                        "方法名": "color",
                        "输入参数方式":"默认值为line.color='red'，赋值输入，在你给color这个方法传递参数时，必须按照方式：父类先传递给一个变量line=wwt.add_line 然后line.color='red'",
                        "作用":"填入颜色，格式可为html colors,如'red'，格式还可为matplotlib colors,如'k',或者hex strings,如'#FF0000'"
                    },
                    {
                        "方法名":"add_point",
                        "作用":"在wwt中画好的线上添加点",
                        "输入参数方式":"括号输入",
                        "参数":
                        {
                            "":"传入赤经赤纬坐标，格式为astropy的SkyCoord对象，表示圆心坐标"
                        }
                    }
                ]
            },
            {
                "sub_id":"2",
                "工具名":"wwt.add_circle",
                "导入方式": "无需导入，直接调用",
                "作用":"在wwt中添加圆圈",
                "输入参数方式":"括号输入",
                "参数":
                {
                    "":"传入赤经赤纬坐标，格式为astropy的SkyCoord对象，表示圆心坐标",
                    "radius":"默认值为0.05*u.deg，传入圆圈的大小，单位为弧秒，即u.deg",
                    "line_color": "默认值为'red',表示圆圈边框的颜色",
                    "fill":"默认值为False，是否填充，True为填充，False为不填充",
                    "fill_color":"默认值为'red'，填充颜色，格式可为html colors,如'red'，格式还可为matplotlib colors,如'k',或者hex strings,如'#FF0000'"
                }
            }
        ]

    },
    {
        "id": "5",
        "工具名":"add_image_fits",
        "必要参数输入": "单张FITS图像的路径地址",
        "作用": "添加经过图像处理过后的的FITS图像数据到WWT中",
        "可用工具":
        [
        {
            "sub_id":"1",
            "工具名":"wwt.layers.add_image_layer",
            "导入方式": "无需导入，直接调用",
            "作用":"在WWT中添加FITS的静态图像数据，即渲染地址中FITS单张图像到WWT中",
            "输入参数方式":"括号输入",
            "参数":
            {
                "image":"单张FITS图像的路径地址"
            }
        }
        ]
    },
    {
        "id": "6",
        "工具名":"wwt.solar_system",
        "必要参数输入": "天体目标（英文名）",
        "作用": "太阳系视图下（不是在地球上观测，在地球上观测视图下该工具不可用），在WWT中模拟太阳系八大行星运行轨道体系（上帝视角）",
        "可用工具":
        [

            {
                "sub_id":"2",
                "工具名":"wwt.solar_system.track_object",
                "作用":"将视图锁定并聚焦到某个特定天体（如太阳，火星，地球等等）上",
                "参数": "填入特定的太阳系的天体英文名，包括：['venus','moon','earth','mars','jupiter','saturn','uranus','neptune','pluto']等",
                "输入参数方式":"括号输入"
            },
            {
                "sub_id":"3",
                "工具名":"wwt.solar_system.cosmos",
                "作用":"是否显示来自SDSS（斯隆数字巡天）天文调查的数据   ",
                "参数": "布尔值",
                "输入参数方式":"赋值输入"
            },
            {
                "sub_id":"4",
                "工具名":"wwt.solar_system.lighting",
                "作用":"布尔值，在太阳系模式下，是否显示太阳光照对行星等天体的照明效果",
                "输入参数方式":"赋值输入"
            },
            {
                "sub_id":"5",
                "工具名":"wwt.solar_system.milky_way",
                "作用":"布尔值，在太阳系模式下，是否在背景中显示银河系的星云/核心区域",
                "输入参数方式":"赋值输入"
            },
            {
                "sub_id":"6",
                "工具名":"wwt.solar_system.minor_orbits",
                "作用":"布尔值，在太阳系模式下，是否显示小行星等小天体的运行轨道",
                "输入参数方式":"赋值输入"
            },
            {
                "sub_id":"7",
                "工具名":"wwt.solar_system.objects",
                "作用":"布尔值，在太阳系模式下，是否显示太阳系中的天体（如行星、卫星等实体）",
                "输入参数方式":"赋值输入"
            },
            {
                "sub_id":"8",
                "工具名":"wwt.solar_system.orbits",
                "作用":"布尔值，在太阳系模式下，是否显示天体的运行轨道路径",
                "输入参数方式":"赋值输入"
            },
            {
                "sub_id":"9",
                "工具名":"wwt.solar_system.scale",
                "导入方式": "无需导入，直接调用",
                "作用":"默认设置为99，设定太阳系模式下天体大小的缩放比例：1 = 实际大小;100 = 最大可放大尺寸（数值越大，显示越夸张）",
                "输入参数方式":"赋值输入，默认输入为wwt.solar_system.scale=99"
            },
            {
                "sub_id":"10",
                "工具名":"wwt.solar_system.stars",
                "作用":"布尔值，在太阳系模式下，是否显示背景的恒星",
                "输入参数方式":"赋值输入"
            }
        ]
    }
]