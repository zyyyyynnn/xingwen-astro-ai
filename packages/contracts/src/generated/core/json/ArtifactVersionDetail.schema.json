          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "source_key": {
          "minLength": 1,
          "title": "Source Key",
          "type": "string"
        },
        "target_key": {
          "minLength": 1,
          "title": "Target Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "source_key",
        "target_key"
      ],
      "title": "PublicPresentationGraphEdge",
      "type": "object"
    },
    "PublicPresentationGraphNode": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "label"
      ],
      "title": "PublicPresentationGraphNode",
      "type": "object"
    },
    "PublicPresentationParagraph": {
      "additionalProperties": false,
      "description": "One narrative statement with its directly supporting Evidence.",
      "properties": {
        "evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "status": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "PublicPresentationParagraph",
      "type": "object"
    },
    "PublicPresentationSection": {
      "additionalProperties": false,
      "description": "A bounded narrative section in a shared result presentation.",
      "properties": {
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/PublicPresentationParagraph"
          },
          "minItems": 1,
          "title": "Paragraphs",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "paragraphs"
      ],
      "title": "PublicPresentationSection",
      "type": "object"
    },
    "PublicPresentationTable": {
      "additionalProperties": false,
      "description": "Bounded tabular result projected from a typed Artifact authority.",
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/PublicPresentationTableColumn"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicPresentationTableRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "total_column_count": {
          "minimum": 1,
          "title": "Total Column Count",
          "type": "integer"
        },
        "total_row_count": {
          "minimum": 0,
          "title": "Total Row Count",
          "type": "integer"
        }
      },
      "required": [
        "title",
        "columns",
        "total_row_count",
        "total_column_count"
      ],
      "title": "PublicPresentationTable",
      "type": "object"
    },
    "PublicPresentationTableCell": {
      "additionalProperties": false,
      "description": "One display-safe canonical value and its directly supporting Evidence.",
      "properties": {
        "column_key": {
          "minLength": 1,
          "title": "Column Key",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
