{
  "$defs": {
    "GraphProgressiveChunk": {
      "additionalProperties": false,
      "properties": {
        "chunk_index": {
          "minimum": 0,
          "title": "Chunk Index",
          "type": "integer"
        },
        "item_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Item Ids",
          "type": "array"
        }
      },
      "required": [
        "chunk_index",
        "item_ids"
      ],
      "title": "GraphProgressiveChunk",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chunk_count": {
      "maximum": 256,
      "minimum": 1,
      "title": "Chunk Count",
      "type": "integer"
    },
    "chunks": {
      "items": {
        "$ref": "#/$defs/GraphProgressiveChunk"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Chunks",
      "type": "array"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "progressive_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Progressive Id",
      "type": "string"
    }
  },
  "required": [
    "progressive_id",
    "chunk_count",
    "chunks",
    "complete"
  ],
  "title": "GraphProgressiveInput",
  "type": "object"
}
