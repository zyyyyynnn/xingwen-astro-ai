{
  "$defs": {
    "PaperSummaryEvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "paper_text",
            "paper_metadata"
          ],
          "title": "Kind",
          "type": "string"
        },
        "metadata_field": {
          "anyOf": [
            {
              "enum": [
                "source_record_id",
                "title",
                "authors",
                "year",
                "doi",
                "arxiv_id",
                "url"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Field"
        },
        "paragraph": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "text_range": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Range"
        }
      },
      "required": [
        "kind",
        "source_url"
      ],
      "title": "PaperSummaryEvidenceLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Caller-supplied, bounded Evidence input; source excerpt is never published.",
  "properties": {
    "accessible_excerpt": {
      "anyOf": [
        {
          "maxLength": 16000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accessible Excerpt"
    },
    "candidate_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Candidate Id",
      "type": "string"
    },
    "claimed_source_version": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claimed Source Version"
    },
    "evidence_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Evidence Id",
      "type": "string"
    },
    "locator": {
      "$ref": "#/$defs/PaperSummaryEvidenceLocator"
    },
    "paper_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Paper Id",
      "type": "string"
    },
    "quote_or_value": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Quote Or Value",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_record_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Source Record Id",
      "type": "string"
    },
    "source_snapshot_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "paper_id",
    "candidate_id",
    "source_id",
    "source_record_id",
    "source_snapshot_id",
    "locator",
    "quote_or_value"
  ],
  "title": "PaperSummaryEvidenceCandidate",
  "type": "object"
}
