{
  "$defs": {
    "QualityMetricId": {
      "enum": [
        "field_completeness",
        "field_missingness",
        "field_unresolved_rate",
        "field_provenance_coverage",
        "field_evidence_coverage",
        "field_unit_consistency",
        "field_same_source_conflict_rate",
        "field_cross_source_conflict_rate",
        "row_completeness",
        "row_missingness",
        "row_unresolved_rate",
        "row_provenance_coverage",
        "row_evidence_coverage",
        "row_unit_consistency",
        "row_conflict_rate",
        "row_low_confidence_flag",
        "row_review_required_flag",
        "row_inconclusive_flag",
        "dataset_completeness",
        "dataset_missingness",
        "dataset_unresolved_rate",
        "dataset_provenance_coverage",
        "dataset_evidence_coverage",
        "dataset_unit_consistency",
        "dataset_cross_source_conflict_rate",
        "dataset_same_source_conflict_rate",
        "object_match_coverage",
        "low_confidence_edge_rate",
        "review_required_record_rate",
        "inconclusive_record_rate",
        "source_scope_completeness",
        "validation_integrity"
      ],
      "title": "QualityMetricId",
      "type": "string"
    },
    "QualityMetricScope": {
      "enum": [
        "field",
        "row",
        "dataset"
      ],
      "title": "QualityMetricScope",
      "type": "string"
    },
    "QualityMetricStatus": {
      "enum": [
        "determinate",
        "insufficient",
        "not_applicable"
      ],
      "title": "QualityMetricStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "denominator": {
      "minimum": 0,
      "title": "Denominator",
      "type": "integer"
    },
    "formula_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Formula Id",
      "type": "string"
    },
    "formula_scope": {
      "$ref": "#/$defs/QualityMetricScope"
    },
    "formula_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Formula Version",
      "type": "string"
    },
    "input_locator": {
      "minLength": 1,
      "title": "Input Locator",
      "type": "string"
    },
    "metric_id": {
      "$ref": "#/$defs/QualityMetricId"
    },
    "numerator": {
      "minimum": 0,
      "title": "Numerator",
      "type": "integer"
    },
    "precision_digits": {
      "exclusiveMinimum": 0,
      "maximum": 64,
      "title": "Precision Digits",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/QualityMetricScope"
    },
    "status": {
      "$ref": "#/$defs/QualityMetricStatus"
    },
    "target_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Target Id",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    }
  },
  "required": [
    "metric_id",
    "scope",
    "target_id",
    "status",
    "numerator",
    "denominator",
    "formula_id",
    "formula_version",
    "formula_scope",
    "precision_digits",
    "input_locator"
  ],
  "title": "QualityMetricResult",
  "type": "object"
}
