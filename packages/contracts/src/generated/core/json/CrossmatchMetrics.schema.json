{
  "$defs": {
    "ConfidenceDistribution": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "minimum": 0,
          "title": "High",
          "type": "integer"
        },
        "low": {
          "minimum": 0,
          "title": "Low",
          "type": "integer"
        },
        "medium": {
          "minimum": 0,
          "title": "Medium",
          "type": "integer"
        },
        "not_applicable": {
          "minimum": 0,
          "title": "Not Applicable",
          "type": "integer"
        }
      },
      "required": [
        "high",
        "medium",
        "low",
        "not_applicable"
      ],
      "title": "ConfidenceDistribution",
      "type": "object"
    },
    "MethodDistribution": {
      "additionalProperties": false,
      "properties": {
        "compound": {
          "minimum": 0,
          "title": "Compound",
          "type": "integer"
        },
        "coordinate": {
          "minimum": 0,
          "title": "Coordinate",
          "type": "integer"
        },
        "curated_entity_alias": {
          "minimum": 0,
          "title": "Curated Entity Alias",
          "type": "integer"
        },
        "exact_identifier": {
          "minimum": 0,
          "title": "Exact Identifier",
          "type": "integer"
        }
      },
      "required": [
        "exact_identifier",
        "curated_entity_alias",
        "coordinate",
        "compound"
      ],
      "title": "MethodDistribution",
      "type": "object"
    },
    "RatioMetric": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "RatioMetric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ambiguous_group_count": {
      "minimum": 0,
      "title": "Ambiguous Group Count",
      "type": "integer"
    },
    "candidate_pair_count": {
      "description": "Materialized CandidateEdge count after matching; this is not the eligible candidate-pair count used by the capacity preflight.",
      "minimum": 0,
      "title": "Candidate Pair Count",
      "type": "integer"
    },
    "confidence_distribution": {
      "$ref": "#/$defs/ConfidenceDistribution"
    },
    "conflict_group_count": {
      "minimum": 0,
      "title": "Conflict Group Count",
      "type": "integer"
    },
    "conflict_rate": {
      "$ref": "#/$defs/RatioMetric"
    },
    "error_example_references": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Error Example References",
      "type": "array"
    },
    "evidence_coverage": {
      "$ref": "#/$defs/RatioMetric"
    },
    "inconclusive_record_count": {
      "minimum": 0,
      "title": "Inconclusive Record Count",
      "type": "integer"
    },
    "left_candidate_count": {
      "minimum": 0,
      "title": "Left Candidate Count",
      "type": "integer"
    },
    "left_record_count": {
      "minimum": 0,
      "title": "Left Record Count",
      "type": "integer"
    },
    "low_confidence_count": {
      "minimum": 0,
      "title": "Low Confidence Count",
      "type": "integer"
    },
    "manual_adjudication_count": {
      "minimum": 0,
      "title": "Manual Adjudication Count",
      "type": "integer"
    },
    "manual_review_required_count": {
      "minimum": 0,
      "title": "Manual Review Required Count",
      "type": "integer"
    },
    "many_to_many_count": {
      "minimum": 0,
      "title": "Many To Many Count",
      "type": "integer"
    },
    "many_to_one_count": {
      "minimum": 0,
      "title": "Many To One Count",
      "type": "integer"
    },
    "match_coverage": {
      "$ref": "#/$defs/RatioMetric"
    },
    "matched_group_count": {
      "minimum": 0,
      "title": "Matched Group Count",
      "type": "integer"
    },
    "method_distribution": {
      "$ref": "#/$defs/MethodDistribution"
    },
    "one_to_many_count": {
      "minimum": 0,
      "title": "One To Many Count",
      "type": "integer"
    },
    "one_to_one_count": {
      "minimum": 0,
      "title": "One To One Count",
      "type": "integer"
    },
    "paired_group_count": {
      "minimum": 0,
      "title": "Paired Group Count",
      "type": "integer"
    },
    "right_candidate_count": {
      "minimum": 0,
      "title": "Right Candidate Count",
      "type": "integer"
    },
    "right_record_count": {
      "minimum": 0,
      "title": "Right Record Count",
      "type": "integer"
    },
    "unmatched_left_record_count": {
      "minimum": 0,
      "title": "Unmatched Left Record Count",
      "type": "integer"
    },
    "unmatched_rate": {
      "$ref": "#/$defs/RatioMetric"
    },
    "unmatched_record_count": {
      "minimum": 0,
      "title": "Unmatched Record Count",
      "type": "integer"
    },
    "unmatched_right_record_count": {
      "minimum": 0,
      "title": "Unmatched Right Record Count",
      "type": "integer"
    }
  },
  "required": [
    "left_record_count",
    "right_record_count",
    "left_candidate_count",
    "right_candidate_count",
    "candidate_pair_count",
    "paired_group_count",
    "matched_group_count",
    "ambiguous_group_count",
    "conflict_group_count",
    "unmatched_record_count",
    "unmatched_left_record_count",
    "unmatched_right_record_count",
    "inconclusive_record_count",
    "manual_review_required_count",
    "low_confidence_count",
    "manual_adjudication_count",
    "one_to_one_count",
    "one_to_many_count",
    "many_to_one_count",
    "many_to_many_count",
    "confidence_distribution",
    "method_distribution",
    "error_example_references",
    "match_coverage",
    "conflict_rate",
    "unmatched_rate",
    "evidence_coverage"
  ],
  "title": "CrossmatchMetrics",
  "type": "object"
}
