{
  "additionalProperties": false,
  "description": "Immutable source provenance consumed by scientific pipelines.\n\nThis is a pipeline/runtime record, not an HTTP read projection. It preserves\nthe exact source, query and content identity required for reproducibility\nwhile rejecting credential-bearing request metadata before publication.",
  "properties": {
    "cache_version": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cache Version"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "license_note": {
      "minLength": 1,
      "title": "License Note",
      "type": "string"
    },
    "query": {
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "query_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Query Hash",
      "type": "string"
    },
    "request_metadata": {
      "additionalProperties": true,
      "title": "Request Metadata",
      "type": "object"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_type": {
      "minLength": 1,
      "title": "Source Type",
      "type": "string"
    },
    "source_version_or_etag": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Version Or Etag"
    }
  },
  "required": [
    "snapshot_id",
    "source_id",
    "source_type",
    "retrieved_at",
    "query",
    "query_hash",
    "content_hash",
    "license_note"
  ],
  "title": "SourceSnapshotRecord",
  "type": "object"
}
