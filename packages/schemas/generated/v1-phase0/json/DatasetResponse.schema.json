{
  "$defs": {
    "CaseKey": {
      "enum": [
        "exoplanet_host_star"
      ],
      "title": "CaseKey",
      "type": "string"
    },
    "ColumnInfo": {
      "properties": {
        "data_type": {
          "title": "Data Type",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "mapping_rule": {
          "title": "Mapping Rule",
          "type": "string"
        },
        "missing_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Missing Rate",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "unit",
        "description",
        "data_type",
        "required",
        "source_ids",
        "missing_rate",
        "mapping_rule"
      ],
      "title": "ColumnInfo",
      "type": "object"
    },
    "QualityScore": {
      "properties": {
        "field_coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Field Coverage",
          "type": "number"
        },
        "graph_evidence_completeness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Graph Evidence Completeness",
          "type": "number"
        },
        "literature_relation_evidence_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Literature Relation Evidence Rate",
          "type": "number"
        },
        "missing_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Missing Rate",
          "type": "number"
        },
        "paper_acquisition_reproducibility": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Paper Acquisition Reproducibility",
          "type": "number"
        },
        "paper_summary_completeness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Paper Summary Completeness",
          "type": "number"
        },
        "reproducibility": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Reproducibility",
          "type": "number"
        },
        "source_completeness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Source Completeness",
          "type": "number"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "unit_consistency": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Unit Consistency",
          "type": "number"
        }
      },
      "required": [
        "task_id",
        "field_coverage",
        "missing_rate",
        "source_completeness",
        "unit_consistency",
        "paper_acquisition_reproducibility",
        "paper_summary_completeness",
        "literature_relation_evidence_rate",
        "graph_evidence_completeness",
        "reproducibility"
      ],
      "title": "QualityScore",
      "type": "object"
    }
  },
  "properties": {
    "case_key": {
      "$ref": "#/$defs/CaseKey"
    },
    "columns": {
      "items": {
        "$ref": "#/$defs/ColumnInfo"
      },
      "title": "Columns",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "field_count": {
      "minimum": 0,
      "title": "Field Count",
      "type": "integer"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "quality_score": {
      "anyOf": [
        {
          "$ref": "#/$defs/QualityScore"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "row_count": {
      "minimum": 0,
      "title": "Row Count",
      "type": "integer"
    },
    "rows": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Rows",
      "type": "array"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "task_id",
    "name",
    "case_key",
    "row_count",
    "field_count",
    "created_at",
    "columns",
    "rows"
  ],
  "title": "DatasetResponse",
  "type": "object"
}
