{
  "$defs": {
    "CrossmatchSide": {
      "enum": [
        "left",
        "right"
      ],
      "title": "CrossmatchSide",
      "type": "string"
    },
    "LimitStatus": {
      "enum": [
        "measured",
        "lower_limit",
        "upper_limit",
        "not_applicable"
      ],
      "title": "LimitStatus",
      "type": "string"
    },
    "LimitValue": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceCellLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_flag": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Flag"
        },
        "status": {
          "$ref": "#/$defs/LimitStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "LimitValue",
      "type": "object"
    },
    "SelectionStatus": {
      "enum": [
        "selected",
        "unselected",
        "conflict"
      ],
      "title": "SelectionStatus",
      "type": "string"
    },
    "SourceCellLocator": {
      "additionalProperties": false,
      "properties": {
        "query_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Query Hash",
          "type": "string"
        },
        "raw_field": {
          "minLength": 1,
          "title": "Raw Field",
          "type": "string"
        },
        "raw_record_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Raw Record Content Hash",
          "type": "string"
        },
        "row_key": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "minLength": 1,
                "type": "string"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Row Key",
          "type": "array"
        },
        "side": {
          "$ref": "#/$defs/CrossmatchSide"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_snapshot_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Snapshot Content Hash",
          "type": "string"
        },
        "source_snapshot_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "side",
        "source_snapshot_id",
        "source_snapshot_content_hash",
        "source_id",
        "query_hash",
        "row_key",
        "raw_record_content_hash",
        "raw_field"
      ],
      "title": "SourceCellLocator",
      "type": "object"
    },
    "UncertaintyStatus": {
      "enum": [
        "complete",
        "partial",
        "missing",
        "not_applicable"
      ],
      "title": "UncertaintyStatus",
      "type": "string"
    },
    "UncertaintyValue": {
      "additionalProperties": false,
      "properties": {
        "canonical_negative": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Negative"
        },
        "canonical_positive": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Positive"
        },
        "negative_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceCellLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "positive_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceCellLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_negative": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Negative"
        },
        "source_positive": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Positive"
        },
        "status": {
          "$ref": "#/$defs/UncertaintyStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "UncertaintyValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "canonical_field_id": {
      "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
      "title": "Canonical Field Id",
      "type": "string"
    },
    "canonical_unit": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Canonical Unit",
      "type": "string"
    },
    "canonical_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Value"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "conversion_catalog_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Conversion Catalog Content Hash",
      "type": "string"
    },
    "conversion_catalog_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Conversion Catalog Id",
      "type": "string"
    },
    "conversion_catalog_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Conversion Catalog Version",
      "type": "string"
    },
    "conversion_rule_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Conversion Rule Id",
      "type": "string"
    },
    "conversion_rule_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Conversion Rule Version",
      "type": "string"
    },
    "crossmatch_evidence_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Crossmatch Evidence Ids",
      "type": "array"
    },
    "crossmatch_logical_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Crossmatch Logical Key",
      "type": "string"
    },
    "crossmatch_result_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Crossmatch Result Content Hash",
      "type": "string"
    },
    "crossmatch_result_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Crossmatch Result Id",
      "type": "string"
    },
    "dataset_row_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Dataset Row Id",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Evidence Id",
      "type": "string"
    },
    "limit": {
      "$ref": "#/$defs/LimitValue"
    },
    "limit_locator": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceCellLocator"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "locator": {
      "$ref": "#/$defs/SourceCellLocator"
    },
    "provenance_field": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provenance Field"
    },
    "provenance_locator": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceCellLocator"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provenance Value"
    },
    "raw_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Value"
    },
    "reference_field": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Field"
    },
    "reference_locator": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceCellLocator"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reference_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Value"
    },
    "selection_reason": {
      "minLength": 1,
      "title": "Selection Reason",
      "type": "string"
    },
    "selection_status": {
      "$ref": "#/$defs/SelectionStatus"
    },
    "source_unit": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Unit",
      "type": "string"
    },
    "source_value_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Value Id",
      "type": "string"
    },
    "target_candidate_kind": {
      "const": "dataset",
      "default": "dataset",
      "title": "Target Candidate Kind",
      "type": "string"
    },
    "transformation_rule_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Transformation Rule Version",
      "type": "string"
    },
    "uncertainty": {
      "$ref": "#/$defs/UncertaintyValue"
    },
    "uncertainty_locators": {
      "items": {
        "$ref": "#/$defs/SourceCellLocator"
      },
      "title": "Uncertainty Locators",
      "type": "array"
    }
  },
  "required": [
    "evidence_id",
    "dataset_row_id",
    "canonical_field_id",
    "source_value_id",
    "locator",
    "source_unit",
    "canonical_unit",
    "conversion_rule_id",
    "conversion_rule_version",
    "conversion_catalog_id",
    "conversion_catalog_version",
    "conversion_catalog_content_hash",
    "transformation_rule_version",
    "uncertainty",
    "limit",
    "uncertainty_locators",
    "crossmatch_result_id",
    "crossmatch_result_content_hash",
    "crossmatch_logical_key",
    "crossmatch_evidence_ids",
    "selection_status",
    "selection_reason",
    "content_hash"
  ],
  "title": "TransformationEvidence",
  "type": "object"
}
