{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "dataset",
        "field_dictionary",
        "source_collection",
        "analysis_report",
        "visualization",
        "spectrum",
        "light_curve",
        "model_evaluation",
        "model_artifact",
        "paper_collection",
        "paper_summary",
        "literature_claims",
        "literature_relations",
        "graph",
        "export"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactVersionSummary": {
      "additionalProperties": false,
      "description": "Bounded immutable-version reference used by Artifact detail reads.",
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_mode": {
          "$ref": "#/$defs/SourceMode"
        },
        "supersedes_version_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Version Id"
        },
        "version_number": {
          "minimum": 1,
          "title": "Version Number",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "artifact_id",
        "version_number",
        "schema_version",
        "content_hash",
        "source_mode",
        "created_at"
      ],
      "title": "ArtifactVersionSummary",
      "type": "object"
    },
    "SourceMode": {
      "description": "Actual origin of an ArtifactVersion-compatible pipeline payload.",
      "enum": [
        "fixture",
        "recorded",
        "live",
        "cached"
      ],
      "title": "SourceMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Artifact identity plus stable, bounded version summaries.",
  "examples": [
    {
      "created_at": "2026-07-21T08:00:00Z",
      "id": "art_01JEXAMPLE",
      "kind": "dataset",
      "latest_version_id": "artv_01JEXAMPLE",
      "logical_key": "dataset.primary",
      "project_id": "proj_01JEXAMPLE",
      "title": "Exoplanet host-star dataset"
    }
  ],
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ArtifactKind"
    },
    "latest_version_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest Version Id"
    },
    "logical_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Logical Key",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "versions": {
      "items": {
        "$ref": "#/$defs/ArtifactVersionSummary"
      },
      "title": "Versions",
      "type": "array"
    }
  },
  "required": [
    "id",
    "project_id",
    "kind",
    "title",
    "logical_key",
    "created_at",
    "versions"
  ],
  "title": "ResearchArtifactDetail",
  "type": "object"
}
