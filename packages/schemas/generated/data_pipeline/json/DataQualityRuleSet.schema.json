{
  "$defs": {
    "QualityAggregateScorePolicy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "const": false,
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "score": {
          "default": null,
          "title": "Score",
          "type": "null"
        },
        "weights": {
          "default": [],
          "maxItems": 0,
          "minItems": 0,
          "title": "Weights",
          "type": "array"
        }
      },
      "title": "QualityAggregateScorePolicy",
      "type": "object"
    },
    "QualityCapacityPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_cells": {
          "exclusiveMinimum": 0,
          "maximum": 10000000,
          "title": "Max Cells",
          "type": "integer"
        },
        "max_conflict_references": {
          "exclusiveMinimum": 0,
          "maximum": 10000000,
          "title": "Max Conflict References",
          "type": "integer"
        },
        "max_crossmatch_edges": {
          "exclusiveMinimum": 0,
          "maximum": 10000000,
          "title": "Max Crossmatch Edges",
          "type": "integer"
        },
        "max_diagnostic_references": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Max Diagnostic References",
          "type": "integer"
        },
        "max_evidence": {
          "exclusiveMinimum": 0,
          "maximum": 10000000,
          "title": "Max Evidence",
          "type": "integer"
        },
        "max_fields": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Max Fields",
          "type": "integer"
        },
        "max_metric_records": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Max Metric Records",
          "type": "integer"
        },
        "max_rows": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Max Rows",
          "type": "integer"
        },
        "max_source_values": {
          "exclusiveMinimum": 0,
          "maximum": 10000000,
          "title": "Max Source Values",
          "type": "integer"
        }
      },
      "required": [
        "max_rows",
        "max_fields",
        "max_cells",
        "max_source_values",
        "max_evidence",
        "max_conflict_references",
        "max_crossmatch_edges",
        "max_metric_records",
        "max_diagnostic_references"
      ],
      "title": "QualityCapacityPolicy",
      "type": "object"
    },
    "QualityFormulaDefinition": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "enum": [
            "projected_field_ids_only",
            "dataset_scope",
            "row_scope"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "denominator_definition": {
          "minLength": 1,
          "title": "Denominator Definition",
          "type": "string"
        },
        "denominator_observation": {
          "$ref": "#/$defs/QualityObservationId"
        },
        "empty_denominator_policy": {
          "enum": [
            "not_applicable",
            "insufficient"
          ],
          "title": "Empty Denominator Policy",
          "type": "string"
        },
        "formula_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Formula Id",
          "type": "string"
        },
        "formula_kind": {
          "$ref": "#/$defs/QualityFormulaKind"
        },
        "incomplete_source_policy": {
          "enum": [
            "insufficient",
            "not_applicable"
          ],
          "title": "Incomplete Source Policy",
          "type": "string"
        },
        "manifest_input": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Input"
        },
        "metric_id": {
          "$ref": "#/$defs/QualityMetricId"
        },
        "numerator_definition": {
          "minLength": 1,
          "title": "Numerator Definition",
          "type": "string"
        },
        "numerator_observation": {
          "$ref": "#/$defs/QualityObservationId"
        },
        "result_field": {
          "minLength": 1,
          "title": "Result Field",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/QualityMetricScope"
        },
        "version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "formula_id",
        "metric_id",
        "scope",
        "version",
        "result_field",
        "formula_kind",
        "numerator_observation",
        "denominator_observation",
        "numerator_definition",
        "denominator_definition",
        "applicability",
        "incomplete_source_policy",
        "empty_denominator_policy"
      ],
      "title": "QualityFormulaDefinition",
      "type": "object"
    },
    "QualityFormulaKind": {
      "enum": [
        "ratio",
        "flag"
      ],
      "title": "QualityFormulaKind",
      "type": "string"
    },
    "QualityGateBinding": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "contract_path": {
          "minLength": 1,
          "title": "Contract Path",
          "type": "string"
        },
        "input_locator": {
          "minLength": 1,
          "title": "Input Locator",
          "type": "string"
        },
        "metric_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualityMetricId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "not_applicable_result": {
          "default": "insufficient",
          "enum": [
            "insufficient",
            "pass"
          ],
          "title": "Not Applicable Result",
          "type": "string"
        },
        "observation_key": {
          "minLength": 1,
          "title": "Observation Key",
          "type": "string"
        },
        "operator": {
          "enum": [
            "gte",
            "equals"
          ],
          "title": "Operator",
          "type": "string"
        },
        "result_field": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Field"
        },
        "rule_binding_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Rule Binding Version",
          "type": "string"
        }
      },
      "required": [
        "constraint_id",
        "contract_path",
        "observation_key",
        "operator",
        "rule_binding_version",
        "input_locator"
      ],
      "title": "QualityGateBinding",
      "type": "object"
    },
    "QualityMetricId": {
      "enum": [
        "field_completeness",
        "field_missingness",
        "field_unresolved_rate",
        "field_provenance_coverage",
        "field_evidence_coverage",
        "field_unit_consistency",
        "field_same_source_conflict_rate",
        "field_cross_source_conflict_rate",
        "row_completeness",
        "row_missingness",
        "row_unresolved_rate",
        "row_provenance_coverage",
        "row_evidence_coverage",
        "row_unit_consistency",
        "row_conflict_rate",
        "row_low_confidence_flag",
        "row_review_required_flag",
        "row_inconclusive_flag",
        "dataset_completeness",
        "dataset_missingness",
        "dataset_unresolved_rate",
        "dataset_provenance_coverage",
        "dataset_evidence_coverage",
        "dataset_unit_consistency",
        "dataset_cross_source_conflict_rate",
        "dataset_same_source_conflict_rate",
        "object_match_coverage",
        "low_confidence_edge_rate",
        "review_required_record_rate",
        "inconclusive_record_rate",
        "source_scope_completeness",
        "validation_integrity"
      ],
      "title": "QualityMetricId",
      "type": "string"
    },
    "QualityMetricScope": {
      "enum": [
        "field",
        "row",
        "dataset"
      ],
      "title": "QualityMetricScope",
      "type": "string"
    },
    "QualityObservationId": {
      "enum": [
        "field.mapped_count",
        "field.applicable_count",
        "field.declared_null_count",
        "field.missing_count",
        "field.unresolved_count",
        "field.provenance_count",
        "field.evidence_count",
        "field.unit_consistent_assertion_count",
        "field.unit_applicable_assertion_count",
        "field.same_source_conflict_count",
        "field.cross_source_conflict_count",
        "row.mapped_count",
        "row.applicable_field_count",
        "row.missing_count",
        "row.unresolved_count",
        "row.provenance_count",
        "row.evidence_count",
        "row.unit_consistent_assertion_count",
        "row.unit_applicable_assertion_count",
        "row.conflict_count",
        "row.low_confidence_flag",
        "row.review_required_flag",
        "row.inconclusive_flag",
        "row.confidence_applicable_record_count",
        "row.adjudicable_record_count",
        "row.unpaired_record_count",
        "dataset.mapped_count",
        "dataset.applicable_cell_count",
        "dataset.missing_count",
        "dataset.unresolved_count",
        "dataset.provenance_count",
        "dataset.evidence_count",
        "dataset.evidence_applicable_count",
        "dataset.unit_consistent_assertion_count",
        "dataset.unit_applicable_assertion_count",
        "dataset.same_source_conflict_count",
        "dataset.cross_source_conflict_count",
        "dataset.object_match_count",
        "dataset.object_candidate_count",
        "dataset.low_confidence_edge_count",
        "dataset.candidate_edge_count",
        "dataset.review_required_record_count",
        "dataset.adjudicable_record_count",
        "dataset.inconclusive_record_count",
        "dataset.crossmatch_record_count",
        "dataset.complete_source_count",
        "dataset.required_source_count",
        "dataset.validation_pass_count",
        "dataset.validation_check_count"
      ],
      "title": "QualityObservationId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Frozen Data Quality Evaluation rules and all upstream identities they bind.",
  "properties": {
    "aggregate_score_policy": {
      "$ref": "#/$defs/QualityAggregateScorePolicy"
    },
    "applicability_policy": {
      "const": "projected_field_ids_only",
      "title": "Applicability Policy",
      "type": "string"
    },
    "capacity": {
      "$ref": "#/$defs/QualityCapacityPolicy"
    },
    "case_manifest_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Case Manifest Content Hash",
      "type": "string"
    },
    "case_manifest_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Case Manifest Id",
      "type": "string"
    },
    "case_manifest_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Case Manifest Version",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date",
      "title": "Created At",
      "type": "string"
    },
    "crossmatch_rule_set_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Crossmatch Rule Set Content Hash",
      "type": "string"
    },
    "crossmatch_rule_set_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Crossmatch Rule Set Id",
      "type": "string"
    },
    "crossmatch_rule_set_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Crossmatch Rule Set Version",
      "type": "string"
    },
    "crossmatch_schema_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Crossmatch Schema Version",
      "type": "string"
    },
    "data_artifact_candidate_schema_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Data Artifact Candidate Schema Version",
      "type": "string"
    },
    "data_artifact_input_schema_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Data Artifact Input Schema Version",
      "type": "string"
    },
    "empty_denominator_policy": {
      "enum": [
        "not_applicable",
        "insufficient"
      ],
      "title": "Empty Denominator Policy",
      "type": "string"
    },
    "field_manifest_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Field Manifest Content Hash",
      "type": "string"
    },
    "field_manifest_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Field Manifest Id",
      "type": "string"
    },
    "field_manifest_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Field Manifest Version",
      "type": "string"
    },
    "formula_registry": {
      "items": {
        "$ref": "#/$defs/QualityFormulaDefinition"
      },
      "minItems": 1,
      "title": "Formula Registry",
      "type": "array"
    },
    "gate_bindings": {
      "items": {
        "$ref": "#/$defs/QualityGateBinding"
      },
      "minItems": 1,
      "title": "Gate Bindings",
      "type": "array"
    },
    "incomplete_source_policy": {
      "const": "insufficient",
      "title": "Incomplete Source Policy",
      "type": "string"
    },
    "maintained_by": {
      "minLength": 1,
      "title": "Maintained By",
      "type": "string"
    },
    "precision_digits": {
      "exclusiveMinimum": 0,
      "maximum": 64,
      "title": "Precision Digits",
      "type": "integer"
    },
    "producer_name": {
      "minLength": 1,
      "title": "Producer Name",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Producer Version",
      "type": "string"
    },
    "publisher_gate_policy": {
      "const": "pass_only",
      "title": "Publisher Gate Policy",
      "type": "string"
    },
    "ratio_serialization": {
      "const": "plain_decimal_string_no_exponent",
      "title": "Ratio Serialization",
      "type": "string"
    },
    "rounding_mode": {
      "const": "ROUND_HALF_EVEN",
      "title": "Rounding Mode",
      "type": "string"
    },
    "rule_set_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Rule Set Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "rule_set_id",
    "schema_version",
    "version",
    "content_hash",
    "case_manifest_id",
    "case_manifest_version",
    "case_manifest_content_hash",
    "field_manifest_id",
    "field_manifest_version",
    "field_manifest_content_hash",
    "data_artifact_input_schema_version",
    "data_artifact_candidate_schema_version",
    "crossmatch_schema_version",
    "crossmatch_rule_set_id",
    "crossmatch_rule_set_version",
    "crossmatch_rule_set_content_hash",
    "producer_name",
    "producer_version",
    "precision_digits",
    "rounding_mode",
    "ratio_serialization",
    "applicability_policy",
    "incomplete_source_policy",
    "empty_denominator_policy",
    "formula_registry",
    "gate_bindings",
    "publisher_gate_policy",
    "aggregate_score_policy",
    "capacity",
    "created_at",
    "maintained_by"
  ],
  "title": "DataQualityRuleSet",
  "type": "object"
}
