{
  "$defs": {
    "BenchmarkScenarioStatus": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "BenchmarkScenarioStatus",
      "type": "string"
    },
    "CrossmatchBenchmarkScenarioResult": {
      "additionalProperties": false,
      "properties": {
        "failure_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason"
        },
        "observed_error_code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Error Code"
        },
        "result_content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Content Hash"
        },
        "scenario_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Scenario Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/BenchmarkScenarioStatus"
        }
      },
      "required": [
        "scenario_id",
        "status"
      ],
      "title": "CrossmatchBenchmarkScenarioResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "benchmark_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Benchmark Content Hash",
      "type": "string"
    },
    "benchmark_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Benchmark Version",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "failed_count": {
      "minimum": 0,
      "title": "Failed Count",
      "type": "integer"
    },
    "passed_count": {
      "minimum": 0,
      "title": "Passed Count",
      "type": "integer"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/CrossmatchBenchmarkScenarioResult"
      },
      "title": "Results",
      "type": "array"
    },
    "rule_set_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rule Set Content Hash",
      "type": "string"
    },
    "scenario_count": {
      "minimum": 0,
      "title": "Scenario Count",
      "type": "integer"
    }
  },
  "required": [
    "benchmark_id",
    "benchmark_version",
    "benchmark_content_hash",
    "rule_set_content_hash",
    "scenario_count",
    "passed_count",
    "failed_count",
    "results",
    "content_hash"
  ],
  "title": "CrossmatchBenchmarkReport",
  "type": "object"
}
