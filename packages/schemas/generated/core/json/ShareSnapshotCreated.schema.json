{
  "$defs": {
    "ShareRedactionPolicy": {
      "enum": [
        "redacted_public_snapshot"
      ],
      "title": "ShareRedactionPolicy",
      "type": "string"
    },
    "ShareStatus": {
      "enum": [
        "active",
        "expired",
        "revoked"
      ],
      "title": "ShareStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One-time creation response containing the only serialized raw share token.",
  "properties": {
    "artifact_version_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Artifact Version Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "redaction_policy": {
      "$ref": "#/$defs/ShareRedactionPolicy"
    },
    "revoked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revoked At"
    },
    "share_token": {
      "minLength": 1,
      "title": "Share Token",
      "type": "string"
    },
    "share_url": {
      "minLength": 1,
      "title": "Share Url",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ShareStatus"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "title",
    "artifact_version_ids",
    "evidence_ids",
    "redaction_policy",
    "status",
    "created_at",
    "expires_at",
    "share_token",
    "share_url"
  ],
  "title": "ShareSnapshotCreated",
  "type": "object"
}
