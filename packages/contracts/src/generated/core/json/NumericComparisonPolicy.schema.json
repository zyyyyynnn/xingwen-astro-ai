{
  "additionalProperties": false,
  "properties": {
    "absolute_tolerance": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Absolute Tolerance"
    },
    "collection_semantics": {
      "const": "span_absolute_or_relative_max_magnitude",
      "title": "Collection Semantics",
      "type": "string"
    },
    "relative_denominator_floor": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Relative Denominator Floor"
    },
    "relative_tolerance": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Relative Tolerance"
    },
    "threshold_inclusive": {
      "default": true,
      "title": "Threshold Inclusive",
      "type": "boolean"
    }
  },
  "required": [
    "absolute_tolerance",
    "relative_tolerance",
    "collection_semantics",
    "relative_denominator_floor"
