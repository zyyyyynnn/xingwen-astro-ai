{
  "$defs": {
    "BenchmarkEvidenceLevel": {
      "enum": [
        "public_abstract",
        "open_full_text",
        "publisher_metadata"
      ],
      "title": "BenchmarkEvidenceLevel",
      "type": "string"
    },
    "BenchmarkPaperTextLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "paper_text",
          "title": "Kind",
          "type": "string"
        },
        "paragraph": {
          "minimum": 1,
          "title": "Paragraph",
          "type": "integer"
        },
        "section": {
          "enum": [
            "abstract",
            "full_text"
          ],
          "title": "Section",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "text_range": {
          "minLength": 1,
          "title": "Text Range",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source_url",
        "section",
        "paragraph",
        "text_range"
      ],
      "title": "BenchmarkPaperTextLocator",
      "type": "object"
    },
    "BenchmarkReviewStatus": {
      "enum": [
        "pending_scientific_review",
        "approved",
        "changes_requested"
      ],
      "title": "BenchmarkReviewStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Evidence Id",
      "type": "string"
    },
    "evidence_level": {
      "$ref": "#/$defs/BenchmarkEvidenceLevel"
    },
    "evidence_type": {
      "const": "paper_text",
      "title": "Evidence Type",
      "type": "string"
    },
    "extraction_method": {
      "enum": [
        "manual_transcription_from_verified_source",
        "manual_paraphrase_from_verified_source"
      ],
      "title": "Extraction Method",
      "type": "string"
    },
    "locator": {
      "$ref": "#/$defs/BenchmarkPaperTextLocator"
    },
    "paper_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Paper Id",
      "type": "string"
    },
    "quote_or_value": {
      "minLength": 1,
      "title": "Quote Or Value",
      "type": "string"
    },
    "review_status": {
      "$ref": "#/$defs/BenchmarkReviewStatus",
      "default": "pending_scientific_review"
    },
    "target_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Target Id",
      "type": "string"
    },
    "target_type": {
      "enum": [
        "summary_statement",
        "claim",
        "relation",
        "graph_edge"
      ],
      "title": "Target Type",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "paper_id",
    "target_type",
    "target_id",
    "evidence_type",
    "evidence_level",
    "locator",
    "quote_or_value",
    "extraction_method",
    "confidence"
  ],
  "title": "BenchmarkEvidence",
  "type": "object"
}
