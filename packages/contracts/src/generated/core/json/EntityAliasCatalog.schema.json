{
  "$defs": {
    "EntityAliasEntry": {
      "additionalProperties": false,
      "properties": {
        "alias_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Alias Id",
          "type": "string"
        },
        "entity_level": {
          "$ref": "#/$defs/EntityLevel"
        },
        "left_field_id": {
          "pattern": "^(planet|star|system)\\.[a-z][a-z0-9_]*$",
          "title": "Left Field Id",
          "type": "string"
        },
        "left_source_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Left Source Id",
          "type": "string"
        },
        "left_value": {
          "minLength": 1,
          "title": "Left Value",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "right_field_id": {
          "pattern": "^(planet|star|system)\\.[a-z][a-z0-9_]*$",
          "title": "Right Field Id",
          "type": "string"
        },
        "right_source_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Right Source Id",
          "type": "string"
        },
        "right_value": {
          "minLength": 1,
          "title": "Right Value",
          "type": "string"
        }
      },
      "required": [
        "alias_id",
        "entity_level",
        "left_source_id",
        "left_field_id",
        "left_value",
        "right_source_id",
        "right_field_id",
        "right_value",
        "rationale"
      ],
      "title": "EntityAliasEntry",
      "type": "object"
    },
    "EntityLevel": {
      "enum": [
        "host_star",
        "planet_candidate",
        "planet_assertion"
      ],
      "title": "EntityLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "catalog_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Catalog Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date",
      "title": "Created At",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/EntityAliasEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "maintainer": {
      "minLength": 1,
      "title": "Maintainer",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "catalog_id",
    "version",
    "content_hash",
    "entries",
    "source",
    "maintainer",
    "created_at"
  ],
  "title": "EntityAliasCatalog",
  "type": "object"
}
