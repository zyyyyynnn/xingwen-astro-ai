{
  "$defs": {
    "SourceRecordItem": {
      "properties": {
        "cached": {
          "default": false,
          "title": "Cached",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "license_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Note"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SourceType"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "task_id",
        "type",
        "name",
        "url",
        "query",
        "retrieved_at"
      ],
      "title": "SourceRecordItem",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "database",
        "paper_source",
        "paper",
        "cache",
        "manual_review"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "properties": {
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRecordItem"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "sources"
  ],
  "title": "SourcesResponse",
  "type": "object"
}
