# App
# development：本地默认；integration/test：挂载 test-only bootstrap（仅 X-01 真实集成使用）；
# production：启用全部安全校验，禁止默认凭据。
APP_ENV=development
DEBUG=true
DEMO_CASE_KEY=exoplanet_host_star
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 本地 HTTP 默认关闭；production 配置必须显式设为 true。
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400
SESSION_CREATE_RATE_LIMIT=30
SHARE_CREATE_RATE_LIMIT=20
CURSOR_SIGNING_KEY=development-only-cursor-signing-key
# 真实 /api Runtime 的 PostgreSQL 权威存储开关。
# docker-compose.yml 已为 api 服务强制设为 true；本地 uvicorn 直连 PostgreSQL 时设为 true。
PERSISTENT_WORKFLOW_ENABLED=false

# Local service ports
SITE_PORT=4321
WORKSPACE_PORT=5173
API_PORT=8000
POSTGRES_PORT=5432

# Frontend
# PUBLIC_* 与 VITE_* 会进入浏览器输出，只能包含非敏感配置。
PUBLIC_WORKSPACE_URL=http://localhost:5173/workspace
# 仅为 API origin，不得预带 /api 路径；路径来自生成的 operation metadata。
VITE_API_BASE_URL=http://localhost:8000

# Database
# 本地占位值仅用于 Docker Compose；production 必须覆盖且禁止使用 postgres 默认密码。
POSTGRES_DB=xingwen_astro_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/xingwen_astro_ai
# 后端 PostgreSQL 集成测试使用的隔离数据库，库名必须包含 test。
# 不设时 PostgreSQL 门控测试按设计 skip；CI backend job 已配置。
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/xingwen_test_db

# Qwen / DashScope
# 百炼平台 API Key。若系统环境变量名为 ALIYUN_API_KEY，复制其值到此处 DASHSCOPE_API_KEY。
DASHSCOPE_API_KEY=replace_me
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_SECONDS=60

# Paper source
# Leave PAPER_SOURCE_API_KEY empty when the selected source does not require authentication.
PAPER_SOURCE_BASE_URL=https://example-paper-source.invalid
PAPER_SOURCE_API_KEY=
PAPER_SEARCH_TIMEOUT_SECONDS=30
PAPER_SEARCH_MAX_RESULTS=20

# Research Input ingestion (B-19)
# 单次输入（文件或 URL 抓取结果）字节上限。
RESEARCH_INPUT_MAX_SIZE_BYTES=26214400
# 允许的输入 MIME 类型（magic bytes 探测后比对；不信任客户端声明）。
RESEARCH_INPUT_ALLOWED_MIME_TYPES=application/pdf,text/csv,application/json,image/png,image/jpeg,image/webp,image/gif,text/plain
# 内容寻址存储目录（相对进程工作目录）。
RESEARCH_INPUT_UPLOAD_DIR=.data/research-inputs
# 每 Session 每分钟可创建的输入数。
RESEARCH_INPUT_RATE_LIMIT=30
# Idempotency 预留（pending reservation）的租约窗口（秒）。必须明显大于
# URL_FETCH_TIMEOUT_SECONDS * (URL_FETCH_MAX_REDIRECTS + 1)，避免正常 fetch
# 尚未完成时租约就被回收。
RESEARCH_INPUT_IDEMPOTENCY_LEASE_SECONDS=300
# URL 抓取策略：仅允许 https 协议。
# URL_FETCH_ALLOWED_HOSTS 为空时表示拒绝所有外部 fetch（Fail-Closed 闭环保护）。开发/测试需填入允许的主机。
URL_FETCH_ALLOWED_PROTOCOLS=https
URL_FETCH_ALLOWED_HOSTS=
URL_FETCH_TIMEOUT_SECONDS=15
URL_FETCH_MAX_REDIRECTS=3
URL_FETCH_MAX_RESPONSE_BYTES=26214400

# Demo fallback
ENABLE_DEMO_CACHE=true
CACHE_TTL_SECONDS=86400
