{
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "row_key": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "minLength": 1,
            "type": "string"
          }
        ],
        "type": "array"
      },
      "minItems": 1,
      "title": "Row Key",
      "type": "array"
    },
    "source_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "row_key",
    "payload",
    "content_hash"
  ],
  "title": "RawDataSourceRecord",
  "type": "object"
}
