{
  "$defs": {
    "ConditionOperator": {
      "enum": [
        "exact",
        "curated_alias",
        "angular_separation_lte",
        "angular_separation_gt",
        "contradicts",
        "source_scope"
      ],
      "title": "ConditionOperator",
      "type": "string"
    },
    "ConfidenceBand": {
      "enum": [
        "high",
        "medium",
        "low",
        "not_applicable"
      ],
      "title": "ConfidenceBand",
      "type": "string"
    },
    "CrossmatchArtifactAuthority": {
      "additionalProperties": false,
      "description": "Crossmatch-specific identity and Evidence authority for a candidate.",
      "properties": {
        "alignment_record_keys": {
          "default": [],
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Alignment Record Keys",
          "type": "array"
        },
        "authority_kind": {
          "const": "crossmatch",
          "default": "crossmatch",
          "title": "Authority Kind",
          "type": "string"
        },
        "conflict_record_keys": {
          "default": [],
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Conflict Record Keys",
          "type": "array"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CrossmatchEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "inconclusive_record_keys": {
          "default": [],
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Inconclusive Record Keys",
          "type": "array"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "result_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Result Id",
          "type": "string"
        },
        "review_required_record_keys": {
          "default": [],
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Review Required Record Keys",
          "type": "array"
        },
        "source_snapshot_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        }
      },
      "required": [
        "result_id",
        "input_hash",
        "output_hash",
        "content_hash",
        "source_snapshot_ids",
        "evidence",
        "evidence_ids"
      ],
      "title": "CrossmatchArtifactAuthority",
      "type": "object"
    },
    "CrossmatchCondition": {
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Condition Id",
          "type": "string"
        },
        "field_id": {
          "anyOf": [
            {
              "pattern": "^(planet|star|system)\\.[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Id"
        },
        "left_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Left Value"
        },
        "manual_review_threshold_arcsec": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Review Threshold Arcsec"
        },
        "operator": {
          "$ref": "#/$defs/ConditionOperator"
        },
        "right_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right Value"
        },
        "rule_reference": {
          "minLength": 1,
          "title": "Rule Reference",
          "type": "string"
        },
        "separation_arcsec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Separation Arcsec"
        },
        "strict_threshold_arcsec": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strict Threshold Arcsec"
        }
      },
      "required": [
        "condition_id",
        "operator",
        "rule_reference"
      ],
      "title": "CrossmatchCondition",
      "type": "object"
    },
    "CrossmatchEvidence": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "items": {
            "$ref": "#/$defs/CrossmatchCondition"
          },
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "confidence_band": {
          "$ref": "#/$defs/ConfidenceBand"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/MatchDecision"
        },
        "entity_level": {
          "$ref": "#/$defs/EntityLevel"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "left_candidate_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Left Candidate Id",
          "type": "string"
        },
        "left_locators": {
          "items": {
            "$ref": "#/$defs/EvidenceLocator"
          },
          "minItems": 1,
          "title": "Left Locators",
          "type": "array"
        },
        "method": {
          "$ref": "#/$defs/CrossmatchMethod"
        },
        "right_candidate_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Right Candidate Id",
          "type": "string"
        },
        "right_locators": {
          "items": {
            "$ref": "#/$defs/EvidenceLocator"
          },
          "minItems": 1,
          "title": "Right Locators",
          "type": "array"
        },
        "rule_set_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Rule Set Content Hash",
          "type": "string"
        },
        "rule_set_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Rule Set Id",
          "type": "string"
        },
        "rule_set_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Rule Set Version",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "entity_level",
        "method",
        "decision",
        "confidence",
        "confidence_band",
        "left_candidate_id",
        "right_candidate_id",
        "left_locators",
        "right_locators",
        "conditions",
        "rule_set_id",
        "rule_set_version",
        "rule_set_content_hash",
        "content_hash"
      ],
      "title": "CrossmatchEvidence",
      "type": "object"
    },
    "CrossmatchMethod": {
      "enum": [
        "exact_identifier",
        "curated_entity_alias",
        "coordinate",
        "compound"
      ],
      "title": "CrossmatchMethod",
      "type": "string"
    },
    "CrossmatchSide": {
      "enum": [
        "left",
        "right"
      ],
      "title": "CrossmatchSide",
      "type": "string"
    },
    "DataArtifactProducer": {
      "additionalProperties": false,
      "properties": {
        "conversion_catalog_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Conversion Catalog Content Hash",
          "type": "string"
        },
        "conversion_catalog_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Conversion Catalog Id",
          "type": "string"
        },
        "conversion_catalog_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Conversion Catalog Version",
          "type": "string"
        },
        "mapping_rule_set_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Mapping Rule Set Content Hash",
          "type": "string"
        },
        "mapping_rule_set_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Mapping Rule Set Id",
          "type": "string"
        },
        "mapping_rule_set_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Mapping Rule Set Version",
          "type": "string"
        },
        "producer_name": {
          "minLength": 1,
          "title": "Producer Name",
          "type": "string"
        },
        "producer_type": {
          "const": "algorithm",
          "default": "algorithm",
          "title": "Producer Type",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Producer Version",
          "type": "string"
        }
      },
      "required": [
        "producer_name",
        "producer_version",
        "mapping_rule_set_id",
        "mapping_rule_set_version",
        "mapping_rule_set_content_hash",
        "conversion_catalog_id",
        "conversion_catalog_version",
        "conversion_catalog_content_hash"
      ],
      "title": "DataArtifactProducer",
      "type": "object"
    },
    "DataQueryCursor": {
      "additionalProperties": false,
      "properties": {
        "tid": {
          "minimum": 0,
          "title": "Tid",
          "type": "integer"
        },
        "toi": {
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
          "title": "Toi",
          "type": "string"
        }
      },
      "required": [
        "tid",
        "toi"
      ],
      "title": "DataQueryCursor",
      "type": "object"
    },
    "DataSourceCompletion": {
      "additionalProperties": false,
      "description": "Typed source-completion semantics consumed by downstream data stages.",
      "properties": {
        "continuation_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataQueryCursor"
            },
            {
              "$ref": "#/$defs/SupplementalDataQueryCursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation Cursor"
        },
        "status": {
          "$ref": "#/$defs/DataSourceCompletionStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "DataSourceCompletion",
      "type": "object"
    },
    "DataSourceCompletionStatus": {
      "description": "Whether the bounded acquisition proved that its source scope is complete.",
      "enum": [
        "complete",
        "truncated",
        "unknown"
      ],
      "title": "DataSourceCompletionStatus",
      "type": "string"
    },
    "DataSourceDataLevel": {
      "description": "Acquisition evidence level, kept separate from the source origin.",
      "enum": [
        "live_result",
        "recorded_response",
        "fixture",
        "seed"
      ],
      "title": "DataSourceDataLevel",
      "type": "string"
    },
    "DataSourceSnapshotProjection": {
      "additionalProperties": false,
      "description": "Logical data-pipeline projection of one scientific source snapshot.",
      "properties": {
        "cache_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Version"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "license_note": {
          "minLength": 1,
          "title": "License Note",
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/JsonValue"
        },
        "query_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Query Hash",
          "type": "string"
        },
        "request_metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Request Metadata",
          "type": "object"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "source_version_or_etag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version Or Etag"
        }
      },
      "required": [
        "snapshot_id",
        "source_id",
        "source_type",
        "retrieved_at",
        "query",
        "query_hash",
        "content_hash",
        "license_note"
      ],
      "title": "DataSourceSnapshotProjection",
      "type": "object"
    },
    "DocumentSourceCollectionMember": {
      "additionalProperties": false,
      "description": "One admitted document research input retained as supplemental provenance.",
      "properties": {
        "document_parse_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Document Parse Ids",
          "type": "array"
        },
        "member_kind": {
          "const": "document",
          "default": "document",
          "title": "Member Kind",
          "type": "string"
        },
        "observation_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Observation Ids",
          "type": "array"
        },
        "query_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Query Hash",
          "type": "string"
        },
        "research_input_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Research Input Id",
          "type": "string"
        },
        "source_class": {
          "const": "document_research_input",
          "title": "Source Class",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_snapshot": {
          "$ref": "#/$defs/DataSourceSnapshotProjection"
        },
        "source_snapshot_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Snapshot Content Hash",
          "type": "string"
        },
        "source_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "source_class",
        "source_snapshot",
        "source_id",
        "source_snapshot_id",
        "source_snapshot_content_hash",
        "query_hash",
        "research_input_id",
        "document_parse_ids",
        "observation_ids"
      ],
      "title": "DocumentSourceCollectionMember",
      "type": "object"
    },
    "EntityLevel": {
      "enum": [
        "host_star",
        "planet_candidate",
        "planet_assertion"
      ],
      "title": "EntityLevel",
      "type": "string"
    },
    "EvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "query_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Query Hash",
          "type": "string"
        },
        "raw_field": {
          "minLength": 1,
          "title": "Raw Field",
          "type": "string"
        },
        "row_key": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "minLength": 1,
                "type": "string"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Row Key",
          "type": "array"
        },
        "side": {
          "$ref": "#/$defs/CrossmatchSide"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_snapshot_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "side",
        "source_snapshot_id",
        "source_id",
        "query_hash",
        "row_key",
        "raw_field"
      ],
      "title": "EvidenceLocator",
      "type": "object"
    },
    "JsonValue": {},
    "ManifestPins": {
      "additionalProperties": false,
      "properties": {
        "case_manifest_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Case Manifest Content Hash",
          "type": "string"
        },
        "case_manifest_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Case Manifest Id",
          "type": "string"
        },
        "case_manifest_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Case Manifest Version",
          "type": "string"
        },
        "field_manifest_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Field Manifest Content Hash",
          "type": "string"
        },
        "field_manifest_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Field Manifest Id",
          "type": "string"
        },
        "field_manifest_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Field Manifest Version",
          "type": "string"
        }
      },
      "required": [
        "case_manifest_id",
        "case_manifest_version",
        "case_manifest_content_hash",
        "field_manifest_id",
        "field_manifest_version",
        "field_manifest_content_hash"
      ],
      "title": "ManifestPins",
      "type": "object"
    },
    "MatchDecision": {
      "enum": [
        "accepted",
        "rejected",
        "review_required",
        "conflict",
        "inconclusive",
        "unmatched"
      ],
      "title": "MatchDecision",
      "type": "string"
    },
    "RawSourceRecordReference": {
      "additionalProperties": false,
      "properties": {
        "query_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Query Hash",
          "type": "string"
        },
        "raw_record_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Raw Record Content Hash",
          "type": "string"
        },
        "row_key": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "minLength": 1,
                "type": "string"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Row Key",
          "type": "array"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_snapshot_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Snapshot Content Hash",
          "type": "string"
        },
        "source_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_snapshot_id",
        "source_snapshot_content_hash",
        "query_hash",
        "row_key",
        "raw_record_content_hash"
      ],
      "title": "RawSourceRecordReference",
      "type": "object"
    },
    "SourceMode": {
      "description": "Actual origin of an ArtifactVersion-compatible pipeline payload.",
      "enum": [
        "fixture",
        "recorded",
        "live",
        "cached"
      ],
      "title": "SourceMode",
      "type": "string"
    },
    "SourceSnapshotRecord": {
      "additionalProperties": false,
      "description": "Immutable source provenance consumed by scientific pipelines.\n\nThis is a pipeline/runtime record, not an HTTP read projection. It preserves\nthe exact source, query and content identity required for reproducibility\nwhile rejecting credential-bearing request metadata before publication.",
      "properties": {
        "cache_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Version"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "license_note": {
          "minLength": 1,
          "title": "License Note",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "query_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Query Hash",
          "type": "string"
        },
        "request_metadata": {
          "additionalProperties": true,
          "title": "Request Metadata",
          "type": "object"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
