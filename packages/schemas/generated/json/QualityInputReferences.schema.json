{
  "$defs": {
    "QualityArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "canonical_content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Content Hash"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "lineage_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lineage Hash"
        },
        "output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "candidate_id",
        "input_hash",
        "output_hash"
      ],
      "title": "QualityArtifactReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "c04_input_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "C04 Input Hash",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/QualityArtifactReference"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Candidates",
      "type": "array"
    },
    "crossmatch_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Crossmatch Content Hash",
      "type": "string"
    },
    "crossmatch_input_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Crossmatch Input Hash",
      "type": "string"
    },
    "crossmatch_output_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Crossmatch Output Hash",
      "type": "string"
    },
    "crossmatch_result_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Crossmatch Result Id",
      "type": "string"
    },
    "quality_rule_set_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Quality Rule Set Content Hash",
      "type": "string"
    },
    "quality_rule_set_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Quality Rule Set Id",
      "type": "string"
    },
    "quality_rule_set_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Quality Rule Set Version",
      "type": "string"
    },
    "requested_field_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Requested Field Ids",
      "type": "array"
    },
    "research_contract_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Research Contract Content Hash",
      "type": "string"
    },
    "research_contract_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Research Contract Id",
      "type": "string"
    },
    "research_contract_version": {
      "minimum": 1,
      "title": "Research Contract Version",
      "type": "integer"
    },
    "row_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Row Ids",
      "type": "array"
    }
  },
  "required": [
    "c04_input_hash",
    "candidates",
    "requested_field_ids",
    "row_ids",
    "crossmatch_result_id",
    "crossmatch_input_hash",
    "crossmatch_output_hash",
    "crossmatch_content_hash",
    "research_contract_id",
    "research_contract_version",
    "research_contract_content_hash",
    "quality_rule_set_id",
    "quality_rule_set_version",
    "quality_rule_set_content_hash"
  ],
  "title": "QualityInputReferences",
  "type": "object"
}
