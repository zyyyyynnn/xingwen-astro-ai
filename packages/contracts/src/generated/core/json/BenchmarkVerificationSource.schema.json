{
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Id",
      "type": "string"
    },
    "url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Url",
      "type": "string"
    },
    "verified_at": {
      "format": "date",
      "title": "Verified At",
      "type": "string"
    },
    "verified_fields": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Verified Fields",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "url",
    "verified_at",
    "verified_fields"
  ],
  "title": "BenchmarkVerificationSource",
  "type": "object"
}
