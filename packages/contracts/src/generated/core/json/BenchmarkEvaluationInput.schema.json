{
  "additionalProperties": false,
  "description": "Counts from one evaluator run; this model performs no external calls.",
  "properties": {
    "evidence_less_relations_blocked": {
      "minimum": 0,
      "title": "Evidence Less Relations Blocked",
      "type": "integer"
    },
    "evidence_less_relations_total": {
      "minimum": 0,
      "title": "Evidence Less Relations Total",
      "type": "integer"
    },
    "evidence_requirements_satisfied": {
      "minimum": 0,
      "title": "Evidence Requirements Satisfied",
      "type": "integer"
    },
    "evidence_requirements_total": {
      "minimum": 0,
      "title": "Evidence Requirements Total",
      "type": "integer"
    },
    "retrieved_expected_paper_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Retrieved Expected Paper Ids",
      "type": "array"
    },
    "schema_items_total": {
      "minimum": 0,
      "title": "Schema Items Total",
      "type": "integer"
    },
    "schema_items_valid": {
      "minimum": 0,
      "title": "Schema Items Valid",
      "type": "integer"
    },
    "scientifically_reviewed_relations_correct": {
      "default": 0,
      "minimum": 0,
      "title": "Scientifically Reviewed Relations Correct",
      "type": "integer"
    },
    "scientifically_reviewed_relations_total": {
      "default": 0,
      "minimum": 0,
      "title": "Scientifically Reviewed Relations Total",
      "type": "integer"
    }
  },
  "required": [
    "schema_items_valid",
    "schema_items_total",
    "evidence_requirements_satisfied",
    "evidence_requirements_total",
    "evidence_less_relations_blocked",
    "evidence_less_relations_total"
  ],
  "title": "BenchmarkEvaluationInput",
  "type": "object"
}
