{
  "$defs": {
    "EvidenceType": {
      "enum": [
        "database_query",
        "paper_search",
        "paper_metadata",
        "paper_text",
        "model_extraction",
        "reasoning_trace",
        "user_feedback",
        "cache_record"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "GraphAlgorithmProducer": {
      "additionalProperties": false,
      "properties": {
        "aggregation_policy_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Aggregation Policy Version",
          "type": "string"
        },
        "capacity_policy_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Capacity Policy Version",
          "type": "string"
        },
        "filter_policy_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Filter Policy Version",
          "type": "string"
        },
        "identity_policy_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Identity Policy Version",
          "type": "string"
        },
        "integrity_policy_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Integrity Policy Version",
          "type": "string"
        },
        "parameters_hash": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Parameters Hash",
          "type": "string"
        },
        "producer_name": {
          "const": "evidence-graph-pipeline",
          "default": "evidence-graph-pipeline",
          "title": "Producer Name",
          "type": "string"
        },
        "producer_type": {
          "const": "algorithm",
          "default": "algorithm",
          "title": "Producer Type",
          "type": "string"
        },
        "producer_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Producer Version",
          "type": "string"
        },
        "progressive_policy_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Progressive Policy Version",
          "type": "string"
        },
        "taxonomy_policy_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Taxonomy Policy Version",
          "type": "string"
        }
      },
      "required": [
        "parameters_hash"
      ],
      "title": "GraphAlgorithmProducer",
      "type": "object"
    },
    "GraphArtifactCandidate": {
      "additionalProperties": false,
      "description": "The only Evidence Graph candidate accepted by the generic Publisher port.",
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/GraphArtifactEdge"
          },
          "maxItems": 20000,
          "minItems": 1,
          "title": "Edges",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 50000,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_uses": {
          "items": {
            "$ref": "#/$defs/GraphEvidenceUse"
          },
          "maxItems": 50000,
          "minItems": 1,
          "title": "Evidence Uses",
          "type": "array"
        },
        "graph_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Graph Id",
          "type": "string"
        },
        "input_hash": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "input_versions": {
          "$ref": "#/$defs/GraphInputVersionClosure"
        },
        "integrity_report": {
          "$ref": "#/$defs/GraphIntegrityReport"
        },
        "kind": {
          "const": "graph",
          "default": "graph",
          "title": "Kind",
          "type": "string"
        },
        "layout_hash": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Layout Hash",
          "type": "string"
        },
        "layout_hint": {
          "$ref": "#/$defs/GraphLayoutHint"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/GraphArtifactNode"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "output_hash": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "policies": {
          "$ref": "#/$defs/GraphPolicySet"
        },
        "producer": {
          "$ref": "#/$defs/GraphAlgorithmProducer"
        },
        "progressive": {
          "$ref": "#/$defs/GraphProgressiveInput"
        },
        "project_id": {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "report_hash": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Report Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_hash": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Scientific Hash",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/GraphBuildScope"
        },
        "source_snapshot_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "source_snapshots": {
          "items": {
            "$ref": "#/$defs/GraphSourceSnapshotReference"
          },
          "minItems": 1,
          "title": "Source Snapshots",
          "type": "array"
        },
        "taxonomy": {
          "$ref": "#/$defs/GraphTaxonomy"
        }
      },
      "required": [
        "graph_id",
        "project_id",
        "input_versions",
        "taxonomy",
        "policies",
        "scope",
        "nodes",
        "edges",
        "evidence_uses",
        "source_snapshots",
        "evidence_ids",
        "source_snapshot_ids",
        "integrity_report",
        "progressive",
        "layout_hint",
        "producer",
        "input_hash",
        "scientific_hash",
        "layout_hash",
        "report_hash",
        "output_hash"
      ],
      "title": "GraphArtifactCandidate",
      "type": "object"
    },
    "GraphArtifactEdge": {
      "additionalProperties": false,
      "properties": {
        "data_aggregation": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphDataEdgeAggregation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "edge_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Edge Id",
          "type": "string"
        },
        "edge_type": {
          "enum": [
            "uses_dataset",
            "provides_field",
            "supports_finding",
            "supports",
            "extends",
            "derived_from",
            "limits",
            "contradicts",
            "uses_same_dataset",
            "compares_method"
          ],
          "title": "Edge Type",
          "type": "string"
        },
        "evidence_use_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Evidence Use Ids",
          "type": "array"
        },
        "relation_trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphRelationTraceBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Node Id",
          "type": "string"
        },
        "target_node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Target Node Id",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "edge_type",
        "source_node_id",
        "target_node_id",
        "evidence_use_ids"
      ],
      "title": "GraphArtifactEdge",
      "type": "object"
    },
    "GraphArtifactNode": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "logical_reference": {
          "items": {
            "$ref": "#/$defs/GraphLogicalReferencePart"
          },
          "minItems": 1,
          "title": "Logical Reference",
          "type": "array"
        },
        "node_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "node_type": {
          "enum": [
            "research_goal",
            "dataset",
            "field",
            "paper",
            "claim"
          ],
          "title": "Node Type",
          "type": "string"
        },
        "version_bindings": {
          "items": {
            "$ref": "#/$defs/GraphNodeVersionBinding"
          },
          "minItems": 1,
          "title": "Version Bindings",
          "type": "array"
        }
      },
      "required": [
        "node_id",
        "node_type",
        "label",
        "logical_reference",
        "version_bindings"
      ],
      "title": "GraphArtifactNode",
      "type": "object"
    },
    "GraphArtifactVersionReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_version_id": {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Artifact Version Id",
          "type": "string"
        },
        "content_hash": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "input_hash": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "kind": {
          "enum": [
            "literature_relations",
            "dataset",
            "field_dictionary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "output_hash": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "parameters_hash": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Parameters Hash",
          "type": "string"
        },
        "producer_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Producer Name",
          "type": "string"
        },
        "producer_type": {
          "enum": [
            "pipeline",
            "model",
            "algorithm"
          ],
          "title": "Producer Type",
          "type": "string"
        },
        "producer_version": {
          "maxLength": 32,
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Producer Version",
          "type": "string"
        },
        "project_id": {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/GraphInputRole"
        },
        "schema_version": {
          "maxLength": 32,
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_mode": {
          "$ref": "#/$defs/SourceMode"
        },
        "version_number": {
          "minimum": 1,
          "title": "Version Number",
          "type": "integer"
        }
      },
      "required": [
        "role",
        "artifact_id",
        "artifact_version_id",
        "project_id",
        "version_number",
        "kind",
        "schema_version",
        "content_hash",
        "input_hash",
        "output_hash",
        "source_mode",
        "producer_type",
        "producer_name",
        "producer_version",
        "parameters_hash"
      ],
      "title": "GraphArtifactVersionReference",
      "type": "object"
    },
    "GraphBuildScope": {
      "additionalProperties": false,
      "properties": {
        "accepted_relation_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Accepted Relation Ids",
          "type": "array"
        },
        "excluded_item_count": {
          "default": 0,
          "maximum": 50000,
          "minimum": 0,
          "title": "Excluded Item Count",
          "type": "integer"
        },
        "exclusion_reasons": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Exclusion Reasons",
          "type": "array"
        },
        "filtered_item_count": {
          "default": 0,
          "maximum": 50000,
          "minimum": 0,
          "title": "Filtered Item Count",
          "type": "integer"
        },
        "include_data": {
          "default": false,
          "title": "Include Data",
          "type": "boolean"
        },
        "literature_claim_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Literature Claim Ids",
          "type": "array"
        },
        "literature_paper_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Literature Paper Ids",
          "type": "array"
        },
        "research_goal_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Research Goal Id"
        },
        "structural_edges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GraphStructuralEdgeRequest"
          },
          "title": "Structural Edges",
          "type": "array"
        }
      },
      "title": "GraphBuildScope",
      "type": "object"
    },
    "GraphCapacityPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_edges": {
          "default": 20000,
          "maximum": 20000,
          "minimum": 1,
          "title": "Max Edges",
          "type": "integer"
        },
        "max_evidence_uses": {
          "default": 50000,
          "maximum": 50000,
          "minimum": 1,
          "title": "Max Evidence Uses",
          "type": "integer"
        },
        "max_evidence_uses_per_edge": {
          "default": 5000,
          "maximum": 5000,
          "minimum": 1,
          "title": "Max Evidence Uses Per Edge",
          "type": "integer"
        },
        "max_input_versions": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Input Versions",
          "type": "integer"
        },
        "max_items_per_chunk": {
          "default": 10000,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Items Per Chunk",
          "type": "integer"
        },
        "max_label_length": {
          "default": 256,
          "maximum": 256,
          "minimum": 1,
          "title": "Max Label Length",
          "type": "integer"
        },
        "max_metadata_length": {
          "default": 2048,
          "maximum": 2048,
          "minimum": 1,
          "title": "Max Metadata Length",
          "type": "integer"
        },
        "max_nodes": {
          "default": 10000,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Nodes",
          "type": "integer"
        },
        "max_progressive_chunks": {
          "default": 256,
          "maximum": 256,
          "minimum": 1,
          "title": "Max Progressive Chunks",
          "type": "integer"
        },
        "max_serialized_bytes": {
          "default": 4194304,
          "maximum": 4194304,
          "minimum": 1,
          "title": "Max Serialized Bytes",
          "type": "integer"
        },
        "version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "GraphCapacityPolicy",
      "type": "object"
    },
    "GraphDataEdgeAggregation": {
      "additionalProperties": false,
      "description": "Stable Dataset/Field provenance counts for one ``provides_field`` edge.",
      "properties": {
        "conflict_count": {
          "minimum": 0,
          "title": "Conflict Count",
          "type": "integer"
        },
        "declared_null_outcome_count": {
          "minimum": 0,
          "title": "Declared Null Outcome Count",
          "type": "integer"
        },
        "mapped_outcome_count": {
          "minimum": 0,
          "title": "Mapped Outcome Count",
          "type": "integer"
        },
        "projected_row_count": {
          "minimum": 1,
          "title": "Projected Row Count",
          "type": "integer"
        },
        "retained_candidate_count": {
          "minimum": 0,
          "title": "Retained Candidate Count",
          "type": "integer"
        },
        "selected_candidate_count": {
          "minimum": 0,
          "title": "Selected Candidate Count",
          "type": "integer"
        },
        "unresolved_outcome_count": {
          "minimum": 0,
          "title": "Unresolved Outcome Count",
          "type": "integer"
        },
        "unselected_candidate_count": {
          "minimum": 0,
          "title": "Unselected Candidate Count",
          "type": "integer"
        },
        "upstream_evidence_count": {
          "minimum": 1,
          "title": "Upstream Evidence Count",
          "type": "integer"
        }
      },
      "required": [
        "projected_row_count",
        "mapped_outcome_count",
        "declared_null_outcome_count",
        "unresolved_outcome_count",
        "retained_candidate_count",
        "selected_candidate_count",
        "unselected_candidate_count",
        "conflict_count",
        "upstream_evidence_count"
      ],
      "title": "GraphDataEdgeAggregation",
      "type": "object"
    },
    "GraphEvidenceUse": {
      "additionalProperties": false,
      "properties": {
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "evidence_use_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Evidence Use Id",
          "type": "string"
        },
        "graph_edge_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Graph Edge Id",
          "type": "string"
        },
        "source_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "upstream_artifact_version_id": {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Upstream Artifact Version Id",
          "type": "string"
        },
        "upstream_evidence_hash": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Upstream Evidence Hash",
          "type": "string"
        },
        "upstream_evidence_id": {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Upstream Evidence Id",
          "type": "string"
        },
        "upstream_is_restricted": {
          "title": "Upstream Is Restricted",
          "type": "boolean"
        },
        "upstream_target_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Upstream Target Id",
          "type": "string"
        },
        "upstream_target_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Upstream Target Type",
          "type": "string"
        }
      },
      "required": [
        "evidence_use_id",
        "graph_edge_id",
        "upstream_artifact_version_id",
        "upstream_evidence_id",
        "upstream_target_type",
        "upstream_target_id",
        "source_snapshot_id",
        "evidence_type",
        "upstream_evidence_hash",
        "upstream_is_restricted"
      ],
      "title": "GraphEvidenceUse",
      "type": "object"
    },
    "GraphInputRole": {
      "enum": [
        "literature_relations",
        "dataset",
        "field_dictionary"
      ],
      "title": "GraphInputRole",
      "type": "string"
    },
    "GraphInputVersionClosure": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "maxLength": 36,
