{
  "$defs": {
    "AtlasWorkspaceState": {
      "additionalProperties": false,
      "properties": {
        "focus_mode": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focus Mode"
        },
        "selected_object_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "AtlasWorkspaceState",
      "type": "object"
    },
    "ObservatoryWorkspaceState": {
      "additionalProperties": false,
      "properties": {
        "active_artifact_version_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Artifact Version Id"
        },
        "active_evidence_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Evidence Id"
        }
      },
      "title": "ObservatoryWorkspaceState",
      "type": "object"
    },
    "WorkspaceObjectRef": {
      "additionalProperties": false,
      "description": "Stable reference to an object shown in the private workspace.",
      "properties": {
        "artifact_version_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Version Id"
        },
        "object_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "object_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Object Type",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id"
      ],
      "title": "WorkspaceObjectRef",
      "type": "object"
    },
    "WorkspacePanelSlot": {
      "additionalProperties": false,
      "description": "Bounded panel placement without persisting arbitrary window or GPU state.",
      "properties": {
        "artifact_version_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Version Id"
        },
        "evidence_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "panel_type": {
          "enum": [
            "atlas",
            "observatory"
          ],
          "title": "Panel Type",
          "type": "string"
        },
        "slot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Slot Id",
          "type": "string"
        }
      },
      "required": [
        "slot_id",
        "panel_type"
      ],
      "title": "WorkspacePanelSlot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Editable private workspace state accepted by the PUT endpoint.",
  "properties": {
    "active_run_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Run Id"
    },
    "atlas_state": {
      "$ref": "#/$defs/AtlasWorkspaceState"
    },
    "layout_preset": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Layout Preset",
      "type": "string"
    },
    "observatory_state": {
      "$ref": "#/$defs/ObservatoryWorkspaceState"
    },
    "panel_slots": {
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkspacePanelSlot"
      },
      "maxItems": 3,
      "title": "Panel Slots",
      "type": "array"
    },
    "pinned_evidence_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Pinned Evidence Ids",
      "type": "array"
    },
    "selected_object_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkspaceObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "layout_preset"
  ],
  "title": "WorkspaceSnapshotInput",
  "type": "object"
}
