{
  "$defs": {
    "QualityGateBinding": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "contract_path": {
          "minLength": 1,
          "title": "Contract Path",
          "type": "string"
        },
        "input_locator": {
          "minLength": 1,
          "title": "Input Locator",
          "type": "string"
        },
        "metric_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualityMetricId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "not_applicable_result": {
          "default": "insufficient",
          "enum": [
            "insufficient",
            "pass"
          ],
          "title": "Not Applicable Result",
          "type": "string"
        },
        "observation_key": {
          "minLength": 1,
          "title": "Observation Key",
          "type": "string"
        },
        "operator": {
          "enum": [
            "gte",
            "equals"
          ],
          "title": "Operator",
          "type": "string"
        },
        "result_field": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Field"
        },
        "rule_binding_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Rule Binding Version",
          "type": "string"
        }
      },
      "required": [
        "constraint_id",
        "contract_path",
        "observation_key",
        "operator",
        "rule_binding_version",
        "input_locator"
      ],
      "title": "QualityGateBinding",
      "type": "object"
    },
    "QualityMetricId": {
      "enum": [
        "field_completeness",
        "field_missingness",
        "field_unresolved_rate",
        "field_provenance_coverage",
        "field_evidence_coverage",
        "field_unit_consistency",
        "field_same_source_conflict_rate",
        "field_cross_source_conflict_rate",
        "row_completeness",
        "row_missingness",
        "row_unresolved_rate",
        "row_provenance_coverage",
        "row_evidence_coverage",
        "row_unit_consistency",
        "row_conflict_rate",
        "row_low_confidence_flag",
        "row_review_required_flag",
        "row_inconclusive_flag",
        "dataset_completeness",
        "dataset_missingness",
        "dataset_unresolved_rate",
        "dataset_provenance_coverage",
        "dataset_evidence_coverage",
        "dataset_unit_consistency",
        "dataset_cross_source_conflict_rate",
        "dataset_same_source_conflict_rate",
        "object_match_coverage",
        "low_confidence_edge_rate",
        "review_required_record_rate",
        "inconclusive_record_rate",
        "source_scope_completeness",
        "validation_integrity"
      ],
      "title": "QualityMetricId",
      "type": "string"
    },
    "QualityMetricPlan": {
      "additionalProperties": false,
      "description": "One compiled metric definition used by both execution and validation.",
      "properties": {
        "applicability": {
          "enum": [
            "projected_field_ids_only",
            "dataset_scope",
            "row_scope"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "empty_denominator_policy": {
          "enum": [
            "not_applicable",
            "insufficient"
          ],
          "title": "Empty Denominator Policy",
          "type": "string"
        },
        "formula_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Formula Id",
          "type": "string"
        },
        "formula_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Formula Version",
          "type": "string"
        },
        "incomplete_source_policy": {
          "enum": [
            "insufficient",
            "not_applicable"
          ],
          "title": "Incomplete Source Policy",
          "type": "string"
        },
        "manifest_input": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Input"
        },
        "metric_id": {
          "$ref": "#/$defs/QualityMetricId"
        },
        "result_field": {
          "minLength": 1,
          "title": "Result Field",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/QualityMetricScope"
        }
      },
      "required": [
        "metric_id",
        "scope",
        "formula_id",
        "formula_version",
        "result_field",
        "applicability",
        "incomplete_source_policy",
        "empty_denominator_policy"
      ],
      "title": "QualityMetricPlan",
      "type": "object"
    },
    "QualityMetricScope": {
      "enum": [
        "field",
        "row",
        "dataset"
      ],
      "title": "QualityMetricScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable plan compiled from one frozen RuleSet.",
  "properties": {
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "gate_bindings": {
      "items": {
        "$ref": "#/$defs/QualityGateBinding"
      },
      "minItems": 1,
      "title": "Gate Bindings",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/QualityMetricPlan"
      },
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    },
    "precision_digits": {
      "exclusiveMinimum": 0,
      "maximum": 64,
      "title": "Precision Digits",
      "type": "integer"
    },
    "ratio_serialization": {
      "const": "plain_decimal_string_no_exponent",
      "title": "Ratio Serialization",
      "type": "string"
    },
    "rounding_mode": {
      "const": "ROUND_HALF_EVEN",
      "title": "Rounding Mode",
      "type": "string"
    },
    "rule_set_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rule Set Content Hash",
      "type": "string"
    },
    "rule_set_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Rule Set Id",
      "type": "string"
    },
    "rule_set_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Rule Set Version",
      "type": "string"
    }
  },
  "required": [
    "rule_set_id",
    "rule_set_version",
    "rule_set_content_hash",
    "precision_digits",
    "rounding_mode",
    "ratio_serialization",
    "metrics",
    "gate_bindings",
    "content_hash"
  ],
  "title": "QualityEvaluationPlan",
  "type": "object"
}
