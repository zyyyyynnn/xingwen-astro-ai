{
  "additionalProperties": false,
  "description": "Required provenance coordinates for a future source value.",
  "properties": {
    "locator_type": {
      "const": "database_cell",
      "title": "Locator Type",
      "type": "string"
    },
    "required_components": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Components",
      "type": "array"
    },
    "rule_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Rule Id",
      "type": "string"
    },
    "rule_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Rule Version",
      "type": "string"
    },
    "source_reference_when_available": {
      "default": true,
      "title": "Source Reference When Available",
      "type": "boolean"
    }
  },
  "required": [
    "rule_id",
    "rule_version",
    "locator_type",
    "required_components"
  ],
  "title": "EvidenceLocatorRule",
  "type": "object"
}
