{
  "$defs": {
    "ClaimType": {
      "enum": [
        "goal",
        "method",
        "dataset",
        "finding",
        "limitation",
        "future_work"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "LiteratureClaimAdmissionResult": {
      "additionalProperties": false,
      "properties": {
        "admission_status": {
          "$ref": "#/$defs/LiteratureClaimStatus"
        },
        "failure_stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiteratureClaimFailureStage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/LiteratureClaimProducerExecution"
        },
        "publisher_candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiteratureClaimsCandidate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "records": {
          "items": {
            "$ref": "#/$defs/LiteratureClaimCandidate"
          },
          "title": "Records",
          "type": "array"
        },
        "rejection_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiteratureClaimRejectionReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "admission_status",
        "records",
        "producer",
        "output_hash"
      ],
      "title": "LiteratureClaimAdmissionResult",
      "type": "object"
    },
    "LiteratureClaimBenchmarkCaseKind": {
      "enum": [
        "scientific_label",
        "rejection_case"
      ],
      "title": "LiteratureClaimBenchmarkCaseKind",
      "type": "string"
    },
    "LiteratureClaimCandidate": {
      "additionalProperties": false,
      "description": "Schema-valid Claim with the outcome of deterministic D-07 admission.",
      "properties": {
        "claim_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "comparison_basis": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparison Basis"
        },
        "conditions": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "failure_stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiteratureClaimFailureStage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "limitations": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "metric": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "model_response_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Model Response Hash",
          "type": "string"
        },
        "normalization_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Normalization Version",
          "type": "string"
        },
        "normalized_text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Normalized Text",
          "type": "string"
        },
        "objects": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Objects",
          "type": "array"
        },
        "paper_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Paper Id",
          "type": "string"
        },
        "polarity": {
          "$ref": "#/$defs/LiteratureClaimPolarity"
        },
        "producer_execution_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Producer Execution Id",
          "type": "string"
        },
        "qualifiers": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Qualifiers",
          "type": "array"
        },
        "rejection_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiteratureClaimRejectionReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scope": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Scope",
          "type": "array"
        },
        "source_paper_summary_artifact_version_id": {
          "pattern": "^(?:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*|[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})$",
          "title": "Source Paper Summary Artifact Version Id",
          "type": "string"
        },
        "source_snapshot_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "source_statement_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Statement Id",
          "type": "string"
        },
        "source_summary_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Summary Id"
        },
        "status": {
          "$ref": "#/$defs/LiteratureClaimStatus"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "claim_id",
        "source_statement_id",
        "paper_id",
        "source_paper_summary_artifact_version_id",
        "text",
        "normalized_text",
        "claim_type",
        "polarity",
        "objects",
        "conditions",
        "scope",
        "limitations",
        "qualifiers",
        "evidence_ids",
        "source_snapshot_ids",
        "normalization_version",
        "fingerprint",
        "status",
        "producer_execution_id",
        "input_hash",
        "model_response_hash"
      ],
      "title": "LiteratureClaimCandidate",
      "type": "object"
    },
    "LiteratureClaimEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "paper_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Paper Id",
          "type": "string"
        },
        "source_snapshot_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Snapshot Content Hash",
          "type": "string"
        },
        "source_snapshot_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "source_snapshot_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Snapshot Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "unsupported",
            "unverifiable"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary_statement_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Summary Statement Id",
          "type": "string"
        },
        "validation_code": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Validation Code",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "evidence_id",
        "summary_statement_id",
        "paper_id",
        "source_snapshot_id",
        "source_snapshot_version",
        "source_snapshot_content_hash",
        "status",
        "validation_code"
      ],
      "title": "LiteratureClaimEvidenceReference",
      "type": "object"
    },
    "LiteratureClaimFailureStage": {
      "enum": [
        "json",
        "schema",
        "input",
        "evidence",
        "ownership",
        "normalization",
        "duplicate"
      ],
      "title": "LiteratureClaimFailureStage",
      "type": "string"
    },
    "LiteratureClaimInputVersions": {
      "additionalProperties": false,
      "description": "Trace retained even when the requested Summary version cannot be resolved.",
      "properties": {
        "paper_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Paper Id",
          "type": "string"
        },
        "paper_summary_artifact_version_id": {
          "pattern": "^(?:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*|[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})$",
          "title": "Paper Summary Artifact Version Id",
          "type": "string"
        },
        "paper_summary_output_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Summary Output Hash"
        },
        "paper_summary_schema_version": {
          "anyOf": [
            {
              "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Summary Schema Version"
        },
        "source_snapshots": {
          "items": {
            "$ref": "#/$defs/PaperSummarySourceSnapshotReference"
          },
          "title": "Source Snapshots",
          "type": "array"
        },
        "summary_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary Id"
        }
      },
      "required": [
        "paper_summary_artifact_version_id",
        "paper_id",
        "source_snapshots"
      ],
      "title": "LiteratureClaimInputVersions",
      "type": "object"
    },
    "LiteratureClaimPolarity": {
      "enum": [
        "positive",
        "negative",
        "neutral",
        "mixed"
      ],
      "title": "LiteratureClaimPolarity",
      "type": "string"
    },
    "LiteratureClaimProducerExecution": {
      "additionalProperties": false,
      "properties": {
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiteratureClaimRejectionReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Execution Id",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "input_versions": {
          "$ref": "#/$defs/LiteratureClaimInputVersions"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model_name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "model_response_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Model Response Hash",
          "type": "string"
        },
        "output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "parameters_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Parameters Hash",
          "type": "string"
        },
        "parameters_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Parameters Version",
          "type": "string"
        },
        "producer_name": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Producer Name",
          "type": "string"
        },
        "producer_type": {
          "const": "model",
          "default": "model",
          "title": "Producer Type",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Producer Version",
          "type": "string"
        },
        "prompt_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Prompt Hash",
          "type": "string"
        },
        "prompt_name": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Prompt Name",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^(?:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*|[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "step_key": {
          "const": "reasoning_literature",
          "default": "reasoning_literature",
          "title": "Step Key",
          "type": "string"
        }
      },
      "required": [
        "execution_id",
        "producer_name",
        "producer_version",
        "model_name",
        "prompt_name",
        "prompt_version",
        "prompt_hash",
        "schema_version",
        "parameters_version",
        "parameters_hash",
        "input_versions",
        "input_hash",
        "model_response_hash",
        "output_hash",
        "status",
        "started_at",
        "finished_at",
        "latency_ms"
      ],
      "title": "LiteratureClaimProducerExecution",
      "type": "object"
    },
    "LiteratureClaimRejectionReason": {
      "enum": [
        "literature_claim.json_invalid",
        "literature_claim.schema_invalid",
        "literature_claim.input_artifact_version_unknown",
        "literature_claim.input_schema_version_unsupported",
        "literature_claim.evidence_missing",
        "literature_claim.evidence_not_found",
        "literature_claim.source_snapshot_not_found",
        "literature_claim.ownership_mismatch",
        "literature_claim.normalization_unsafe",
        "literature_claim.duplicate"
      ],
      "title": "LiteratureClaimRejectionReason",
      "type": "string"
    },
    "LiteratureClaimStatus": {
      "enum": [
        "candidate",
        "accepted",
        "rejected"
      ],
      "title": "LiteratureClaimStatus",
      "type": "string"
    },
    "LiteratureClaimStatusCounts": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "minimum": 0,
          "title": "Accepted",
          "type": "integer"
        },
        "candidate": {
          "minimum": 0,
          "title": "Candidate",
          "type": "integer"
        },
        "rejected": {
          "minimum": 0,
          "title": "Rejected",
          "type": "integer"
        }
      },
      "required": [
        "accepted",
        "candidate",
        "rejected"
      ],
      "title": "LiteratureClaimStatusCounts",
      "type": "object"
    },
    "LiteratureClaimsCandidate": {
      "additionalProperties": false,
      "description": "Publisher-ready typed candidate produced only by the D-07 pipeline.",
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/LiteratureClaimCandidate"
          },
          "minItems": 1,
          "title": "Claims",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/PaperSummaryEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_references": {
          "items": {
            "$ref": "#/$defs/LiteratureClaimEvidenceReference"
          },
          "title": "Evidence References",
          "type": "array"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "input_versions": {
          "$ref": "#/$defs/LiteratureClaimInputVersions"
        },
        "kind": {
          "const": "literature_claims",
          "default": "literature_claims",
          "title": "Kind",
          "type": "string"
        },
        "output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/LiteratureClaimProducerExecution"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_snapshot_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "status_counts": {
          "$ref": "#/$defs/LiteratureClaimStatusCounts"
        }
      },
      "required": [
        "input_versions",
        "claims",
        "evidence",
        "evidence_references",
        "evidence_ids",
        "source_snapshot_ids",
        "status_counts",
        "producer",
        "input_hash",
        "output_hash"
      ],
      "title": "LiteratureClaimsCandidate",
      "type": "object"
    },
    "PaperSummaryEvidence": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/PaperSummaryEvidenceLocator"
        },
        "paper_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Paper Id",
          "type": "string"
        },
        "quote_or_value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Quote Or Value",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_record_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "source_snapshot_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Snapshot Content Hash",
          "type": "string"
        },
        "source_snapshot_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "source_snapshot_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Snapshot Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PaperSummarySupportStatus"
        },
        "validation_code": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Validation Code",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "paper_id",
        "candidate_id",
        "source_id",
        "source_record_id",
        "source_snapshot_id",
        "source_snapshot_version",
        "source_snapshot_content_hash",
        "locator",
        "quote_or_value",
        "status",
        "validation_code"
      ],
      "title": "PaperSummaryEvidence",
      "type": "object"
    },
    "PaperSummaryEvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
