{
  "name": "@xingwen/ui",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#components/*": "./src/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#ui/*": "./src/*.tsx",
    "#utils": "./src/lib/utils.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./icons": {
      "types": "./src/icons.ts",
      "default": "./src/icons.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "19.2.7"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.25.0",
    "radix-ui": "1.6.7",
    "sonner": "2.0.8",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
