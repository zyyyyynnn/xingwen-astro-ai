{
  "$defs": {
    "DataQueryCursor": {
      "additionalProperties": false,
      "properties": {
        "tid": {
          "minimum": 0,
          "title": "Tid",
          "type": "integer"
        },
        "toi": {
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
          "title": "Toi",
          "type": "string"
        }
      },
      "required": [
        "tid",
        "toi"
      ],
      "title": "DataQueryCursor",
      "type": "object"
    },
    "DataSourceCompletion": {
      "additionalProperties": false,
      "description": "Typed source-completion semantics consumed by downstream data stages.",
      "properties": {
        "continuation_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataQueryCursor"
            },
            {
              "$ref": "#/$defs/SupplementalDataQueryCursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation Cursor"
        },
        "status": {
          "$ref": "#/$defs/DataSourceCompletionStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "DataSourceCompletion",
      "type": "object"
    },
    "DataSourceCompletionStatus": {
      "description": "Whether the bounded acquisition proved that its source scope is complete.",
      "enum": [
        "complete",
        "truncated",
        "unknown"
      ],
      "title": "DataSourceCompletionStatus",
      "type": "string"
    },
    "DataSourceDataLevel": {
      "description": "Acquisition evidence level, kept separate from the source origin.",
      "enum": [
        "live_result",
        "recorded_response",
        "fixture",
        "seed"
      ],
      "title": "DataSourceDataLevel",
      "type": "string"
    },
    "SourceMode": {
      "description": "Actual origin of an ArtifactVersion-compatible pipeline payload.",
      "enum": [
        "fixture",
        "live",
        "cached"
      ],
      "title": "SourceMode",
      "type": "string"
    },
    "SupplementalDataQueryCursor": {
      "additionalProperties": false,
      "properties": {
        "pl_name": {
          "minLength": 1,
          "title": "Pl Name",
          "type": "string"
        },
        "pl_refname": {
          "minLength": 1,
          "title": "Pl Refname",
          "type": "string"
        }
      },
      "required": [
        "pl_name",
        "pl_refname"
      ],
      "title": "SupplementalDataQueryCursor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completion": {
      "$ref": "#/$defs/DataSourceCompletion"
    },
    "data_level": {
      "$ref": "#/$defs/DataSourceDataLevel"
    },
    "query_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Query Hash",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_mode": {
      "$ref": "#/$defs/SourceMode"
    },
    "source_snapshot_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Snapshot Content Hash",
      "type": "string"
    },
    "source_snapshot_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "source_mode",
    "data_level",
    "source_snapshot_id",
    "source_snapshot_content_hash",
    "source_id",
    "query_hash",
    "completion"
  ],
  "title": "CrossmatchAdmissionSourceContext",
  "type": "object"
}
