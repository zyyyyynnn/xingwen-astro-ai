{
  "additionalProperties": false,
  "properties": {
    "candidate_source_value_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Candidate Source Value Ids",
      "type": "array"
    },
    "canonical_field_id": {
      "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
      "title": "Canonical Field Id",
      "type": "string"
    },
    "conflict_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Conflict Ids",
      "type": "array"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "status": {
      "const": "unresolved",
      "default": "unresolved",
      "title": "Status",
      "type": "string"
    },
    "transformation_evidence_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Transformation Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "canonical_field_id",
    "reason",
    "candidate_source_value_ids",
    "transformation_evidence_ids",
    "conflict_ids"
  ],
  "title": "UnresolvedCanonicalValue",
  "type": "object"
}
