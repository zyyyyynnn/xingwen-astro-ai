{
  "$defs": {
    "ClaimType": {
      "enum": [
        "goal",
        "method",
        "dataset",
        "finding",
        "limitation",
        "future_work"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "LiteratureClaim": {
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "normalized_text": {
          "title": "Normalized Text",
          "type": "string"
        },
        "paper_id": {
          "title": "Paper Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "task_id",
        "paper_id",
        "claim_type",
        "text",
        "normalized_text",
        "evidence_ids",
        "confidence"
      ],
      "title": "LiteratureClaim",
      "type": "object"
    },
    "LiteratureRelation": {
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "reasoning_trace_id": {
          "title": "Reasoning Trace Id",
          "type": "string"
        },
        "relation_id": {
          "title": "Relation Id",
          "type": "string"
        },
        "relation_type": {
          "$ref": "#/$defs/LiteratureRelationType"
        },
        "source_claim_id": {
          "title": "Source Claim Id",
          "type": "string"
        },
        "target_claim_id": {
          "title": "Target Claim Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "relation_id",
        "task_id",
        "source_claim_id",
        "target_claim_id",
        "relation_type",
        "reasoning_trace_id",
        "evidence_ids",
        "confidence"
      ],
      "title": "LiteratureRelation",
      "type": "object"
    },
    "LiteratureRelationType": {
      "enum": [
        "supports",
        "extends",
        "derived_from",
        "limits",
        "contradicts",
        "uses_same_dataset",
        "compares_method"
      ],
      "title": "LiteratureRelationType",
      "type": "string"
    },
    "ReasoningTrace": {
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "model_name": {
          "title": "Model Name",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "relation_id": {
          "title": "Relation Id",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/TraceStep"
          },
          "title": "Steps",
          "type": "array"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "task_id",
        "relation_id",
        "steps",
        "evidence_ids",
        "model_name",
        "prompt_version"
      ],
      "title": "ReasoningTrace",
      "type": "object"
    },
    "TraceStep": {
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "order",
        "claim_id",
        "rationale"
      ],
      "title": "TraceStep",
      "type": "object"
    }
  },
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/LiteratureClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/LiteratureRelation"
      },
      "title": "Relations",
      "type": "array"
    },
    "traces": {
      "items": {
        "$ref": "#/$defs/ReasoningTrace"
      },
      "title": "Traces",
      "type": "array"
    }
  },
  "required": [
    "claims",
    "relations",
    "traces"
  ],
  "title": "LiteratureReasoningResponse",
  "type": "object"
}
