{
  "$defs": {
    "AlignmentStatus": {
      "enum": [
        "accepted",
        "review_required",
        "rejected",
        "conflict",
        "unmatched",
        "inconclusive"
      ],
      "title": "AlignmentStatus",
      "type": "string"
    },
    "CanonicalEntityIdentity": {
      "additionalProperties": false,
      "properties": {
        "entity_level": {
          "$ref": "#/$defs/EntityLevel"
        },
        "identity_values": {
          "items": {
            "$ref": "#/$defs/CanonicalEntityIdentityValue"
          },
          "minItems": 1,
          "title": "Identity Values",
          "type": "array"
        },
        "logical_assertion_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical Assertion Key"
        }
      },
      "required": [
        "entity_level",
        "identity_values"
      ],
      "title": "CanonicalEntityIdentity",
      "type": "object"
    },
    "CanonicalEntityIdentityValue": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
          "title": "Field Id",
          "type": "string"
        },
        "normalization_rule_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Normalization Rule Version",
          "type": "string"
        },
        "normalized_value": {
          "minLength": 1,
          "title": "Normalized Value",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "normalized_value",
        "normalization_rule_version"
      ],
      "title": "CanonicalEntityIdentityValue",
      "type": "object"
    },
    "CanonicalRowIdentity": {
      "additionalProperties": false,
      "properties": {
        "alignment_status": {
          "$ref": "#/$defs/AlignmentStatus"
        },
        "conflict_code": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Code"
        },
        "entity_level": {
          "$ref": "#/$defs/EntityLevel"
        },
        "identity_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Identity Version",
          "type": "string"
        },
        "member_entities": {
          "items": {
            "$ref": "#/$defs/CanonicalEntityIdentity"
          },
          "minItems": 1,
          "title": "Member Entities",
          "type": "array"
        },
        "record_type": {
          "enum": [
            "paired",
            "unpaired",
            "conflict_group"
          ],
          "title": "Record Type",
          "type": "string"
        }
      },
      "required": [
        "record_type",
        "entity_level",
        "alignment_status",
        "member_entities"
      ],
      "title": "CanonicalRowIdentity",
      "type": "object"
    },
    "DataQualityEvaluationRejected": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "dataset_result": {
          "default": null,
          "title": "Dataset Result",
          "type": "null"
        },
        "error_code": {
          "$ref": "#/$defs/QualityErrorCode"
        },
        "failure_stage": {
          "$ref": "#/$defs/QualityFailureStage"
        },
        "field_results": {
          "default": [],
          "maxItems": 0,
          "minItems": 0,
          "title": "Field Results",
          "type": "array"
        },
        "input_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Hash"
        },
        "kind": {
          "const": "data_quality_rejected",
          "default": "data_quality_rejected",
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "row_results": {
          "default": [],
          "maxItems": 0,
          "minItems": 0,
          "title": "Row Results",
          "type": "array"
        },
        "rule_set_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualityArtifactReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "failure_stage",
        "error_code",
        "message",
        "output_hash",
        "content_hash"
      ],
      "title": "DataQualityEvaluationRejected",
      "type": "object"
    },
    "DataQualityEvaluationResult": {
      "additionalProperties": false,
      "description": "Typed Data Quality Evaluation result; it is not a Core ``ArtifactKind``.",
      "properties": {
        "aggregate_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Aggregate Score"
        },
        "aggregate_score_policy": {
          "$ref": "#/$defs/QualityAggregateScorePolicy"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "contract_gate": {
          "$ref": "#/$defs/ResearchContractQualityGate"
        },
        "dataset_result": {
          "$ref": "#/$defs/DatasetQualityResult"
        },
        "evaluation_plan": {
          "$ref": "#/$defs/QualityEvaluationPlan"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "field_results": {
          "items": {
            "$ref": "#/$defs/FieldQualityResult"
          },
          "title": "Field Results",
          "type": "array"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "input_references": {
          "$ref": "#/$defs/QualityInputReferences"
        },
        "kind": {
          "const": "data_quality",
          "default": "data_quality",
          "title": "Kind",
          "type": "string"
        },
        "output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/QualityProducerReference"
        },
        "quality_rule_set_reference": {
          "$ref": "#/$defs/QualityArtifactReference"
        },
        "research_contract_reference": {
          "$ref": "#/$defs/QualityArtifactReference"
        },
        "result_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Result Id",
          "type": "string"
        },
        "row_results": {
          "items": {
            "$ref": "#/$defs/RowQualityResult"
          },
          "title": "Row Results",
          "type": "array"
        },
        "schema_version": {
          "const": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_snapshot_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "result_id",
        "input_references",
        "evaluation_plan",
        "quality_rule_set_reference",
        "research_contract_reference",
        "field_results",
        "row_results",
        "dataset_result",
        "contract_gate",
        "aggregate_score",
        "aggregate_score_policy",
        "source_snapshot_ids",
        "evidence_ids",
        "producer",
        "input_hash",
        "output_hash",
        "content_hash"
      ],
      "title": "DataQualityEvaluationResult",
      "type": "object"
    },
    "DatasetQualityResult": {
      "additionalProperties": false,
      "properties": {
        "applicable_cell_count": {
          "minimum": 0,
          "title": "Applicable Cell Count",
          "type": "integer"
        },
        "completeness": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "cross_source_conflict_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "declared_null_count": {
          "minimum": 0,
          "title": "Declared Null Count",
          "type": "integer"
        },
        "evidence_coverage": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "field_count": {
          "minimum": 0,
          "title": "Field Count",
          "type": "integer"
        },
        "field_result_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Field Result Ids",
          "type": "array"
        },
        "inconclusive_record_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "low_confidence_edge_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "mapped_count": {
          "minimum": 0,
          "title": "Mapped Count",
          "type": "integer"
        },
        "missingness": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "null_reason_distribution": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QualityCount"
          },
          "title": "Null Reason Distribution",
          "type": "array"
        },
        "object_match_coverage": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "provenance_coverage": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "raw_status_distribution": {
          "items": {
            "$ref": "#/$defs/QualityCount"
          },
          "title": "Raw Status Distribution",
          "type": "array"
        },
        "review_required_record_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "row_result_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Row Result Ids",
          "type": "array"
        },
        "same_source_conflict_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "source_scope_completeness": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "source_snapshot_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "unit_consistency": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "unresolved_count": {
          "minimum": 0,
          "title": "Unresolved Count",
          "type": "integer"
        },
        "unresolved_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "validation_integrity": {
          "$ref": "#/$defs/QualityMetricResult"
        }
      },
      "required": [
        "row_count",
        "field_count",
        "applicable_cell_count",
        "mapped_count",
        "declared_null_count",
        "unresolved_count",
        "completeness",
        "missingness",
        "unresolved_rate",
        "provenance_coverage",
        "evidence_coverage",
        "unit_consistency",
        "same_source_conflict_rate",
        "cross_source_conflict_rate",
        "object_match_coverage",
        "low_confidence_edge_rate",
        "review_required_record_rate",
        "inconclusive_record_rate",
        "source_scope_completeness",
        "validation_integrity",
        "field_result_ids",
        "row_result_ids",
        "source_snapshot_ids",
        "evidence_ids",
        "raw_status_distribution",
        "content_hash"
      ],
      "title": "DatasetQualityResult",
      "type": "object"
    },
    "EntityLevel": {
      "enum": [
        "host_star",
        "planet_candidate",
        "planet_assertion"
      ],
      "title": "EntityLevel",
      "type": "string"
    },
    "FieldQualityResult": {
      "additionalProperties": false,
      "properties": {
        "applicable_row_count": {
          "minimum": 0,
          "title": "Applicable Row Count",
          "type": "integer"
        },
        "completeness": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "cross_source_conflict_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "declared_null_count": {
          "minimum": 0,
          "title": "Declared Null Count",
          "type": "integer"
        },
        "evidence_coverage": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "field_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field Id",
          "type": "string"
        },
        "field_manifest_reference": {
          "$ref": "#/$defs/QualityManifestFieldReference"
        },
        "mapped_count": {
          "minimum": 0,
          "title": "Mapped Count",
          "type": "integer"
        },
        "missingness": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "null_reason_distribution": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QualityCount"
          },
          "title": "Null Reason Distribution",
          "type": "array"
        },
        "provenance_coverage": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "row_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Row Ids",
          "type": "array"
        },
        "rule_references": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Rule References",
          "type": "array"
        },
        "same_source_conflict_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "source_snapshot_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "unit_consistency": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "unresolved_count": {
          "minimum": 0,
          "title": "Unresolved Count",
          "type": "integer"
        },
        "unresolved_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        }
      },
      "required": [
        "field_id",
        "field_manifest_reference",
        "applicable_row_count",
        "mapped_count",
        "declared_null_count",
        "unresolved_count",
        "completeness",
        "missingness",
        "unresolved_rate",
        "provenance_coverage",
        "evidence_coverage",
        "unit_consistency",
        "same_source_conflict_rate",
        "cross_source_conflict_rate",
        "source_snapshot_ids",
        "evidence_ids",
        "row_ids",
        "rule_references",
        "content_hash"
      ],
      "title": "FieldQualityResult",
      "type": "object"
    },
    "QualityAggregateScorePolicy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "const": false,
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "score": {
          "default": null,
          "title": "Score",
          "type": "null"
        },
        "weights": {
          "default": [],
          "maxItems": 0,
          "minItems": 0,
          "title": "Weights",
          "type": "array"
        }
      },
      "title": "QualityAggregateScorePolicy",
      "type": "object"
    },
    "QualityArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "canonical_content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Content Hash"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "lineage_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lineage Hash"
        },
        "output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "candidate_id",
        "input_hash",
        "output_hash"
      ],
      "title": "QualityArtifactReference",
      "type": "object"
    },
    "QualityConstraintResult": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "input_locator": {
          "minLength": 1,
          "title": "Input Locator",
          "type": "string"
        },
        "metric_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualityMetricId"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_key": {
          "minLength": 1,
          "title": "Observation Key",
          "type": "string"
        },
        "observed_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualityMetricStatus"
            },
            {
              "const": "not_checked",
              "type": "string"
            }
          ],
          "title": "Observed Status"
        },
        "observed_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Value"
        },
        "operator": {
          "enum": [
            "gte",
            "equals"
          ],
          "title": "Operator",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/QualityGateStatus"
        },
        "rule_binding_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Rule Binding Version",
          "type": "string"
        },
        "source_field": {
          "minLength": 1,
          "title": "Source Field",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Threshold"
        }
      },
      "required": [
        "constraint_id",
        "source_field",
        "metric_id",
        "observation_key",
        "observed_status",
        "observed_value",
        "threshold",
        "operator",
        "result",
        "rule_binding_version",
        "input_locator"
      ],
      "title": "QualityConstraintResult",
      "type": "object"
    },
    "QualityCount": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "count"
      ],
      "title": "QualityCount",
      "type": "object"
    },
    "QualityErrorCode": {
      "enum": [
        "QUALITY_INPUT_INVALID",
        "QUALITY_DATA_ARTIFACT_CANDIDATE_MISMATCH",
        "QUALITY_CROSSMATCH_METRICS_MISMATCH",
        "QUALITY_RESEARCH_CONTRACT_MISMATCH",
        "QUALITY_RULE_SET_MISMATCH",
        "QUALITY_METRIC_FORMULA_INVALID",
        "QUALITY_METRIC_REFERENCE_INVALID",
        "QUALITY_SOURCE_SCOPE_INSUFFICIENT",
        "QUALITY_CONSTRAINT_FAILED",
        "QUALITY_CONSTRAINT_INSUFFICIENT",
        "QUALITY_RESULT_HASH_MISMATCH",
        "QUALITY_ADMISSION_NOT_SEALED",
        "QUALITY_CAPACITY_EXCEEDED"
      ],
      "title": "QualityErrorCode",
      "type": "string"
    },
    "QualityEvaluationPlan": {
      "additionalProperties": false,
      "description": "Immutable plan compiled from one frozen RuleSet.",
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "gate_bindings": {
          "items": {
            "$ref": "#/$defs/QualityGateBinding"
          },
          "minItems": 1,
          "title": "Gate Bindings",
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/QualityMetricPlan"
          },
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "precision_digits": {
          "exclusiveMinimum": 0,
          "maximum": 64,
          "title": "Precision Digits",
          "type": "integer"
        },
        "ratio_serialization": {
          "const": "plain_decimal_string_no_exponent",
          "title": "Ratio Serialization",
          "type": "string"
        },
        "rounding_mode": {
          "const": "ROUND_HALF_EVEN",
          "title": "Rounding Mode",
          "type": "string"
        },
        "rule_set_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Rule Set Content Hash",
          "type": "string"
        },
        "rule_set_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rule Set Id",
