{
  "$defs": {
    "ConflictResolutionStrategy": {
      "description": "The only Case and Field Manifest selection declaration approved for this case.",
      "enum": [
        "prefer_source_priority_preserve_all"
      ],
      "title": "ConflictResolutionStrategy",
      "type": "string"
    },
    "DataArtifactProducer": {
      "additionalProperties": false,
      "properties": {
        "conversion_catalog_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Conversion Catalog Content Hash",
          "type": "string"
        },
        "conversion_catalog_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Conversion Catalog Id",
          "type": "string"
        },
        "conversion_catalog_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Conversion Catalog Version",
          "type": "string"
        },
        "mapping_rule_set_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Mapping Rule Set Content Hash",
          "type": "string"
        },
        "mapping_rule_set_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Mapping Rule Set Id",
          "type": "string"
        },
        "mapping_rule_set_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Mapping Rule Set Version",
          "type": "string"
        },
        "producer_name": {
          "minLength": 1,
          "title": "Producer Name",
          "type": "string"
        },
        "producer_type": {
          "const": "algorithm",
          "default": "algorithm",
          "title": "Producer Type",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Producer Version",
          "type": "string"
        }
      },
      "required": [
        "producer_name",
        "producer_version",
        "mapping_rule_set_id",
        "mapping_rule_set_version",
        "mapping_rule_set_content_hash",
        "conversion_catalog_id",
        "conversion_catalog_version",
        "conversion_catalog_content_hash"
      ],
      "title": "DataArtifactProducer",
      "type": "object"
    },
    "DataType": {
      "description": "Canonical scalar types supported by the frozen case.",
      "enum": [
        "string",
        "integer",
        "number"
      ],
      "title": "DataType",
      "type": "string"
    },
    "DocumentAliasDeclaration": {
      "additionalProperties": false,
      "description": "Exact document label registered for one canonical field.",
      "properties": {
        "alias": {
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        }
      },
      "required": [
        "alias"
      ],
      "title": "DocumentAliasDeclaration",
      "type": "object"
    },
    "FieldDefinition": {
      "additionalProperties": false,
      "description": "The complete Case and Field Manifest contract for one canonical field.",
      "properties": {
        "canonical_unit": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Canonical Unit",
          "type": "string"
        },
        "conflict_resolution_rule_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Conflict Resolution Rule Version",
          "type": "string"
        },
        "conflict_resolution_strategy": {
          "$ref": "#/$defs/ConflictResolutionStrategy"
        },
        "crossmatch_key": {
          "title": "Crossmatch Key",
          "type": "boolean"
        },
        "crossmatch_rule_version": {
          "anyOf": [
            {
              "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crossmatch Rule Version"
        },
        "data_type": {
          "$ref": "#/$defs/DataType"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "document_aliases": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DocumentAliasDeclaration"
          },
          "title": "Document Aliases",
          "type": "array"
        },
        "evidence_locator_rule_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Evidence Locator Rule Id",
          "type": "string"
        },
        "field_id": {
          "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
          "title": "Field Id",
          "type": "string"
        },
        "label_en": {
          "minLength": 1,
          "title": "Label En",
          "type": "string"
        },
        "limit_policy": {
          "$ref": "#/$defs/LimitPolicy"
        },
        "meaning_zh": {
          "minLength": 1,
          "title": "Meaning Zh",
          "type": "string"
        },
        "null_policy": {
          "$ref": "#/$defs/NullPolicy"
        },
        "nullable": {
          "title": "Nullable",
          "type": "boolean"
        },
        "object_identity_key": {
          "title": "Object Identity Key",
          "type": "boolean"
        },
        "object_type": {
          "$ref": "#/$defs/ObjectType"
        },
        "quality_metric_inputs": {
          "items": {
            "$ref": "#/$defs/QualityMetricInput"
          },
          "minItems": 1,
          "title": "Quality Metric Inputs",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "source_aliases": {
          "items": {
            "$ref": "#/$defs/SourceAlias"
          },
          "minItems": 1,
          "title": "Source Aliases",
          "type": "array"
        },
        "source_priority": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Priority",
          "type": "array"
        },
        "transformation_rule_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Transformation Rule Version",
          "type": "string"
        },
        "uncertainty_policy": {
          "$ref": "#/$defs/UncertaintyPolicy"
        }
      },
      "required": [
        "field_id",
        "meaning_zh",
        "label_en",
        "description",
        "object_type",
        "data_type",
        "canonical_unit",
        "source_aliases",
        "source_priority",
        "conflict_resolution_strategy",
        "conflict_resolution_rule_version",
        "required",
        "nullable",
        "null_policy",
        "limit_policy",
        "uncertainty_policy",
        "object_identity_key",
        "crossmatch_key",
        "evidence_locator_rule_id",
        "transformation_rule_version",
        "quality_metric_inputs"
      ],
      "title": "FieldDefinition",
      "type": "object"
    },
    "LimitFlagMapping": {
      "additionalProperties": false,
      "description": "Source flag meanings for a bounded value.",
      "properties": {
        "lower_limit": {
          "default": 1,
          "title": "Lower Limit",
          "type": "integer"
        },
        "measured": {
          "default": 0,
          "title": "Measured",
          "type": "integer"
        },
        "upper_limit": {
          "default": -1,
          "title": "Upper Limit",
          "type": "integer"
        }
      },
      "title": "LimitFlagMapping",
      "type": "object"
    },
    "LimitPolicy": {
      "additionalProperties": false,
      "description": "Whether the field can carry upper or lower limit semantics.",
      "properties": {
        "lower_limit_supported": {
          "title": "Lower Limit Supported",
          "type": "boolean"
        },
        "rule_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Rule Version",
          "type": "string"
        },
        "upper_limit_supported": {
          "title": "Upper Limit Supported",
          "type": "boolean"
        }
      },
      "required": [
        "rule_version",
        "lower_limit_supported",
        "upper_limit_supported"
      ],
      "title": "LimitPolicy",
      "type": "object"
    },
    "ManifestPins": {
      "additionalProperties": false,
      "properties": {
        "case_manifest_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Case Manifest Content Hash",
          "type": "string"
        },
        "case_manifest_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Case Manifest Id",
          "type": "string"
        },
        "case_manifest_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Case Manifest Version",
          "type": "string"
        },
        "field_manifest_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Field Manifest Content Hash",
          "type": "string"
        },
        "field_manifest_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Field Manifest Id",
          "type": "string"
        },
        "field_manifest_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Field Manifest Version",
          "type": "string"
        }
      },
      "required": [
        "case_manifest_id",
        "case_manifest_version",
        "case_manifest_content_hash",
        "field_manifest_id",
        "field_manifest_version",
        "field_manifest_content_hash"
      ],
      "title": "ManifestPins",
      "type": "object"
    },
    "NullPolicy": {
      "additionalProperties": false,
      "description": "Nullability semantics for one canonical field.",
      "properties": {
        "allowed_reasons": {
          "items": {
            "$ref": "#/$defs/NullReason"
          },
          "title": "Allowed Reasons",
          "type": "array"
        },
        "reason_required_when_null": {
          "title": "Reason Required When Null",
          "type": "boolean"
        }
      },
      "required": [
        "reason_required_when_null",
        "allowed_reasons"
      ],
      "title": "NullPolicy",
      "type": "object"
    },
    "NullReason": {
      "description": "Controlled reasons for a nullable scientific value.",
      "enum": [
        "not_in_source",
        "not_measured",
        "not_applicable",
        "unresolved_conflict",
        "below_detection_limit"
      ],
      "title": "NullReason",
      "type": "string"
    },
    "ObjectType": {
      "description": "Objects represented by the exoplanet/host-star case.",
      "enum": [
        "planet",
        "star",
        "system"
      ],
      "title": "ObjectType",
      "type": "string"
    },
    "QualityMetricInput": {
      "description": "Quality dimensions to which a field contributes.",
      "enum": [
        "completeness",
        "missingness",
        "conflict",
        "unit_consistency",
        "evidence_coverage",
        "crossmatch_coverage"
      ],
      "title": "QualityMetricInput",
      "type": "string"
    },
    "SourceAlias": {
      "additionalProperties": false,
      "description": "A source column mapped to one canonical field.",
      "properties": {
        "conversion_rule_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Conversion Rule Id",
          "type": "string"
        },
        "limit_field": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Field"
        },
        "limit_flags": {
          "anyOf": [
            {
              "$ref": "#/$defs/LimitFlagMapping"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "negative_error_field": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Negative Error Field"
        },
        "positive_error_field": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Positive Error Field"
        },
        "priority": {
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "provenance_field": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance Field"
        },
        "raw_field": {
          "minLength": 1,
          "title": "Raw Field",
          "type": "string"
        },
        "reference_field": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Field"
        },
        "row_key_fields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Row Key Fields",
          "type": "array"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_table": {
          "minLength": 1,
          "title": "Source Table",
          "type": "string"
        },
        "source_unit": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Unit",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_table",
        "raw_field",
        "source_unit",
        "conversion_rule_id",
        "priority",
        "row_key_fields"
      ],
      "title": "SourceAlias",
      "type": "object"
    },
    "UncertaintyMode": {
      "description": "How source uncertainty columns are declared, not evaluated.",
      "enum": [
        "not_applicable",
        "asymmetric_source_errors"
      ],
      "title": "UncertaintyMode",
      "type": "string"
    },
    "UncertaintyPolicy": {
      "additionalProperties": false,
      "description": "Hashed declaration for preserving source uncertainties.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/UncertaintyMode"
        },
        "preserve_asymmetric_errors": {
          "title": "Preserve Asymmetric Errors",
          "type": "boolean"
        },
        "rule_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Rule Version",
          "type": "string"
        }
      },
      "required": [
        "rule_version",
        "mode",
        "preserve_asymmetric_errors"
      ],
      "title": "UncertaintyPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Candidate Id",
      "type": "string"
    },
    "conversion_catalog_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Conversion Catalog Content Hash",
      "type": "string"
    },
    "conversion_catalog_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Conversion Catalog Id",
      "type": "string"
    },
    "conversion_catalog_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Conversion Catalog Version",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "field_definitions": {
      "items": {
        "$ref": "#/$defs/FieldDefinition"
      },
      "title": "Field Definitions",
      "type": "array"
    },
    "input_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "kind": {
      "const": "field_dictionary",
      "default": "field_dictionary",
      "title": "Kind",
      "type": "string"
    },
    "manifest_pins": {
      "$ref": "#/$defs/ManifestPins"
    },
    "mapping_rule_set_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Mapping Rule Set Content Hash",
      "type": "string"
    },
    "mapping_rule_set_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Mapping Rule Set Id",
      "type": "string"
    },
    "mapping_rule_set_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Mapping Rule Set Version",
      "type": "string"
    },
    "output_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Output Hash",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/DataArtifactProducer"
    },
    "quality_evaluation_status": {
      "const": "not_evaluated",
      "default": "not_evaluated",
      "title": "Quality Evaluation Status",
      "type": "string"
    },
    "requested_fields": {
      "items": {
        "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Requested Fields",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_snapshot_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Source Snapshot Ids",
      "type": "array"
    }
  },
  "required": [
    "candidate_id",
    "manifest_pins",
    "requested_fields",
    "field_definitions",
    "source_snapshot_ids",
    "evidence_ids",
    "mapping_rule_set_id",
    "mapping_rule_set_version",
    "mapping_rule_set_content_hash",
    "conversion_catalog_id",
    "conversion_catalog_version",
    "conversion_catalog_content_hash",
    "producer",
    "input_hash",
    "output_hash"
  ],
  "title": "FieldDictionaryArtifactCandidate",
  "type": "object"
}
