{
  "$defs": {
    "PaperItem": {
      "properties": {
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "paper_id": {
          "title": "Paper Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaperSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "required": [
        "paper_id",
        "candidate_id",
        "task_id",
        "title",
        "authors",
        "source_ids"
      ],
      "title": "PaperItem",
      "type": "object"
    },
    "PaperSummary": {
      "properties": {
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "findings": {
          "items": {
            "type": "string"
          },
          "title": "Findings",
          "type": "array"
        },
        "future_work": {
          "items": {
            "type": "string"
          },
          "title": "Future Work",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "model_name": {
          "title": "Model Name",
          "type": "string"
        },
        "paper_id": {
          "title": "Paper Id",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "research_goal": {
          "title": "Research Goal",
          "type": "string"
        }
      },
      "required": [
        "id",
        "paper_id",
        "research_goal",
        "method",
        "dataset",
        "findings",
        "limitations",
        "future_work",
        "evidence_ids",
        "model_name",
        "prompt_version"
      ],
      "title": "PaperSummary",
      "type": "object"
    }
  },
  "properties": {
    "papers": {
      "items": {
        "$ref": "#/$defs/PaperItem"
      },
      "title": "Papers",
      "type": "array"
    }
  },
  "required": [
    "papers"
  ],
  "title": "PapersResponse",
  "type": "object"
}
