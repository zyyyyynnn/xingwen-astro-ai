# App
# development：本地默认；integration/test：挂载 test-only bootstrap（仅真实 Compose/Browser 集成使用）；
# production：启用全部安全校验，禁止默认凭据。
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 本地 HTTP 默认关闭；production 配置必须显式设为 true。
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400
SESSION_CREATE_RATE_LIMIT=30
SHARE_CREATE_RATE_LIMIT=20
CURSOR_SIGNING_KEY=development-only-cursor-signing-key

# Local service ports
SITE_PORT=4321
WORKSPACE_PORT=5173
API_PORT=8000
POSTGRES_PORT=5432

# Frontend
# PUBLIC_* 与 VITE_* 会进入浏览器输出，只能包含非敏感配置。
PUBLIC_WORKSPACE_URL=http://localhost:5173/workspace
# 仅为 API origin，不得预带 /api 路径；路径来自生成的 operation metadata。
VITE_API_BASE_URL=http://localhost:8000
VITE_SITE_URL=http://localhost:4321

# Database
# 本地占位值仅用于 Docker Compose；production 必须覆盖且禁止使用 postgres 默认密码。
POSTGRES_DB=xingwen_astro_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/xingwen_astro_ai
# 后端 PostgreSQL 集成测试使用的隔离数据库，库名必须包含 test。
# 不设时 PostgreSQL 门控测试按设计 skip；CI backend job 已配置。
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/xingwen_test_db

# Research assistant (server-only; never expose these values through PUBLIC_* or VITE_*).
# Use the official environment name documented by the Qwen AI Platform.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
DASHSCOPE_MODEL_REVISION=qwen3.7-plus-2026-05-26
DASHSCOPE_TIMEOUT_SECONDS=45

# PostgreSQL-backed Live Run queue and worker capacity. Project bounds must not
# exceed their global bounds; one worker cannot exceed global active capacity.
WORKFLOW_MAX_QUEUED_GLOBAL=64
WORKFLOW_MAX_QUEUED_PER_PROJECT=8
WORKFLOW_MAX_NONTERMINAL_GLOBAL=128
WORKFLOW_MAX_NONTERMINAL_PER_PROJECT=16
WORKFLOW_MAX_ACTIVE_GLOBAL=4
WORKFLOW_MAX_ACTIVE_PER_PROJECT=2
WORKFLOW_WORKER_CAPACITY=2
WORKFLOW_QUEUE_TIMEOUT_SECONDS=900
WORKFLOW_QUEUE_RETRY_AFTER_SECONDS=5
# Optional stable deployment identity; empty lets each process generate one.
WORKFLOW_WORKER_ID=

# Research Input ingestion
RESEARCH_INPUT_MAX_SIZE_BYTES=26214400
RESEARCH_INPUT_ALLOWED_MIME_TYPES=application/pdf,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.apache.parquet,application/json,application/fits,application/zip,image/png,image/jpeg,image/webp,image/gif,text/plain,text/markdown,text/x-markdown
RESEARCH_INPUT_UPLOAD_DIR=.data/research-inputs
RESEARCH_INPUT_RATE_LIMIT=30
# Idempotency 预留的租约窗口必须大于 URL fetch 的最大超时预算。
RESEARCH_INPUT_IDEMPOTENCY_LEASE_SECONDS=300
# image_dataset 是 Project-owned 训练输入：ZIP 根级 labels.json + allowlist 图片。
IMAGE_DATASET_MAX_ARCHIVE_MEMBERS=512
IMAGE_DATASET_MAX_UNCOMPRESSED_BYTES=67108864
IMAGE_DATASET_MAX_COMPRESSION_RATIO=100
IMAGE_DATASET_MAX_IMAGE_BYTES=8388608
IMAGE_DATASET_MAX_IMAGE_DIMENSION=4096
IMAGE_DATASET_MAX_TOTAL_PIXELS=16000000
IMAGE_DATASET_MAX_IMAGES=256
IMAGE_DATASET_MAX_CLASSES=32
IMAGE_DATASET_MIN_SAMPLES_PER_CLASS=2
# URL 抓取默认 fail closed：只允许 HTTPS，空 host allowlist 拒绝所有外部抓取。
URL_FETCH_ALLOWED_PROTOCOLS=https
URL_FETCH_ALLOWED_HOSTS=
URL_FETCH_TIMEOUT_SECONDS=15
URL_FETCH_MAX_REDIRECTS=3
URL_FETCH_MAX_RESPONSE_BYTES=26214400
