            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Condition Conflicts",
          "type": "array"
        },
        "condition_uncertainties": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Condition Uncertainties",
          "type": "array"
        },
        "conditions": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiteratureRelationConfidenceAssessment"
