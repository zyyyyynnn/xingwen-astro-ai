{
  "$defs": {
    "LiteratureClaimArtifactVersionReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_version_id": {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Artifact Version Id",
          "type": "string"
        },
        "claim_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "output_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "paper_summary_artifact_version_ids": {
          "default": [],
          "items": {
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Paper Summary Artifact Version Ids",
          "type": "array"
        },
        "project_id": {
          "anyOf": [
            {
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "schema_version": {
          "anyOf": [
            {
              "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Version"
        },
        "source_snapshot_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        }
      },
      "required": [
        "artifact_version_id"
      ],
      "title": "LiteratureClaimArtifactVersionReference",
      "type": "object"
    },
    "LiteratureRelationInputVersions": {
      "additionalProperties": false,
      "properties": {
        "claim_artifact_versions": {
          "items": {
            "$ref": "#/$defs/LiteratureClaimArtifactVersionReference"
          },
          "minItems": 1,
          "title": "Claim Artifact Versions",
          "type": "array"
        },
        "project_id": {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "claim_artifact_versions"
      ],
      "title": "LiteratureRelationInputVersions",
      "type": "object"
    },
    "LiteratureRelationRejectionReason": {
      "enum": [
        "literature_relation.json_invalid",
        "literature_relation.schema_invalid",
        "literature_relation.input_artifact_version_unknown",
        "literature_relation.input_schema_version_unsupported",
        "literature_relation.input_content_hash_mismatch",
        "literature_relation.claim_not_found",
        "literature_relation.paper_summary_artifact_version_unknown",
        "literature_relation.claim_status_invalid",
        "literature_relation.evidence_missing",
        "literature_relation.evidence_not_found",
        "literature_relation.source_snapshot_not_found",
        "literature_relation.evidence_inconsistent",
        "literature_relation.ownership_mismatch",
        "literature_relation.self_pair",
        "literature_relation.direction_mismatch",
        "literature_relation.duplicate",
        "literature_relation.conditions_missing",
        "literature_relation.conditions_conflict",
        "literature_relation.object_incomparable",
        "literature_relation.metric_incomparable",
        "literature_relation.unit_incomparable",
        "literature_relation.trace_missing",
        "literature_relation.trace_incomplete",
        "literature_relation.trace_unsafe",
        "literature_relation.trace_direction_mismatch",
        "literature_relation.trace_evidence_incomplete",
        "literature_relation.confidence_undefined",
        "literature_relation.confidence_definition_unsupported",
        "literature_relation.confidence_subject_mismatch",
        "literature_relation.confidence_decision_mismatch",
        "literature_relation.confidence_calibration_missing"
      ],
      "title": "LiteratureRelationRejectionReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "comparison_policy_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Comparison Policy Version",
      "type": "string"
    },
    "confidence_acceptance_threshold": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence Acceptance Threshold",
      "type": "number"
    },
    "confidence_applicability_scope": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Confidence Applicability Scope",
      "type": "string"
    },
    "confidence_calibration_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Confidence Calibration Content Hash",
      "type": "string"
    },
    "confidence_calibration_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Confidence Calibration Id",
      "type": "string"
    },
    "confidence_calibration_method": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Confidence Calibration Method",
      "type": "string"
    },
    "confidence_calibration_sample_size": {
      "minimum": 1,
      "title": "Confidence Calibration Sample Size",
      "type": "integer"
    },
    "confidence_calibration_scientific_payload_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Confidence Calibration Scientific Payload Hash",
      "type": "string"
    },
    "confidence_calibration_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Confidence Calibration Version",
      "type": "string"
    },
    "confidence_definition_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Confidence Definition Id",
      "type": "string"
    },
    "confidence_definition_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Confidence Definition Version",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/LiteratureRelationRejectionReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Execution Id",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "input_versions": {
      "$ref": "#/$defs/LiteratureRelationInputVersions"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "model_name": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Model Name",
      "type": "string"
    },
    "model_response_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Model Response Hash",
      "type": "string"
    },
    "output_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Output Hash",
      "type": "string"
    },
    "pairing_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Pairing Version",
      "type": "string"
    },
    "parameters_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Parameters Hash",
      "type": "string"
    },
    "parameters_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Parameters Version",
      "type": "string"
    },
    "producer_name": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Producer Name",
      "type": "string"
    },
    "producer_type": {
      "const": "model",
      "default": "model",
      "title": "Producer Type",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Producer Version",
      "type": "string"
    },
    "prompt_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Prompt Hash",
      "type": "string"
    },
    "prompt_name": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Prompt Name",
      "type": "string"
    },
    "prompt_version": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "step_key": {
      "const": "reasoning_literature",
      "default": "reasoning_literature",
      "title": "Step Key",
      "type": "string"
    },
    "trace_protocol_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Trace Protocol Version",
      "type": "string"
    }
  },
  "required": [
    "execution_id",
    "producer_name",
    "producer_version",
    "model_name",
    "prompt_name",
    "prompt_version",
    "prompt_hash",
    "schema_version",
    "parameters_version",
    "parameters_hash",
    "pairing_version",
    "comparison_policy_version",
    "trace_protocol_version",
    "confidence_definition_id",
    "confidence_definition_version",
    "confidence_calibration_id",
    "confidence_calibration_version",
    "confidence_calibration_scientific_payload_hash",
    "confidence_calibration_content_hash",
    "confidence_calibration_sample_size",
    "confidence_calibration_method",
    "confidence_applicability_scope",
    "confidence_acceptance_threshold",
    "input_versions",
    "input_hash",
    "model_response_hash",
    "output_hash",
    "status",
    "started_at",
    "finished_at",
    "latency_ms"
  ],
  "title": "LiteratureRelationProducerExecution",
  "type": "object"
}
