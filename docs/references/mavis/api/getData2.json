    {
        "id":"2",
        "作用": "获取FITS图像数据，可获取静态的FITS图像数据（注意，静态的FITS图像数据和WWT中的图像数据保持一致，意思获取这里的静态FITS数据，相当于获取WWT中的FITS数据）和动态的FITS数据(即变星FITS数据)",
        "可用工具":
        [
            {
                "sub_id":"1",
                "工具名":"getFits",
                "导入模块":"无",
                "作用":"获取WWT Scope中的静态的FITS数据，即对于某个目标，只能获取单张的静态FITS数据，这类FITS数据是没有指定时间的，静态的，一般获取该数据来做图像处理分析",
                "输入参数":
                {
                    "ra":"输入赤经，浮点数",
                    "dec":"输入赤纬，浮点数",
                    "server":"合适的观测望远镜，字符串，默认为'DSS'",
                    "height":"输入FITS图的高度，浮点数，默认为0.5",
                    "width":"输入FITS图的宽度，浮点数，默认为0.5"
                },
                "输出参数":
                {
                    "":"本地地址，FITS文件所在的地址"
                }
            },
            {
                "sub_id":"2",
                "工具名":"get_lc_fits",
                "导入模块":"无",
                "作用":"获取光变曲线的FITS图像观测数据，即获取一个目标，它在一段时间内的动态的多张FITS数据，这里的多张FITS数据是带时间的，输入同一目标，即同一赤经赤纬下的多张FITS数据",
                "输入参数":
                {
                    "ra":"输入赤经，浮点数",
                    "dec":"输入赤纬，浮点数",
                    "server":"合适的观测望远镜，字符串，默认为'DSS'",
                    "height":"输入FITS图的高度，浮点数，默认为0.5",
                    "width":"输入FITS图的宽度，浮点数，默认为0.5"
                },
                "输出参数":
                {
                    "":"本地地址，FITS文件所在的地址列表"
                }
            },
            {
                "sub_id":"3",
                "工具名":"getFitsMessage",
                "导入模块":"无",
                "作用":"获取FITS图像数据里面的信息，主要获取FITS中的2D图像数据和头文件",
                "输入参数":
                {
                    "ra":"输入赤经，浮点数",
                    "dec":"输入赤纬，浮点数",
                    "server":"合适的观测望远镜，字符串，默认为'DSS'",
                    "height":"输入FITS图的高度，浮点数，默认为0.5",
                    "width":"输入FITS图的宽度，浮点数，默认为0.5"
                },
                "输出参数":
                {
                    "":"本地地址，FITS文件所在的地址"
                }
            }
        ]

    },
