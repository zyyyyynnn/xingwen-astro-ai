{
  "$defs": {
    "PaperCandidateConflict": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "conflict",
            "uncertain_match"
          ],
          "title": "Classification",
          "type": "string"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "field": {
          "enum": [
            "doi",
            "arxiv_id",
            "title",
            "year",
            "authors"
          ],
          "title": "Field",
          "type": "string"
        },
        "related_candidate_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Related Candidate Id",
          "type": "string"
        }
      },
      "required": [
        "field",
        "related_candidate_id",
        "classification",
        "detail"
      ],
      "title": "PaperCandidateConflict",
      "type": "object"
    },
    "RawPaperCandidate": {
      "additionalProperties": false,
      "properties": {
        "arxiv_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arxiv Id"
        },
        "authors": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "record_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Record Hash",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_record_id": {
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "source_snapshot_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "synthetic_note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synthetic Note"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "required": [
        "source_id",
        "source_record_id",
        "source_snapshot_id",
        "title",
        "record_hash"
      ],
      "title": "RawPaperCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "arxiv_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arxiv Id"
    },
    "authors": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Authors",
      "type": "array"
    },
    "candidate_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Candidate Id",
      "type": "string"
    },
    "canonical_identity_basis": {
      "enum": [
        "doi",
        "arxiv_id",
        "title_year_authors",
        "source_record"
      ],
      "title": "Canonical Identity Basis",
      "type": "string"
    },
    "canonical_paper_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Canonical Paper Id",
      "type": "string"
    },
    "conflicts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PaperCandidateConflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "dedupe_evidence": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Dedupe Evidence",
      "type": "array"
    },
    "doi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "duplicate_group_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Duplicate Group Id",
      "type": "string"
    },
    "exclusion_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exclusion Reason"
    },
    "normalized_authors": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Normalized Authors",
      "type": "array"
    },
    "normalized_title": {
      "minLength": 1,
      "title": "Normalized Title",
      "type": "string"
    },
    "ranking_key": {
      "minLength": 1,
      "title": "Ranking Key",
      "type": "string"
    },
    "ranking_rule_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Ranking Rule Version",
      "type": "string"
    },
    "raw": {
      "$ref": "#/$defs/RawPaperCandidate"
    },
    "relevance_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Relevance Score",
      "type": "number"
    },
    "selected": {
      "title": "Selected",
      "type": "boolean"
    },
    "selection_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selection Reason"
    },
    "selection_rule_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Selection Rule Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "year": {
      "anyOf": [
        {
          "maximum": 2100,
          "minimum": 1900,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Year"
    }
  },
  "required": [
    "candidate_id",
    "raw",
    "canonical_paper_id",
    "canonical_identity_basis",
    "title",
    "normalized_title",
    "duplicate_group_id",
    "relevance_score",
    "ranking_key",
    "selected",
    "ranking_rule_version",
    "selection_rule_version"
  ],
  "title": "PaperCollectionCandidate",
  "type": "object"
}
