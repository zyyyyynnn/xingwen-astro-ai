{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "dataset",
        "field_dictionary",
        "source_collection",
        "analysis_report",
        "visualization",
        "spectrum",
        "light_curve",
        "model_evaluation",
        "model_artifact",
        "paper_collection",
        "paper_summary",
        "literature_claims",
        "literature_relations",
        "reasoning_traces",
        "graph",
        "export"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ContractDraftStatus": {
      "enum": [
        "draft",
        "confirmed",
        "expired"
      ],
      "title": "ContractDraftStatus",
      "type": "string"
    },
    "DataRequirements": {
      "additionalProperties": false,
      "properties": {
        "unit_policy": {
          "$ref": "#/$defs/UnitPolicy",
          "default": "canonical"
        }
      },
      "title": "DataRequirements",
      "type": "object"
    },
    "EvidenceRequirements": {
      "additionalProperties": false,
      "properties": {
        "minimum_coverage": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Coverage",
          "type": "number"
        },
        "require_locator": {
          "default": true,
          "title": "Require Locator",
          "type": "boolean"
        },
        "require_source_snapshot": {
          "default": true,
          "title": "Require Source Snapshot",
          "type": "boolean"
        }
      },
      "title": "EvidenceRequirements",
      "type": "object"
    },
    "JsonValue": {},
    "PaperSearchScope": {
      "additionalProperties": false,
      "properties": {
        "keywords": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "max_candidates": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Candidates",
          "type": "integer"
        },
        "source_ids": {
          "default": [
            "crossref"
          ],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "year_from": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year From"
        },
        "year_to": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year To"
        }
      },
      "title": "PaperSearchScope",
      "type": "object"
    },
    "QualityConstraints": {
      "additionalProperties": false,
      "properties": {
        "source_completeness_min": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Source Completeness Min",
          "type": "number"
        },
        "unit_consistency_min": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Unit Consistency Min",
          "type": "number"
        }
      },
      "title": "QualityConstraints",
      "type": "object"
    },
    "ResearchContractInput": {
      "additionalProperties": false,
      "description": "Shared scientific payload for an editable draft and immutable contract.",
      "properties": {
        "data_requirements": {
          "$ref": "#/$defs/DataRequirements"
        },
        "evidence_requirements": {
          "$ref": "#/$defs/EvidenceRequirements"
        },
        "output_requirements": {
          "items": {
            "$ref": "#/$defs/ArtifactKind"
          },
          "minItems": 1,
          "title": "Output Requirements",
          "type": "array"
        },
        "paper_search_scope": {
          "$ref": "#/$defs/PaperSearchScope"
        },
        "quality_constraints": {
          "$ref": "#/$defs/QualityConstraints"
        },
        "requested_fields": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Requested Fields",
          "type": "array"
        },
        "research_goal": {
          "maxLength": 500,
          "minLength": 4,
          "title": "Research Goal",
          "type": "string"
        },
        "scientific_tasks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScientificTaskInput"
          },
          "title": "Scientific Tasks",
          "type": "array"
        },
        "source_scope": {
          "$ref": "#/$defs/SourceScope"
        },
        "target_objects": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Objects",
          "type": "array"
        }
      },
      "required": [
        "research_goal",
        "target_objects",
        "data_requirements",
        "requested_fields",
        "source_scope",
        "paper_search_scope",
        "output_requirements",
        "evidence_requirements",
        "quality_constraints"
      ],
      "title": "ResearchContractInput",
      "type": "object"
    },
    "ScientificSkillId": {
      "enum": [
        "catalog_crossmatch",
        "data_profile",
        "statistical_analysis",
        "correlation_analysis",
        "clustering_analysis",
        "anomaly_detection",
        "chart_visualization",
        "simbad_lookup",
        "skyview_fits",
        "ephemeris",
        "celestial_events",
        "gaia_cone_search",
        "vizier_tap",
        "fits_image_analysis",
        "spectrum_analysis",
        "spectrum_acquisition",
        "light_curve_analysis",
        "light_curve_acquisition",
        "tabular_machine_learning",
        "time_series_classification",
        "time_series_forecast",
        "image_classification",
        "model_inference",
        "wwt_scene"
      ],
      "title": "ScientificSkillId",
      "type": "string"
    },
    "ScientificTaskInput": {
      "additionalProperties": false,
      "description": "One bounded invocation of a registered scientific skill.",
      "properties": {
        "input_refs": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Parameters",
          "type": "object"
        },
        "skill_id": {
          "$ref": "#/$defs/ScientificSkillId"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "skill_id"
      ],
      "title": "ScientificTaskInput",
      "type": "object"
    },
    "SourceScope": {
      "additionalProperties": false,
      "properties": {
        "allowed_sources": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Sources",
          "type": "array"
        }
      },
      "required": [
        "allowed_sources"
      ],
      "title": "SourceScope",
      "type": "object"
    },
    "UnitPolicy": {
      "enum": [
        "canonical"
      ],
      "title": "UnitPolicy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "contract": {
        "data_requirements": {
          "unit_policy": "canonical"
        },
        "evidence_requirements": {},
        "output_requirements": [
          "dataset",
          "graph"
        ],
        "paper_search_scope": {
          "max_candidates": 20
        },
        "quality_constraints": {},
        "requested_fields": [
          "planet.toi_id",
          "star.tic_id"
        ],
        "research_goal": "Integrate exoplanet candidates and host-star parameters",
        "source_scope": {
          "allowed_sources": [
            "nasa_exoplanet_archive"
          ]
        },
        "target_objects": [
          "exoplanet_candidate",
          "host_star"
        ]
      },
      "created_at": "2026-07-21T08:00:00Z",
      "expires_at": "2026-07-21T09:00:00Z",
      "id": "rcd_01JEXAMPLE",
      "intent": "Integrate exoplanet candidates and host-star parameters",
      "project_id": "proj_01JEXAMPLE",
      "session_id": "sess_01JEXAMPLE",
      "status": "draft",
      "updated_at": "2026-07-21T08:00:00Z",
      "version": 1,
      "warnings": []
    }
  ],
  "properties": {
    "contract": {
      "$ref": "#/$defs/ResearchContractInput"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "intent": {
      "minLength": 1,
      "title": "Intent",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ContractDraftStatus",
      "default": "draft"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "id",
    "project_id",
    "session_id",
    "version",
    "intent",
    "contract",
    "created_at",
    "updated_at",
    "expires_at"
  ],
  "title": "ResearchContractDraft",
  "type": "object"
}
