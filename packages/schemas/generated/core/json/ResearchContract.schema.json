{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "dataset",
        "field_dictionary",
        "source_collection",
        "analysis_report",
        "visualization",
        "spectrum",
        "light_curve",
        "model_evaluation",
        "model_artifact",
        "paper_collection",
        "paper_summary",
        "literature_claims",
        "literature_relations",
        "graph",
        "export"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "DataRequirements": {
      "additionalProperties": false,
      "properties": {
        "document_source_policy": {
          "$ref": "#/$defs/DocumentSourcePolicy"
        },
        "unit_policy": {
          "$ref": "#/$defs/UnitPolicy"
        }
      },
      "required": [
        "unit_policy",
        "document_source_policy"
      ],
      "title": "DataRequirements",
      "type": "object"
    },
    "DocumentSourcePolicy": {
      "description": "Whether document-derived scientific values may enter the Dataset.",
      "enum": [
        "disabled",
        "research_input"
      ],
      "title": "DocumentSourcePolicy",
      "type": "string"
    },
    "EvidenceRequirements": {
      "additionalProperties": false,
      "properties": {
        "minimum_coverage": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Coverage",
          "type": "number"
        },
        "require_locator": {
          "default": true,
          "title": "Require Locator",
          "type": "boolean"
        },
        "require_source_snapshot": {
          "default": true,
          "title": "Require Source Snapshot",
          "type": "boolean"
        }
      },
      "title": "EvidenceRequirements",
      "type": "object"
    },
    "JsonValue": {},
    "PaperSearchScope": {
      "additionalProperties": false,
      "properties": {
        "keywords": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "max_candidates": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Candidates",
          "type": "integer"
        },
        "source_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "year_from": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year From"
        },
        "year_to": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year To"
        }
      },
      "title": "PaperSearchScope",
      "type": "object"
    },
    "QualityConstraints": {
      "additionalProperties": false,
      "properties": {
        "source_completeness_min": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Source Completeness Min",
          "type": "number"
        },
        "unit_consistency_min": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Unit Consistency Min",
          "type": "number"
        }
      },
      "title": "QualityConstraints",
      "type": "object"
    },
    "ScientificSkillId": {
      "enum": [
        "catalog_crossmatch",
        "data_profile",
        "statistical_analysis",
        "correlation_analysis",
        "clustering_analysis",
        "anomaly_detection",
        "chart_visualization",
        "simbad_lookup",
        "skyview_fits",
        "ephemeris",
        "celestial_events",
        "gaia_cone_search",
        "vizier_tap",
        "fits_image_analysis",
        "spectrum_analysis",
        "spectrum_acquisition",
        "light_curve_analysis",
        "light_curve_acquisition",
        "tabular_machine_learning",
        "time_series_classification",
        "time_series_forecast",
        "image_classification",
        "model_inference",
        "wwt_scene"
      ],
      "title": "ScientificSkillId",
      "type": "string"
    },
    "ScientificTaskInput": {
      "additionalProperties": false,
      "description": "One bounded invocation of a registered scientific skill.",
      "properties": {
        "input_refs": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Parameters",
          "type": "object"
        },
        "skill_id": {
          "$ref": "#/$defs/ScientificSkillId"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "skill_id"
      ],
      "title": "ScientificTaskInput",
      "type": "object"
    },
    "SourceScope": {
      "additionalProperties": false,
      "properties": {
        "allowed_sources": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Sources",
          "type": "array"
        }
      },
      "required": [
        "allowed_sources"
      ],
      "title": "SourceScope",
      "type": "object"
    },
    "UnitPolicy": {
      "enum": [
        "canonical"
      ],
      "title": "UnitPolicy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "content_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "created_at": "2026-07-21T08:00:00Z",
      "created_from_draft_id": "rcd_01JEXAMPLE",
      "data_requirements": {
        "document_source_policy": "disabled",
        "unit_policy": "canonical"
      },
      "evidence_requirements": {},
      "id": "rc_01JEXAMPLE",
      "output_requirements": [
        "dataset",
        "graph"
      ],
      "paper_search_scope": {
        "max_candidates": 20
      },
      "project_id": "proj_01JEXAMPLE",
      "quality_constraints": {},
      "requested_fields": [
        "planet.toi_id",
        "star.tic_id"
      ],
      "research_goal": "Integrate exoplanet candidates and host-star parameters",
      "source_scope": {
        "allowed_sources": [
          "nasa_exoplanet_archive"
        ]
      },
      "target_objects": [
        "exoplanet_candidate",
        "host_star"
      ],
      "version": 1
    }
  ],
  "properties": {
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_from_draft_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Created From Draft Id",
      "type": "string"
    },
    "data_requirements": {
      "$ref": "#/$defs/DataRequirements"
    },
    "evidence_requirements": {
      "$ref": "#/$defs/EvidenceRequirements"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "output_requirements": {
      "items": {
        "$ref": "#/$defs/ArtifactKind"
      },
      "minItems": 1,
      "title": "Output Requirements",
      "type": "array"
    },
    "paper_search_scope": {
      "$ref": "#/$defs/PaperSearchScope"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "quality_constraints": {
      "$ref": "#/$defs/QualityConstraints"
    },
    "requested_fields": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Requested Fields",
      "type": "array"
    },
    "research_goal": {
      "maxLength": 500,
      "minLength": 4,
      "title": "Research Goal",
      "type": "string"
    },
    "scientific_tasks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ScientificTaskInput"
      },
      "title": "Scientific Tasks",
      "type": "array"
    },
    "source_scope": {
      "$ref": "#/$defs/SourceScope"
    },
    "target_objects": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Target Objects",
      "type": "array"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "research_goal",
    "target_objects",
    "data_requirements",
    "requested_fields",
    "source_scope",
    "paper_search_scope",
    "output_requirements",
    "evidence_requirements",
    "quality_constraints",
    "id",
    "project_id",
    "version",
    "created_from_draft_id",
    "created_at",
    "content_hash"
  ],
  "title": "ResearchContract",
  "type": "object"
}
