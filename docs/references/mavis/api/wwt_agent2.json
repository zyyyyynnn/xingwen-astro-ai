[
    {
        "id": "1",
        "作用": "设置在地球的观测位置（默认观测行星会使用），包括经纬度、海拔",
        "可用工具":
        [
            {
                "sub_id":"1",
                "工具名":"wwt.local_horizon_mode",
                "作用":"设置是否启用本地模式",
                "输入参数方式":"赋值输入",
                "参数":
                {
                    "":"True 为启动本地模式，False 为关闭本地模式"
                }
            },
            {
                "sub_id":"2",
                "工具名":"wwt.location_latitude",
                "作用":"在WWT为本地地平模式下，设置观测地点的地理纬度",
                "输入参数方式":"赋值输入",
                "参数":
                {
                    "":"浮点型*天文的角度单位,如输入值为浮点数，然后使用‘*’符号相乘单位，如-33.33*u.deg，表示南纬33.33度"
                }
            },
            {
                "sub_id":"3",
                "工具名":"wwt.location_longitude",
                "作用":"在WWT为本地地平模式下，设置观测地点的地理经度",
                "输入参数方式":"赋值输入",
                "参数":
                {
                    "":"浮点型 * 天文的角度单位,如输入值为浮点数，然后使用‘*’符号相乘单位，如-33.33*u.deg，表示西经33.33度"
                }
            },
            {
                "sub_id":"4",
                "工具名":"wwt.location_altitude",
                "作用":"在WWT为本地地平模式下，设置观测地点的海拔高度",
                "输入参数方式":"赋值输入",
                "参数":
                {
                    "":"浮点型 * 天文的长度单位,如输入值为浮点数，然后使用‘*’符号相乘单位，如 300*u.meter，表示海拔 300 米，默认为000米"
                }
            }
        ]
    },
    {
        "id": "2",
        "作用": "设置观测目标（包括太阳、月亮、八大行星，恒星，星系等等星体）",
        "可用工具":
        [
            {
                "sub_id":"1",
                "工具名":"wwt.set_view",
                "作用":"定位行星，实现行星的可视化，定位，包括太阳，月球，火星等等",
                "输入参数方式":"括号输入",
                "参数":
                {
                    "mode":"输入行星目标（英文名），参数范围为['moon','earth','mars','jupiter','saturn','uranus','neptune','pluto']等"
                }
            },
            {
                "sub_id":"2",
                "工具名":"wwt.center_on_coordinates",
                "作用":"设置WWT的视角中心点，可以实现对太阳、月亮、八大行星，恒星，星系的定位",
                "输入参数方式":"括号输入",
                "参数":
                {
                    "coord":"输入赤经赤纬，然后转换为astropy的天文坐标对象的值",
                    "fov":"输入浮点型 * 天文的角度单位"

                }
            }
        ]
    },

    {
        "id": "4",
        "作用": "在WWT绘图中的叠加不同波段的数据",
        "可用工具":
        [
            {
                "sub_id":"1",
                "工具名":"wwt.background",
                "作用":"设置WWt的背景图层",
                "输入参数方式":"赋值输入",
                "参数":
                {
                    "":"有效的WWt图层全名（如'Fermi LAT 8-year (gamma)'）"
                }
            },
            {
                "sub_id":"2",
                "工具名":"wwt.foreground",
                "作用":"设置WWt的前景图层",
                "输入参数方式":"赋值输入",
                "参数":
                {
                    "":"有效的WWt图层全名（如'Planck Dust & Gas'）"
                }
            },
            {
                "sub_id":"3",
                "工具名":"wwt.foreground_opacity",
                "作用":"设置WWt前景图层的不透明度",
                "输入参数方式":"赋值输入",
                "参数":
                {
                    "":"0.0（完全透明）到1.0（完全不透明）"
                }
            }
        ]
    },
    {
        "id": "5",
        "作用": "在WWT中设置时间",
        "可用工具":
        [
            {
                "sub_id":"1",
                "工具名":"wwt.pause_time",
                "作用":"暂停 WWT 中时间的流逝",
                "输入参数方式":"括号输入"
            },
            {
                "sub_id":"2",
                "工具名":"wwt.get_current_time",
                "作用":"获取 WWT 当前时间",
                "输入参数方式":"括号输入"
            },
            {
                "sub_id":"3",
                "工具名":"wwt.set_current_time",
                "作用":"在启动 WWT 的时间播放的属性的前提下，设置当前时间",
                "输入参数方式":"括号输入",
                "参数":
                {
                    "dt":"传入一个天文的时间对象，如 dt=Time('2017-03-09')"
                }
            },
            {
                "sub_id":"4",
                "工具名":"wwt.play_time",
                "作用":"启动 WWT 的时间播放，并设置播放速度",
                "输入参数方式":"括号输入",
                "参数":
                {
                    "rate":"输入非零的整数，表示时间流逝的速率系数，正数表示正向播放，负数表示反向播放"
                }
            }
        ]

    },
    {
        "id": "6",
        "作用": "在WWT显示批注，添加连线、圆圈、点",
        "可用工具":
        [
            {
                "sub_id":"1",
                "工具名":"wwt.add_line",
                "作用":"在wwt中添加连线",
                "输入参数方式":"括号输入",
                "参数":
                {
                    "":"第一个参数填入天文坐标点集合，格式为astropy的concatenate函数，传入多个需要连接的天文坐标点序列。值得注意的是，WWT绘制连线时，不会自动定位到绘制连线的位置上",
                    "width":"线的宽度"
                },
                "方法":
                {
                    "color":"填入颜色，格式可为html colors,如'red'，格式还可为matplotlib colors,如'k',或者hex strings,如'#FF0000'"
                }
            },
            {
                "sub_id":"2",
                "工具名":"wwt.add_circle",
                "作用":"在wwt中添加圆圈",
                "输入参数方式":"括号输入",
                "参数":
                {
                    "":"传入astropy的SkyCoord对象，表示圆心坐标",
                    "radius":"传入圆圈的大小，单位为弧秒，即u.deg",
                    "fill":"是否填充，True为填充，False为不填充",
                    "fill_color":"填充颜色，格式可为html colors,如'red'，格式还可为matplotlib colors,如'k',或者hex strings,如'#FF0000'"
                }
            },
            {
                "sub_id":"3",
                "工具名":"wwt.add_point",
                "作用":"在wwt中添加点",
                "输入参数方式":"括号输入",
                "参数":
                {
                    "":"传入astropy的SkyCoord对象，表示圆心坐标"
                },
                "方法":
                {
                    "color":"填入颜色，格式可为html colors,如'red'，格式还可为matplotlib colors,如'k',或者hex strings,如'#FF0000'"
                }
            }
        ]

    },
    {
        "id": "7",
        "作用": "在WWT中添加表格中的星体数据，在WWT中这种数据的显示是一个个的圆点，表格中可带时间属性",
        "可用工具":
        [
            {
                "sub_id":"1",
                "工具名":"wwt.layers.add_table_layers",
                "作用":"在WWT中添加表格，即渲染表格中的天体，这样的数据为模拟出来的数据，这种星体其实是一个点",
                "输入参数方式":"括号输入",
                "参数":
                {
                    "table":"天文的表格对象,输入为转换为天文坐标对象的值，如 table=Table.read('my_table.csv', delimiter=',', format='ascii.basic')",
                    "frame":"渲染的坐标系类型，参数范围为['sky','ecliptic','galactic','sun',...,'callisto']",
                    "lon_att":"表格中代表天体赤经的列名",
                    "lat_att":"表格中代表天体赤纬的列名"
                },
                "方法":{
                    "lon_att":{
                        "参数类型":"字符串",
                        "参数描述":"表格中代表天体赤经的列名"
                    },
                    "alt_att":{
                        "参数类型":"字符串",
                        "参数描述":"表格中代表天体赤纬的列名"
                    },
                    "coord_type": {
                        "参数类型": "字符串",
                        "参数描述": "指定坐标系类型，设置为'rectangular'表示使用笛卡尔坐标系"
                    },
                    "x_att": {
                        "参数类型": "字符串",
                        "参数描述": "在笛卡尔坐标系下，指定表示x轴位置的列名"
                    },
                "y_att": {
                    "参数类型": "字符串",
                    "参数描述": "在笛卡尔坐标系下，指定表示y轴位置的列名"
                },
                "z_att": {
                    "参数类型": "字符串",
                    "参数描述": "在笛卡尔坐标系下，指定表示z轴位置的列名"
                },
                "xyz_unit": {
                    "参数类型": "字符串",
                    "参数描述": "指定 x/y/z 坐标的单位，例如 'au'（天文单位）、'kpc'（千秒差距）、'm'（米）等"
                },
                "time_series":{
                    "参数类型":"布尔值",
                    "参数描述":"是否启用时间序列属性"
                },
                "time_att":{
                    "参数类型":"字符串",
                    "参数描述":"指定表中包含时间数据的列名"
                },
                "time_decay":{
                    "参数类型":"浮点型 * 天文的时间单位",
                    "参数描述":"设置时间序列点的衰减时间，即点保持可见的持续时间。"
                },
                "size_scale":{
                    "参数类型":"浮点数",
                    "参数描述":"控制点的大小缩放比例，数值越大点越大。"
                },
                "size_att":{
                    "参数类型":"字符串",
                    "参数描述":"指定表中用于控制点大小的列名（如'mag'），点大小将根据该列的值动态变化。"
                },
                "color":{
                    "参数类型":"字符串",
                    "参数描述":"设置点的统一颜色（如'red'）。"
                },
                "cmap_att":{
                    "参数类型":"字符串",
                    "参数描述":"指定表中用于颜色映射的列名（如'depth'），颜色将根据该列的值动态变化。"
                },
                "marker_scale":{
                    "参数类型":"字符串",
                    "参数描述":"控制标记的缩放基准，'screen'保持屏幕相对大小，'world'随视角距离变化。"
                }
            }
        }
        ]
    },
    {
        "id": "8",
        "作用": "添加本地的FITS图像数据",
        "可用工具":
        [
        {
            "sub_id":"1",
            "工具名":"wwt.layers.add_image_layer",
            "作用":"在WWT中添加FITS的静态图像数据，即渲染地址中FITS单张图像到WWT中",
            "输入参数方式":"括号输入",
            "参数":
            {
                "image":"单张FITS图像的路径地址"
            },
            "方法":{
                "vmin":{
                    "参数类型":"浮点数",
                    "参数描述":"图像显示的最小像素值阈值，低于此值的像素将显示为透明或最低颜色"
                },
                "vmax":{
                    "参数类型":"浮点数",
                    "参数描述":"图像显示的最大像素值阈值，高于此值的像素将显示为最高颜色"
                },
                "opacity": {
                    "参数类型": "字符串",
                    "参数描述": "图层透明度，0.0为完全透明，1.0为完全不透明"
                },
                "remove":{
                    "参数类型": "无",
                    "参数描述": "取消当前的FITS图像数据"
                }
            }
        }
        ]
    },
    {
        "id": "9",
        "作用": "在WWT中模拟八大行星轨迹的运行",
        "可用工具":
        [
            {
                "sub_id":"1",
                "工具名":"wwt.track_object",
                "作用":"将视图锁定并聚焦到某个特定天体（八大行星）上",
                "输入参数方式":"括号输入"
            },
            {
                "sub_id":"2",
                "工具名":"wwt.cosmos",
                "作用":"布尔值，是否显示来自SDSS（斯隆数字巡天）天文调查的数据   ",
                "输入参数方式":"赋值输入"
            },
            {
                "sub_id":"3",
                "工具名":"wwt.lighting",
                "作用":"布尔值，在太阳系模式下，是否显示太阳光照对行星等天体的照明效果",
                "输入参数方式":"赋值输入"
            },
            {
                "sub_id":"4",
                "工具名":"wwt.milky_way",
                "作用":"布尔值，在太阳系模式下，是否在背景中显示银河系的星云/核心区域",
                "输入参数方式":"赋值输入"
            },
            {
                "sub_id":"5",
                "工具名":"wwt.minor_orbits",
                "作用":"布尔值，在太阳系模式下，是否显示小行星等小天体的运行轨道",
                "输入参数方式":"赋值输入"
            },
            {
                "sub_id":"6",
                "工具名":"wwt.objects",
                "作用":"布尔值，在太阳系模式下，是否显示太阳系中的天体（如行星、卫星等实体）",
                "输入参数方式":"赋值输入"
            },
            {
                "sub_id":"7",
                "工具名":"wwt.orbits",
                "作用":"布尔值，在太阳系模式下，是否显示天体的运行轨道路径",
                "输入参数方式":"赋值输入"
            },
            {
                "sub_id":"8",
                "工具名":"wwt.scale",
                "作用":"设定太阳系模式下天体大小的缩放比例：1 = 实际大小;100 = 最大可放大尺寸（数值越大，显示越夸张）",
                "输入参数方式":"括号输入"
            },
            {
                "sub_id":"9",
                "工具名":"wwt.stars",
                "作用":"布尔值，在太阳系模式下，是否显示背景的恒星",
                "输入参数方式":"赋值输入"
            }
        ]
    }
]