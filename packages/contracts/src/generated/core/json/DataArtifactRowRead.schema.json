{
  "$defs": {
    "AlignmentStatus": {
      "enum": [
        "accepted",
        "review_required",
        "rejected",
        "conflict",
        "unmatched",
        "inconclusive"
      ],
      "title": "AlignmentStatus",
      "type": "string"
    },
    "CanonicalEntityIdentity": {
      "additionalProperties": false,
      "properties": {
        "entity_level": {
          "$ref": "#/$defs/EntityLevel"
        },
        "identity_values": {
          "items": {
            "$ref": "#/$defs/CanonicalEntityIdentityValue"
          },
          "minItems": 1,
          "title": "Identity Values",
          "type": "array"
        },
        "logical_assertion_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical Assertion Key"
        }
      },
      "required": [
        "entity_level",
        "identity_values"
      ],
      "title": "CanonicalEntityIdentity",
      "type": "object"
    },
    "CanonicalEntityIdentityValue": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
          "title": "Field Id",
          "type": "string"
        },
        "normalization_rule_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Normalization Rule Version",
          "type": "string"
        },
        "normalized_value": {
          "minLength": 1,
          "title": "Normalized Value",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "normalized_value",
        "normalization_rule_version"
      ],
      "title": "CanonicalEntityIdentityValue",
      "type": "object"
    },
    "CanonicalRowIdentity": {
      "additionalProperties": false,
      "properties": {
        "alignment_status": {
          "$ref": "#/$defs/AlignmentStatus"
        },
        "conflict_code": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Code"
        },
        "entity_level": {
          "$ref": "#/$defs/EntityLevel"
        },
        "identity_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Identity Version",
          "type": "string"
        },
        "member_entities": {
          "items": {
            "$ref": "#/$defs/CanonicalEntityIdentity"
          },
          "minItems": 1,
          "title": "Member Entities",
          "type": "array"
        },
        "record_type": {
          "enum": [
            "paired",
            "unpaired",
            "conflict_group"
          ],
          "title": "Record Type",
          "type": "string"
        }
      },
      "required": [
        "record_type",
        "entity_level",
        "alignment_status",
        "member_entities"
      ],
      "title": "CanonicalRowIdentity",
      "type": "object"
    },
    "DatasetRow": {
      "additionalProperties": false,
      "properties": {
        "alignment_status": {
          "$ref": "#/$defs/AlignmentStatus"
        },
        "canonical_row_identity": {
          "$ref": "#/$defs/CanonicalRowIdentity"
        },
        "conflict_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Conflict Ids",
          "type": "array"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "crossmatch_logical_key": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Crossmatch Logical Key",
          "type": "string"
        },
        "crossmatch_record_type": {
          "minLength": 1,
          "title": "Crossmatch Record Type",
          "type": "string"
        },
        "entity_level": {
          "$ref": "#/$defs/EntityLevel"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "fields": {
          "items": {
            "discriminator": {
              "mapping": {
                "declared_null": "#/$defs/DeclaredNullValue",
                "mapped": "#/$defs/MappedCanonicalValue",
                "unresolved": "#/$defs/UnresolvedCanonicalValue"
              },
              "propertyName": "status"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MappedCanonicalValue"
              },
              {
                "$ref": "#/$defs/DeclaredNullValue"
              },
              {
                "$ref": "#/$defs/UnresolvedCanonicalValue"
              }
            ]
          },
          "title": "Fields",
          "type": "array"
        },
        "projected_field_ids": {
          "items": {
            "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Projected Field Ids",
          "type": "array"
        },
        "projection_policy_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Projection Policy Version",
          "type": "string"
        },
        "row_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Row Id",
          "type": "string"
        },
        "source_member_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Source Member Ids",
          "type": "array"
        },
        "source_snapshot_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        }
      },
      "required": [
        "row_id",
        "crossmatch_record_type",
        "crossmatch_logical_key",
        "entity_level",
        "canonical_row_identity",
        "projection_policy_version",
        "projected_field_ids",
        "alignment_status",
        "source_member_ids",
        "fields",
        "conflict_ids",
        "evidence_ids",
        "source_snapshot_ids",
        "content_hash"
      ],
      "title": "DatasetRow",
      "type": "object"
    },
    "DeclaredNullValue": {
      "additionalProperties": false,
      "properties": {
        "candidate_source_value_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Candidate Source Value Ids",
          "type": "array"
        },
        "canonical_field_id": {
          "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
          "title": "Canonical Field Id",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/NullReason"
        },
        "status": {
          "const": "declared_null",
          "default": "declared_null",
          "title": "Status",
          "type": "string"
        },
        "transformation_evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Transformation Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "canonical_field_id",
        "reason",
        "candidate_source_value_ids",
        "transformation_evidence_ids"
      ],
      "title": "DeclaredNullValue",
      "type": "object"
    },
    "EntityLevel": {
      "enum": [
        "host_star",
        "planet_candidate",
        "planet_assertion"
      ],
      "title": "EntityLevel",
      "type": "string"
    },
    "MappedCanonicalValue": {
      "additionalProperties": false,
      "properties": {
        "candidate_source_value_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Candidate Source Value Ids",
          "type": "array"
        },
        "canonical_field_id": {
          "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
          "title": "Canonical Field Id",
          "type": "string"
        },
        "canonical_unit": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Canonical Unit",
          "type": "string"
        },
        "canonical_value": {
          "title": "Canonical Value",
          "type": "string"
        },
        "conflict_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Conflict Ids",
          "type": "array"
        },
        "selected_source_value_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Source Value Id"
        },
        "selection_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Selection Id",
          "type": "string"
        },
        "status": {
          "const": "mapped",
          "default": "mapped",
          "title": "Status",
          "type": "string"
        },
        "transformation_evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Transformation Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "canonical_field_id",
        "canonical_value",
        "canonical_unit",
        "candidate_source_value_ids",
        "transformation_evidence_ids",
        "selection_id",
        "conflict_ids"
      ],
      "title": "MappedCanonicalValue",
      "type": "object"
    },
    "NullReason": {
      "description": "Controlled reasons for a nullable scientific value.",
      "enum": [
        "not_in_source",
        "not_measured",
        "not_applicable",
        "unresolved_conflict",
        "below_detection_limit"
      ],
      "title": "NullReason",
      "type": "string"
    },
    "UnresolvedCanonicalValue": {
      "additionalProperties": false,
      "properties": {
        "candidate_source_value_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Candidate Source Value Ids",
          "type": "array"
        },
        "canonical_field_id": {
          "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
          "title": "Canonical Field Id",
          "type": "string"
        },
        "conflict_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Conflict Ids",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "const": "unresolved",
          "default": "unresolved",
          "title": "Status",
          "type": "string"
        },
        "transformation_evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Transformation Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "canonical_field_id",
        "reason",
        "candidate_source_value_ids",
        "transformation_evidence_ids",
        "conflict_ids"
      ],
      "title": "UnresolvedCanonicalValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_version_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Artifact Version Id",
      "type": "string"
    },
    "row": {
      "$ref": "#/$defs/DatasetRow"
    }
  },
  "required": [
    "artifact_version_id",
    "row"
  ],
  "title": "DataArtifactRowRead",
  "type": "object"
}
