{
  "$defs": {
    "ResearchInputType": {
      "enum": [
        "url",
        "pdf",
        "csv",
        "json",
        "image",
        "text"
      ],
      "title": "ResearchInputType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "JSON transport for URL and text ingestion (files use multipart).",
  "properties": {
    "filename": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Filename"
    },
    "mime_type": {
      "anyOf": [
        {
          "maxLength": 127,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mime Type"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "text_content": {
      "anyOf": [
        {
          "maxLength": 100000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text Content"
    },
    "type": {
      "$ref": "#/$defs/ResearchInputType"
    },
    "url": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    }
  },
  "required": [
    "type",
    "project_id"
  ],
  "title": "CreateResearchInputRequest",
  "type": "object"
}
