{
  "$defs": {
    "AdjudicationDecision": {
      "enum": [
        "accepted",
        "rejected",
        "keep_unresolved"
      ],
      "title": "AdjudicationDecision",
      "type": "string"
    },
    "CrossmatchMethod": {
      "enum": [
        "exact_identifier",
        "curated_entity_alias",
        "coordinate",
        "compound"
      ],
      "title": "CrossmatchMethod",
      "type": "string"
    },
    "EntityLevel": {
      "enum": [
        "host_star",
        "planet_candidate",
        "planet_assertion"
      ],
      "title": "EntityLevel",
      "type": "string"
    },
    "ReviewerKind": {
      "enum": [
        "human",
        "benchmark_fixture"
      ],
      "title": "ReviewerKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adjudicated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adjudicated At"
    },
    "adjudicated_by": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adjudicated By"
    },
    "adjudication": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdjudicationDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "adjudication_rationale": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adjudication Rationale"
    },
    "adjudication_rule_or_actor": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adjudication Rule Or Actor"
    },
    "conflict_code": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Conflict Code",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "decision": {
      "const": "conflict",
      "default": "conflict",
      "title": "Decision",
      "type": "string"
    },
    "entity_level": {
      "$ref": "#/$defs/EntityLevel"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "left_candidate_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Left Candidate Ids",
      "type": "array"
    },
    "logical_match_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Logical Match Key",
      "type": "string"
    },
    "manual_decision_content_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manual Decision Content Hash"
    },
    "manual_decision_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manual Decision Id"
    },
    "method": {
      "$ref": "#/$defs/CrossmatchMethod"
    },
    "record_type": {
      "const": "conflict_group",
      "default": "conflict_group",
      "title": "Record Type",
      "type": "string"
    },
    "reviewer_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewerKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "right_candidate_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Right Candidate Ids",
      "type": "array"
    }
  },
  "required": [
    "logical_match_key",
    "entity_level",
    "left_candidate_ids",
    "right_candidate_ids",
    "method",
    "conflict_code",
    "evidence_ids",
    "content_hash"
  ],
  "title": "ConflictGroup",
  "type": "object"
}
