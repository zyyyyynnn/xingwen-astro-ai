{
  "$defs": {
    "NullReason": {
      "description": "Controlled reasons for a nullable scientific value.",
      "enum": [
        "not_in_source",
        "not_measured",
        "not_applicable",
        "unresolved_conflict",
        "below_detection_limit"
      ],
      "title": "NullReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_source_value_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Candidate Source Value Ids",
      "type": "array"
    },
    "canonical_field_id": {
      "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
      "title": "Canonical Field Id",
      "type": "string"
    },
    "reason": {
      "$ref": "#/$defs/NullReason"
    },
    "status": {
      "const": "declared_null",
      "default": "declared_null",
      "title": "Status",
      "type": "string"
    },
    "transformation_evidence_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Transformation Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "canonical_field_id",
    "reason",
    "candidate_source_value_ids",
    "transformation_evidence_ids"
  ],
  "title": "DeclaredNullValue",
  "type": "object"
}
