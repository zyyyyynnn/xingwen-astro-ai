{
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "Reproducible source metadata after the application redaction boundary.",
  "properties": {
    "cache_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cache Version"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "license_note": {
      "minLength": 1,
      "title": "License Note",
      "type": "string"
    },
    "query": {
      "$ref": "#/$defs/JsonValue"
    },
    "query_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Query Hash",
      "type": "string"
    },
    "request_metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Request Metadata",
      "type": "object"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "source_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_type": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source Type",
      "type": "string"
    },
    "source_version_or_etag": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Version Or Etag"
    }
  },
  "required": [
    "id",
    "source_id",
    "source_type",
    "retrieved_at",
    "query",
    "query_hash",
    "content_hash",
    "license_note",
    "request_metadata"
  ],
  "title": "SourceSnapshotDetail",
  "type": "object"
}
