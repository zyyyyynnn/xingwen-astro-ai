{
  "$defs": {
    "AlignmentStatus": {
      "enum": [
        "accepted",
        "review_required",
        "rejected",
        "conflict",
        "unmatched",
        "inconclusive"
      ],
      "title": "AlignmentStatus",
      "type": "string"
    },
    "CanonicalEntityIdentity": {
      "additionalProperties": false,
      "properties": {
        "entity_level": {
          "$ref": "#/$defs/EntityLevel"
        },
        "identity_values": {
          "items": {
            "$ref": "#/$defs/CanonicalEntityIdentityValue"
          },
          "minItems": 1,
          "title": "Identity Values",
          "type": "array"
        },
        "logical_assertion_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical Assertion Key"
        }
      },
      "required": [
        "entity_level",
        "identity_values"
      ],
      "title": "CanonicalEntityIdentity",
      "type": "object"
    },
    "CanonicalEntityIdentityValue": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
          "title": "Field Id",
          "type": "string"
        },
        "normalization_rule_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Normalization Rule Version",
          "type": "string"
        },
        "normalized_value": {
          "minLength": 1,
          "title": "Normalized Value",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "normalized_value",
        "normalization_rule_version"
      ],
      "title": "CanonicalEntityIdentityValue",
      "type": "object"
    },
    "CanonicalRowIdentity": {
      "additionalProperties": false,
      "properties": {
        "alignment_status": {
          "$ref": "#/$defs/AlignmentStatus"
        },
        "conflict_code": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Code"
        },
        "entity_level": {
          "$ref": "#/$defs/EntityLevel"
        },
        "identity_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Identity Version",
          "type": "string"
        },
        "member_entities": {
          "items": {
            "$ref": "#/$defs/CanonicalEntityIdentity"
          },
          "minItems": 1,
          "title": "Member Entities",
          "type": "array"
        },
        "record_type": {
          "enum": [
            "paired",
            "unpaired",
            "conflict_group"
          ],
          "title": "Record Type",
          "type": "string"
        }
      },
      "required": [
        "record_type",
        "entity_level",
        "alignment_status",
        "member_entities"
      ],
      "title": "CanonicalRowIdentity",
      "type": "object"
    },
    "DatasetQualityResult": {
      "additionalProperties": false,
      "properties": {
        "applicable_cell_count": {
          "minimum": 0,
          "title": "Applicable Cell Count",
          "type": "integer"
        },
        "completeness": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "cross_source_conflict_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "declared_null_count": {
          "minimum": 0,
          "title": "Declared Null Count",
          "type": "integer"
        },
        "evidence_coverage": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "field_count": {
          "minimum": 0,
          "title": "Field Count",
          "type": "integer"
        },
        "field_result_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Field Result Ids",
          "type": "array"
        },
        "inconclusive_record_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "low_confidence_edge_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "mapped_count": {
          "minimum": 0,
          "title": "Mapped Count",
          "type": "integer"
        },
        "missingness": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "null_reason_distribution": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QualityCount"
          },
          "title": "Null Reason Distribution",
          "type": "array"
        },
        "object_match_coverage": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "provenance_coverage": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "raw_status_distribution": {
          "items": {
            "$ref": "#/$defs/QualityCount"
          },
          "title": "Raw Status Distribution",
          "type": "array"
        },
        "review_required_record_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "row_result_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Row Result Ids",
          "type": "array"
        },
        "same_source_conflict_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "source_scope_completeness": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "source_snapshot_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "unit_consistency": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "unresolved_count": {
          "minimum": 0,
          "title": "Unresolved Count",
          "type": "integer"
        },
        "unresolved_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "validation_integrity": {
          "$ref": "#/$defs/QualityMetricResult"
        }
      },
      "required": [
        "row_count",
        "field_count",
        "applicable_cell_count",
        "mapped_count",
        "declared_null_count",
        "unresolved_count",
        "completeness",
        "missingness",
        "unresolved_rate",
        "provenance_coverage",
        "evidence_coverage",
        "unit_consistency",
        "same_source_conflict_rate",
        "cross_source_conflict_rate",
        "object_match_coverage",
        "low_confidence_edge_rate",
        "review_required_record_rate",
        "inconclusive_record_rate",
        "source_scope_completeness",
        "validation_integrity",
        "field_result_ids",
        "row_result_ids",
        "source_snapshot_ids",
        "evidence_ids",
        "raw_status_distribution",
        "content_hash"
      ],
      "title": "DatasetQualityResult",
      "type": "object"
    },
    "EntityLevel": {
      "enum": [
        "host_star",
        "planet_candidate",
        "planet_assertion"
      ],
      "title": "EntityLevel",
      "type": "string"
    },
    "FieldQualityResult": {
      "additionalProperties": false,
      "properties": {
        "applicable_row_count": {
          "minimum": 0,
          "title": "Applicable Row Count",
          "type": "integer"
        },
        "completeness": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "cross_source_conflict_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "declared_null_count": {
          "minimum": 0,
          "title": "Declared Null Count",
          "type": "integer"
        },
        "evidence_coverage": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "field_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field Id",
          "type": "string"
        },
        "field_manifest_reference": {
          "$ref": "#/$defs/QualityManifestFieldReference"
        },
        "mapped_count": {
          "minimum": 0,
          "title": "Mapped Count",
          "type": "integer"
        },
        "missingness": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "null_reason_distribution": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QualityCount"
          },
          "title": "Null Reason Distribution",
          "type": "array"
        },
        "provenance_coverage": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "row_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Row Ids",
          "type": "array"
        },
        "rule_references": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Rule References",
          "type": "array"
        },
        "same_source_conflict_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "source_snapshot_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "unit_consistency": {
          "$ref": "#/$defs/QualityMetricResult"
        },
        "unresolved_count": {
          "minimum": 0,
          "title": "Unresolved Count",
          "type": "integer"
        },
        "unresolved_rate": {
          "$ref": "#/$defs/QualityMetricResult"
        }
      },
      "required": [
        "field_id",
        "field_manifest_reference",
        "applicable_row_count",
        "mapped_count",
        "declared_null_count",
        "unresolved_count",
        "completeness",
        "missingness",
        "unresolved_rate",
        "provenance_coverage",
        "evidence_coverage",
        "unit_consistency",
        "same_source_conflict_rate",
        "cross_source_conflict_rate",
        "source_snapshot_ids",
        "evidence_ids",
        "row_ids",
        "rule_references",
        "content_hash"
      ],
      "title": "FieldQualityResult",
      "type": "object"
    },
    "QualityAggregateScorePolicy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "const": false,
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "score": {
          "default": null,
          "title": "Score",
          "type": "null"
        },
        "weights": {
          "default": [],
          "maxItems": 0,
          "minItems": 0,
          "title": "Weights",
          "type": "array"
        }
      },
      "title": "QualityAggregateScorePolicy",
      "type": "object"
    },
    "QualityArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "canonical_content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Content Hash"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "lineage_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lineage Hash"
        },
        "output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "candidate_id",
        "input_hash",
        "output_hash"
      ],
      "title": "QualityArtifactReference",
      "type": "object"
    },
    "QualityConstraintResult": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "input_locator": {
          "minLength": 1,
          "title": "Input Locator",
          "type": "string"
        },
        "metric_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualityMetricId"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualityMetricStatus"
            },
            {
              "const": "not_checked",
              "type": "string"
            }
          ],
          "title": "Observed Status"
        },
        "observed_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Value"
        },
        "operator": {
          "enum": [
            "gte",
            "equals"
          ],
          "title": "Operator",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/QualityGateStatus"
        },
        "rule_binding_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Rule Binding Version",
          "type": "string"
        },
        "source_field": {
          "minLength": 1,
          "title": "Source Field",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Threshold"
        }
      },
      "required": [
        "constraint_id",
        "source_field",
        "metric_id",
        "observed_status",
        "observed_value",
        "threshold",
        "operator",
        "result",
        "rule_binding_version",
        "input_locator"
      ],
      "title": "QualityConstraintResult",
      "type": "object"
    },
    "QualityCount": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "count"
      ],
      "title": "QualityCount",
      "type": "object"
    },
    "QualityGateStatus": {
      "enum": [
        "pass",
        "fail",
        "insufficient"
      ],
      "title": "QualityGateStatus",
      "type": "string"
    },
    "QualityInputReferences": {
      "additionalProperties": false,
      "properties": {
        "c04_input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "C04 Input Hash",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/QualityArtifactReference"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Candidates",
          "type": "array"
        },
        "crossmatch_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Crossmatch Content Hash",
          "type": "string"
        },
        "crossmatch_input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Crossmatch Input Hash",
          "type": "string"
        },
        "crossmatch_output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Crossmatch Output Hash",
          "type": "string"
        },
        "crossmatch_result_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Crossmatch Result Id",
          "type": "string"
        },
        "quality_rule_set_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Quality Rule Set Content Hash",
          "type": "string"
        },
        "quality_rule_set_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Quality Rule Set Id",
          "type": "string"
        },
        "quality_rule_set_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Quality Rule Set Version",
          "type": "string"
        },
        "research_contract_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Research Contract Content Hash",
          "type": "string"
        },
        "research_contract_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Research Contract Id",
          "type": "string"
        },
        "research_contract_version": {
          "minimum": 1,
          "title": "Research Contract Version",
          "type": "integer"
        }
      },
      "required": [
        "c04_input_hash",
        "candidates",
        "crossmatch_result_id",
        "crossmatch_input_hash",
        "crossmatch_output_hash",
        "crossmatch_content_hash",
        "research_contract_id",
        "research_contract_version",
        "research_contract_content_hash",
        "quality_rule_set_id",
        "quality_rule_set_version",
        "quality_rule_set_content_hash"
      ],
      "title": "QualityInputReferences",
      "type": "object"
    },
    "QualityManifestFieldReference": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field Id",
          "type": "string"
        },
        "manifest_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Content Hash",
          "type": "string"
        },
        "manifest_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Manifest Id",
          "type": "string"
        },
        "manifest_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Manifest Version",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "manifest_id",
        "manifest_version",
        "manifest_content_hash"
      ],
      "title": "QualityManifestFieldReference",
      "type": "object"
    },
    "QualityMetricId": {
      "enum": [
        "field_completeness",
        "field_missingness",
        "field_unresolved_rate",
        "field_provenance_coverage",
        "field_evidence_coverage",
        "field_unit_consistency",
        "field_conflict_rate",
        "row_completeness",
        "row_missingness",
        "row_unresolved_rate",
        "row_provenance_coverage",
        "row_evidence_coverage",
        "row_unit_consistency",
        "row_conflict_rate",
        "dataset_completeness",
        "dataset_missingness",
        "dataset_unresolved_rate",
        "dataset_provenance_coverage",
        "dataset_evidence_coverage",
        "dataset_unit_consistency",
        "dataset_cross_source_conflict_rate",
        "dataset_same_source_conflict_rate",
        "object_match_coverage",
        "low_confidence_edge_rate",
        "review_required_record_rate",
        "inconclusive_record_rate",
        "source_scope_completeness",
        "validation_integrity"
      ],
      "title": "QualityMetricId",
      "type": "string"
    },
    "QualityMetricResult": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "formula_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Formula Id",
          "type": "string"
        },
        "formula_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Formula Version",
          "type": "string"
        },
        "input_locator": {
          "minLength": 1,
          "title": "Input Locator",
          "type": "string"
        },
        "metric_id": {
          "$ref": "#/$defs/QualityMetricId"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/QualityMetricScope"
        },
        "status": {
          "$ref": "#/$defs/QualityMetricStatus"
        },
        "target_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "threshold_source": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold Source"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "metric_id",
        "scope",
        "target_id",
        "status",
        "numerator",
        "denominator",
        "formula_id",
        "formula_version",
        "input_locator"
      ],
      "title": "QualityMetricResult",
      "type": "object"
    },
    "QualityMetricScope": {
      "enum": [
        "field",
        "row",
        "dataset"
      ],
      "title": "QualityMetricScope",
      "type": "string"
    },
    "QualityMetricStatus": {
      "enum": [
        "determinate",
        "insufficient",
        "not_applicable"
      ],
      "title": "QualityMetricStatus",
      "type": "string"
    },
    "QualityProducerReference": {
      "additionalProperties": false,
      "properties": {
        "producer_name": {
          "minLength": 1,
          "title": "Producer Name",
          "type": "string"
        },
        "producer_type": {
          "const": "algorithm",
          "default": "algorithm",
          "title": "Producer Type",
          "type": "string"
        },
        "producer_version": {
