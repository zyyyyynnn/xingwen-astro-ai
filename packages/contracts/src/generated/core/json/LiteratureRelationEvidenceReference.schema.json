{
  "additionalProperties": false,
  "properties": {
    "claim_artifact_version_id": {
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Claim Artifact Version Id",
      "type": "string"
    },
    "claim_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Claim Id",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Evidence Id",
      "type": "string"
    },
    "paper_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Paper Id",
      "type": "string"
    },
    "paper_summary_artifact_version_id": {
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Paper Summary Artifact Version Id",
      "type": "string"
    },
    "relation_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Relation Id",
      "type": "string"
    },
    "side": {
      "enum": [
        "source",
        "target"
      ],
      "title": "Side",
      "type": "string"
    },
    "source_snapshot_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Snapshot Content Hash",
      "type": "string"
    },
    "source_snapshot_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Snapshot Id",
      "type": "string"
    },
    "source_snapshot_version": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Source Snapshot Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "supported",
        "unsupported",
        "unverifiable"
      ],
      "title": "Status",
      "type": "string"
    },
    "validation_code": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Validation Code",
      "type": "string"
    }
  },
  "required": [
    "relation_id",
    "side",
    "claim_id",
    "claim_artifact_version_id",
    "paper_summary_artifact_version_id",
    "evidence_id",
    "paper_id",
    "source_snapshot_id",
    "source_snapshot_version",
    "source_snapshot_content_hash",
    "status",
    "validation_code"
  ],
  "title": "LiteratureRelationEvidenceReference",
  "type": "object"
}
