{
  "$defs": {
    "DatasetArtifactContent": {
      "additionalProperties": false,
      "properties": {
        "field_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Field Ids",
          "type": "array"
        },
        "kind": {
          "const": "dataset",
          "title": "Kind",
          "type": "string"
        },
        "rows": {
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "propertyNames": {
              "maxLength": 128,
              "minLength": 1
            },
            "type": "object"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "field_ids",
        "rows"
      ],
      "title": "DatasetArtifactContent",
      "type": "object"
    },
    "ExportArtifactContent": {
      "additionalProperties": false,
      "properties": {
        "artifact_version_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Artifact Version Ids",
          "type": "array"
        },
        "format": {
          "enum": [
            "csv",
            "json",
            "provenance_report"
          ],
          "title": "Format",
          "type": "string"
        },
        "kind": {
          "const": "export",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "format",
        "artifact_version_ids"
      ],
      "title": "ExportArtifactContent",
      "type": "object"
    },
    "FieldDictionaryArtifactContent": {
      "additionalProperties": false,
      "properties": {
        "field_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Field Ids",
          "type": "array"
        },
        "kind": {
          "const": "field_dictionary",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "field_ids"
      ],
      "title": "FieldDictionaryArtifactContent",
      "type": "object"
    },
    "GraphArtifactContent": {
      "additionalProperties": false,
      "properties": {
        "edge_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Edge Ids",
          "type": "array"
        },
        "kind": {
          "const": "graph",
          "title": "Kind",
          "type": "string"
        },
        "node_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Node Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "node_ids",
        "edge_ids"
      ],
      "title": "GraphArtifactContent",
      "type": "object"
    },
    "LiteratureClaimsArtifactContent": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "kind": {
          "const": "literature_claims",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "claim_ids"
      ],
      "title": "LiteratureClaimsArtifactContent",
      "type": "object"
    },
    "LiteratureRelationsArtifactContent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "literature_relations",
          "title": "Kind",
          "type": "string"
        },
        "relation_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Relation Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "relation_ids"
      ],
      "title": "LiteratureRelationsArtifactContent",
      "type": "object"
    },
    "PaperBenchmarkReference": {
      "additionalProperties": false,
      "properties": {
        "benchmark_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Benchmark Id",
          "type": "string"
        },
        "benchmark_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Benchmark Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_payload_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Scientific Payload Hash",
          "type": "string"
        },
        "x00_main_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "X00 Main Sha",
          "type": "string"
        }
      },
      "required": [
        "benchmark_id",
        "schema_version",
        "benchmark_version",
        "scientific_payload_hash",
        "content_hash",
        "scenario_id",
        "x00_main_sha"
      ],
      "title": "PaperBenchmarkReference",
      "type": "object"
    },
    "PaperCollectionArtifactContent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "paper_collection",
          "title": "Kind",
          "type": "string"
        },
        "paper_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Paper Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "paper_ids"
      ],
      "title": "PaperCollectionArtifactContent",
      "type": "object"
    },
    "PaperSummaryArtifactContent": {
      "additionalProperties": false,
      "description": "Publisher-ready D-03 content used directly by the v2 Artifact discriminator.",
      "properties": {
        "benchmark": {
          "$ref": "#/$defs/PaperBenchmarkReference"
        },
        "dataset": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaperSummaryStatement"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/PaperSummaryEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/PaperSummaryStatement"
          },
          "title": "Findings",
          "type": "array"
        },
        "future_work": {
          "items": {
            "$ref": "#/$defs/PaperSummaryStatement"
          },
          "title": "Future Work",
          "type": "array"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "input_versions": {
          "$ref": "#/$defs/PaperSummaryInputVersions"
        },
        "kind": {
          "const": "paper_summary",
          "title": "Kind",
          "type": "string"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/PaperSummaryStatement"
          },
          "title": "Limitations",
          "type": "array"
        },
        "method": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaperSummaryStatement"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "paper_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Paper Id",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/PaperSummaryProducerExecution"
        },
        "research_goal": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaperSummaryStatement"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_conflicts": {
          "items": {
            "$ref": "#/$defs/PaperSummarySourceConflict"
          },
          "title": "Source Conflicts",
          "type": "array"
        },
        "summary_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Summary Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "summary_id",
        "paper_id",
        "benchmark",
        "input_versions",
        "research_goal",
        "method",
        "dataset",
        "findings",
        "limitations",
        "future_work",
        "evidence_ids",
        "evidence",
        "source_conflicts",
        "producer",
        "input_hash",
        "output_hash"
      ],
      "title": "PaperSummaryArtifactContent",
      "type": "object"
    },
    "PaperSummaryEvidence": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/PaperSummaryEvidenceLocator"
        },
        "paper_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Paper Id",
          "type": "string"
        },
        "quote_or_value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Quote Or Value",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_record_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "source_snapshot_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Snapshot Content Hash",
          "type": "string"
        },
        "source_snapshot_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "source_snapshot_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Snapshot Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PaperSummarySupportStatus"
        },
        "validation_code": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Validation Code",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "paper_id",
        "candidate_id",
        "source_id",
        "source_record_id",
        "source_snapshot_id",
        "source_snapshot_version",
        "source_snapshot_content_hash",
        "locator",
        "quote_or_value",
        "status",
        "validation_code"
      ],
      "title": "PaperSummaryEvidence",
      "type": "object"
    },
    "PaperSummaryEvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "paper_text",
            "paper_metadata"
          ],
          "title": "Kind",
          "type": "string"
        },
        "metadata_field": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Field"
        },
        "paragraph": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "text_range": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Range"
        }
      },
      "required": [
        "kind",
        "source_url"
      ],
      "title": "PaperSummaryEvidenceLocator",
      "type": "object"
    },
    "PaperSummaryInputVersions": {
      "additionalProperties": false,
      "properties": {
        "paper_collection_output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Paper Collection Output Hash",
          "type": "string"
        },
        "paper_collection_schema_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Paper Collection Schema Version",
          "type": "string"
        },
        "paper_collection_version_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Paper Collection Version Id",
          "type": "string"
        },
        "source_snapshots": {
          "items": {
            "$ref": "#/$defs/PaperSummarySourceSnapshotReference"
          },
          "title": "Source Snapshots",
          "type": "array"
        }
      },
      "required": [
        "paper_collection_version_id",
        "paper_collection_schema_version",
        "paper_collection_output_hash",
        "source_snapshots"
      ],
      "title": "PaperSummaryInputVersions",
      "type": "object"
    },
    "PaperSummaryProducerExecution": {
      "additionalProperties": false,
      "properties": {
        "error_code": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "execution_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Execution Id",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "input_versions": {
          "$ref": "#/$defs/PaperSummaryInputVersions"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model_name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "model_response_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Model Response Hash",
          "type": "string"
        },
        "output_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "parameters_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Parameters Hash",
          "type": "string"
        },
        "parameters_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Parameters Version",
          "type": "string"
        },
        "producer_name": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Producer Name",
          "type": "string"
        },
        "producer_type": {
          "const": "model",
          "default": "model",
          "title": "Producer Type",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Producer Version",
          "type": "string"
        },
        "prompt_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Prompt Hash",
          "type": "string"
        },
        "prompt_name": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Prompt Name",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "step_key": {
          "const": "summarizing_papers",
          "default": "summarizing_papers",
          "title": "Step Key",
          "type": "string"
        }
      },
      "required": [
        "execution_id",
        "producer_name",
        "producer_version",
        "model_name",
        "prompt_name",
        "prompt_version",
        "prompt_hash",
        "parameters_version",
        "parameters_hash",
        "input_versions",
        "input_hash",
        "model_response_hash",
        "status",
        "started_at",
        "finished_at",
        "latency_ms"
      ],
      "title": "PaperSummaryProducerExecution",
      "type": "object"
    },
    "PaperSummarySourceConflict": {
      "additionalProperties": false,
      "properties": {
        "claimed_source_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Claimed Source Version",
          "type": "string"
        },
        "conflict_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Conflict Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "resolution": {
          "const": "source_snapshot_version_retained",
          "default": "source_snapshot_version_retained",
          "title": "Resolution",
          "type": "string"
        },
        "source_snapshot_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "source_snapshot_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Snapshot Version",
          "type": "string"
        }
      },
      "required": [
        "conflict_id",
        "evidence_id",
        "source_snapshot_id",
        "claimed_source_version",
        "source_snapshot_version"
      ],
      "title": "PaperSummarySourceConflict",
      "type": "object"
    },
    "PaperSummarySourceSnapshotReference": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_snapshot_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "source_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
        "source_snapshot_id",
        "source_id",
        "source_version",
        "content_hash"
      ],
      "title": "PaperSummarySourceSnapshotReference",
      "type": "object"
    },
    "PaperSummaryStatement": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "statement_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Statement Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PaperSummarySupportStatus"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "validation_code": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Validation Code",
          "type": "string"
        }
      },
      "required": [
        "statement_id",
        "text",
        "evidence_ids",
        "status",
        "validation_code"
      ],
      "title": "PaperSummaryStatement",
      "type": "object"
    },
    "PaperSummarySupportStatus": {
      "enum": [
        "supported",
        "unsupported",
        "unverifiable"
      ],
      "title": "PaperSummarySupportStatus",
      "type": "string"
    },
    "ProducerReference": {
      "additionalProperties": false,
      "properties": {
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "model_provider": {
          "anyOf": [
