{
  "additionalProperties": false,
  "description": "JSON create for ``type=url``: a URL is fetched server-side.\n\nModelled as its own type (not a nullable mega-model) so the generated JSON\nSchema *machine-level* forbids ``text_content`` and file semantics here\ninstead of relying on a runtime-only validator.",
  "properties": {
    "filename": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Filename"
    },
    "mime_type": {
      "anyOf": [
        {
          "maxLength": 127,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mime Type"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "type": {
      "const": "url",
      "title": "Type",
      "type": "string"
    },
    "url": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "type",
    "project_id",
    "url"
  ],
  "title": "UrlResearchInputRequest",
  "type": "object"
}
