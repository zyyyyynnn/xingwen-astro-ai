{
  "name": "xingwen-astro-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.13.1"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "format": "prettier --write \"apps/{site,workspace}/**/*.{astro,css,html,json,ts,tsx}\" \"packages/{design-tokens,ui,domain,contracts,data-access,workspace-core,visual-engine,testing}/**/*.{css,json,ts,tsx}\" \"tests/e2e/**/*.ts\" \"scripts/*.mjs\" \"*.{json,mjs,yaml,yml}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"apps/{site,workspace}/**/*.{astro,css,html,json,ts,tsx}\" \"packages/{design-tokens,ui,domain,contracts,data-access,workspace-core,visual-engine,testing}/**/*.{css,json,ts,tsx}\" \"tests/e2e/**/*.ts\" \"scripts/*.mjs\" \"*.{json,mjs,yaml,yml}\" \".github/**/*.yml\"",
    "check:architecture": "node scripts/check-frontend-architecture.mjs",
    "check:legacy": "node scripts/check-frontend-legacy.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:architecture && pnpm check:legacy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.7.0",
    "eslint-plugin-astro": "3.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "0.14.1",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
