{
  "$defs": {
    "LiteratureRelationConfidenceStatus": {
      "enum": [
        "assessed",
        "not_evaluable"
      ],
      "title": "LiteratureRelationConfidenceStatus",
      "type": "string"
    },
    "LiteratureRelationConfidenceSubject": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "relation_type": {
          "$ref": "#/$defs/LiteratureRelationType"
        },
        "source_claim_artifact_version_id": {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Source Claim Artifact Version Id",
          "type": "string"
        },
        "source_claim_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Claim Id",
          "type": "string"
        },
        "target_claim_artifact_version_id": {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Target Claim Artifact Version Id",
          "type": "string"
        },
        "target_claim_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Target Claim Id",
          "type": "string"
        }
      },
      "required": [
        "source_claim_artifact_version_id",
        "source_claim_id",
        "target_claim_artifact_version_id",
        "target_claim_id",
        "relation_type",
        "fingerprint"
      ],
      "title": "LiteratureRelationConfidenceSubject",
      "type": "object"
    },
    "LiteratureRelationStatus": {
      "enum": [
        "candidate",
        "accepted",
        "rejected"
      ],
      "title": "LiteratureRelationStatus",
      "type": "string"
    },
    "LiteratureRelationType": {
      "enum": [
        "supports",
        "extends",
        "derived_from",
        "limits",
        "contradicts",
        "uses_same_dataset",
        "compares_method"
      ],
      "title": "LiteratureRelationType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Trusted, versioned calibration input referenced by model output by id.",
  "properties": {
    "acceptance_threshold": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Acceptance Threshold",
      "type": "number"
    },
    "applicability_scope": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Applicability Scope",
      "type": "string"
    },
    "assessment_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Assessment Id",
      "type": "string"
    },
    "basis": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Basis",
      "type": "array"
    },
    "calibration_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Calibration Content Hash",
      "type": "string"
    },
    "calibration_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Calibration Id",
      "type": "string"
    },
    "calibration_method": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Calibration Method",
      "type": "string"
    },
    "calibration_sample_size": {
      "minimum": 1,
      "title": "Calibration Sample Size",
      "type": "integer"
    },
    "calibration_scientific_payload_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Calibration Scientific Payload Hash",
      "type": "string"
    },
    "calibration_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Calibration Version",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/LiteratureRelationStatus"
    },
    "definition_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Definition Id",
      "type": "string"
    },
    "definition_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Definition Version",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "score_interpretation": {
      "const": "confidence_in_relation_type_and_admission_decision",
      "default": "confidence_in_relation_type_and_admission_decision",
      "title": "Score Interpretation",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/LiteratureRelationConfidenceStatus"
    },
    "subject": {
      "$ref": "#/$defs/LiteratureRelationConfidenceSubject"
    }
  },
  "required": [
    "assessment_id",
    "subject",
    "decision",
    "status",
    "definition_id",
    "definition_version",
    "calibration_id",
    "calibration_version",
    "calibration_scientific_payload_hash",
    "calibration_content_hash",
    "calibration_sample_size",
    "calibration_method",
    "applicability_scope",
    "acceptance_threshold",
    "basis"
  ],
  "title": "LiteratureRelationConfidenceAssessment",
  "type": "object"
}
