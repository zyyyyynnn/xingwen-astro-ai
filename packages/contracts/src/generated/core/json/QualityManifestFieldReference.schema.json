{
  "additionalProperties": false,
  "properties": {
    "field_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Field Id",
      "type": "string"
    },
    "manifest_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Content Hash",
      "type": "string"
    },
    "manifest_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Manifest Id",
      "type": "string"
    },
    "manifest_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Manifest Version",
      "type": "string"
    }
  },
  "required": [
    "field_id",
    "manifest_id",
    "manifest_version",
    "manifest_content_hash"
  ],
  "title": "QualityManifestFieldReference",
  "type": "object"
}
