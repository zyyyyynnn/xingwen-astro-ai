{
  "$defs": {
    "SessionQuota": {
      "additionalProperties": false,
      "properties": {
        "max_projects": {
          "default": 10,
          "minimum": 1,
          "title": "Max Projects",
          "type": "integer"
        },
        "max_runs": {
          "default": 50,
          "minimum": 1,
          "title": "Max Runs",
          "type": "integer"
        }
      },
      "title": "SessionQuota",
      "type": "object"
    },
    "SessionStatus": {
      "enum": [
        "active",
        "expired",
        "revoked"
      ],
      "title": "SessionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Public session metadata; the credential and internal id are excluded.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "quota": {
      "$ref": "#/$defs/SessionQuota"
    },
    "status": {
      "$ref": "#/$defs/SessionStatus"
    }
  },
  "required": [
    "status",
    "created_at",
    "expires_at",
    "quota"
  ],
  "title": "ResearchSession",
  "type": "object"
}
