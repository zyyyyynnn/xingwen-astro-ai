{
  "$defs": {
    "QuantityKind": {
      "description": "Physical dimensions used for static compatibility checks only.",
      "enum": [
        "none",
        "angle",
        "time",
        "length",
        "mass",
        "temperature",
        "logarithmic_abundance"
      ],
      "title": "QuantityKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "factor": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Factor"
    },
    "factor_denominator": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Factor Denominator"
    },
    "factor_numerator": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Factor Numerator"
    },
    "quantity_kind": {
      "$ref": "#/$defs/QuantityKind"
    },
    "rule_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Rule Id",
      "type": "string"
    },
    "rule_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Rule Version",
      "type": "string"
    },
    "source_unit": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Unit"
    },
    "target_unit": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Unit"
    }
  },
  "required": [
    "rule_id",
    "rule_version",
    "quantity_kind",
    "factor",
    "factor_numerator",
    "factor_denominator"
  ],
  "title": "UnitConversionImplementation",
  "type": "object"
}
