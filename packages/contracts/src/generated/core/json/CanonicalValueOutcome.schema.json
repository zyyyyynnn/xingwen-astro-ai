{
  "$defs": {
    "DeclaredNullValue": {
      "additionalProperties": false,
      "properties": {
        "candidate_source_value_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Candidate Source Value Ids",
          "type": "array"
        },
        "canonical_field_id": {
          "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
          "title": "Canonical Field Id",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/NullReason"
        },
        "status": {
          "const": "declared_null",
          "default": "declared_null",
          "title": "Status",
          "type": "string"
        },
        "transformation_evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Transformation Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "canonical_field_id",
        "reason",
        "candidate_source_value_ids",
        "transformation_evidence_ids"
      ],
      "title": "DeclaredNullValue",
      "type": "object"
    },
    "MappedCanonicalValue": {
      "additionalProperties": false,
      "properties": {
        "candidate_source_value_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Candidate Source Value Ids",
          "type": "array"
        },
        "canonical_field_id": {
          "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
          "title": "Canonical Field Id",
          "type": "string"
        },
        "canonical_unit": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Canonical Unit",
          "type": "string"
        },
        "canonical_value": {
          "title": "Canonical Value",
          "type": "string"
        },
        "conflict_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Conflict Ids",
          "type": "array"
        },
        "selected_source_value_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Selected Source Value Id",
          "type": "string"
        },
        "selection_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Selection Id",
          "type": "string"
        },
        "status": {
          "const": "mapped",
          "default": "mapped",
          "title": "Status",
          "type": "string"
        },
        "transformation_evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Transformation Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "canonical_field_id",
        "canonical_value",
        "canonical_unit",
        "selected_source_value_id",
        "candidate_source_value_ids",
        "transformation_evidence_ids",
        "selection_id",
        "conflict_ids"
      ],
      "title": "MappedCanonicalValue",
      "type": "object"
    },
    "NullReason": {
      "description": "Controlled reasons for a nullable scientific value.",
      "enum": [
        "not_in_source",
        "not_measured",
        "not_applicable",
        "unresolved_conflict",
        "below_detection_limit"
      ],
      "title": "NullReason",
      "type": "string"
    },
    "UnresolvedCanonicalValue": {
      "additionalProperties": false,
      "properties": {
        "candidate_source_value_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Candidate Source Value Ids",
          "type": "array"
        },
        "canonical_field_id": {
          "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
          "title": "Canonical Field Id",
          "type": "string"
        },
        "conflict_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Conflict Ids",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "const": "unresolved",
          "default": "unresolved",
          "title": "Status",
          "type": "string"
        },
        "transformation_evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Transformation Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "canonical_field_id",
        "reason",
        "candidate_source_value_ids",
        "transformation_evidence_ids",
        "conflict_ids"
      ],
      "title": "UnresolvedCanonicalValue",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "declared_null": "#/$defs/DeclaredNullValue",
      "mapped": "#/$defs/MappedCanonicalValue",
      "unresolved": "#/$defs/UnresolvedCanonicalValue"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/MappedCanonicalValue"
    },
    {
      "$ref": "#/$defs/DeclaredNullValue"
    },
    {
      "$ref": "#/$defs/UnresolvedCanonicalValue"
    }
  ]
}
