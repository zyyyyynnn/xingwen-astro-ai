{
  "$defs": {
    "LimitFlagMapping": {
      "additionalProperties": false,
      "description": "Source flag meanings for a bounded value.",
      "properties": {
        "lower_limit": {
          "default": 1,
          "title": "Lower Limit",
          "type": "integer"
        },
        "measured": {
          "default": 0,
          "title": "Measured",
          "type": "integer"
        },
        "upper_limit": {
          "default": -1,
          "title": "Upper Limit",
          "type": "integer"
        }
      },
      "title": "LimitFlagMapping",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A source column mapped to one canonical field.",
  "properties": {
    "conversion_rule_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Conversion Rule Id",
      "type": "string"
    },
    "limit_field": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limit Field"
    },
    "limit_flags": {
      "anyOf": [
        {
          "$ref": "#/$defs/LimitFlagMapping"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "negative_error_field": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Negative Error Field"
    },
    "positive_error_field": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Positive Error Field"
    },
    "priority": {
      "minimum": 1,
      "title": "Priority",
      "type": "integer"
    },
    "provenance_field": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provenance Field"
    },
    "raw_field": {
      "minLength": 1,
      "title": "Raw Field",
      "type": "string"
    },
    "reference_field": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Field"
    },
    "row_key_fields": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Row Key Fields",
      "type": "array"
    },
    "source_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_table": {
      "minLength": 1,
      "title": "Source Table",
      "type": "string"
    },
    "source_unit": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Unit",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "source_table",
    "raw_field",
    "source_unit",
    "conversion_rule_id",
    "priority",
    "row_key_fields"
  ],
  "title": "SourceAlias",
  "type": "object"
}
