          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "column_key"
      ],
      "title": "PublicPresentationTableCell",
      "type": "object"
    },
    "PublicPresentationTableColumn": {
      "additionalProperties": false,
