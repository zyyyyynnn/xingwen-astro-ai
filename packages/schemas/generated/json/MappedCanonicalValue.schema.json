    },
    "canonical_value": {
      "title": "Canonical Value",
      "type": "string"
    },
    "conflict_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Conflict Ids",
      "type": "array"
    },
    "selected_source_value_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Selected Source Value Id",
      "type": "string"
