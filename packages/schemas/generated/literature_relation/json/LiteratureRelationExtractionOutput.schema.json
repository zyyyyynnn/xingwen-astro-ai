{
  "$defs": {
    "LiteratureComparabilityStatus": {
      "enum": [
        "comparable",
        "not_applicable",
        "incomparable"
      ],
      "title": "LiteratureComparabilityStatus",
      "type": "string"
    },
    "LiteratureReasoningTraceModelCandidate": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conclusion"
        },
        "conditions": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "limitations": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "premise_claim_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Premise Claim Ids",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/LiteratureReasoningTraceStepCandidate"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "premise_claim_ids",
        "steps",
        "conditions",
        "limitations",
        "conflicts"
      ],
      "title": "LiteratureReasoningTraceModelCandidate",
      "type": "object"
    },
    "LiteratureReasoningTraceStepCandidate": {
      "additionalProperties": false,
      "description": "One public, verifiable operation; never a private reasoning token log.",
      "properties": {
        "claim_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "operation": {
          "$ref": "#/$defs/LiteratureTraceOperation"
        },
        "order": {
          "maximum": 32,
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "statement": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "order",
        "operation",
        "statement",
        "claim_ids",
        "evidence_ids"
      ],
      "title": "LiteratureReasoningTraceStepCandidate",
      "type": "object"
    },
    "LiteratureRelationComparabilityCandidate": {
      "additionalProperties": false,
      "properties": {
        "metric_basis": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Metric Basis",
          "type": "string"
        },
        "metric_status": {
          "$ref": "#/$defs/LiteratureComparabilityStatus"
        },
        "object_basis": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Object Basis",
          "type": "string"
        },
        "object_status": {
          "$ref": "#/$defs/LiteratureComparabilityStatus"
        },
        "unit_basis": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Unit Basis",
          "type": "string"
        },
        "unit_status": {
          "$ref": "#/$defs/LiteratureComparabilityStatus"
        }
      },
      "required": [
        "object_status",
        "object_basis",
        "metric_status",
        "metric_basis",
        "unit_status",
        "unit_basis"
      ],
      "title": "LiteratureRelationComparabilityCandidate",
      "type": "object"
    },
    "LiteratureRelationDirectionCandidate": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "source_claim_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Claim Id",
          "type": "string"
        },
        "target_claim_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Target Claim Id",
          "type": "string"
        }
      },
      "required": [
        "source_claim_id",
        "target_claim_id",
        "basis"
      ],
      "title": "LiteratureRelationDirectionCandidate",
      "type": "object"
    },
    "LiteratureRelationModelCandidate": {
      "additionalProperties": false,
      "description": "Strict JSON model output before any provenance or domain admission.",
      "properties": {
        "comparability": {
          "$ref": "#/$defs/LiteratureRelationComparabilityCandidate"
        },
        "condition_conflicts": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Condition Conflicts",
          "type": "array"
        },
        "condition_uncertainties": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Condition Uncertainties",
          "type": "array"
        },
        "conditions": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "confidence_assessment_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Assessment Id"
        },
        "direction": {
          "$ref": "#/$defs/LiteratureRelationDirectionCandidate"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "relation_type": {
          "$ref": "#/$defs/LiteratureRelationType"
        },
        "source_claim_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Claim Id",
          "type": "string"
        },
        "target_claim_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Target Claim Id",
          "type": "string"
        },
        "trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiteratureReasoningTraceModelCandidate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source_claim_id",
        "target_claim_id",
        "relation_type",
        "direction",
        "conditions",
        "condition_conflicts",
        "condition_uncertainties",
        "comparability",
        "evidence_ids"
      ],
      "title": "LiteratureRelationModelCandidate",
      "type": "object"
    },
    "LiteratureRelationType": {
      "enum": [
        "supports",
        "extends",
        "derived_from",
        "limits",
        "contradicts",
        "uses_same_dataset",
        "compares_method"
      ],
      "title": "LiteratureRelationType",
      "type": "string"
    },
    "LiteratureTraceOperation": {
      "enum": [
        "identify_premises",
        "compare_objects",
        "compare_metric",
        "compare_unit",
        "check_conditions",
        "check_evidence",
        "classify_relation",
        "record_limitation"
      ],
      "title": "LiteratureTraceOperation",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "relations": {
      "items": {
        "$ref": "#/$defs/LiteratureRelationModelCandidate"
      },
      "minItems": 1,
      "title": "Relations",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "relations"
  ],
  "title": "LiteratureRelationExtractionOutput",
  "type": "object"
}
