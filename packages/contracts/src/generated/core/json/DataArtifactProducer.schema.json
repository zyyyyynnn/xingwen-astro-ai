{
  "additionalProperties": false,
  "properties": {
    "conversion_catalog_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Conversion Catalog Content Hash",
      "type": "string"
    },
    "conversion_catalog_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Conversion Catalog Id",
      "type": "string"
    },
    "conversion_catalog_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Conversion Catalog Version",
      "type": "string"
    },
    "mapping_rule_set_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Mapping Rule Set Content Hash",
      "type": "string"
    },
    "mapping_rule_set_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Mapping Rule Set Id",
      "type": "string"
    },
    "mapping_rule_set_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Mapping Rule Set Version",
      "type": "string"
    },
    "producer_name": {
      "minLength": 1,
      "title": "Producer Name",
      "type": "string"
    },
    "producer_type": {
      "const": "algorithm",
      "default": "algorithm",
      "title": "Producer Type",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Producer Version",
      "type": "string"
    }
  },
  "required": [
    "producer_name",
    "producer_version",
    "mapping_rule_set_id",
    "mapping_rule_set_version",
    "mapping_rule_set_content_hash",
    "conversion_catalog_id",
    "conversion_catalog_version",
    "conversion_catalog_content_hash"
  ],
  "title": "DataArtifactProducer",
  "type": "object"
}
