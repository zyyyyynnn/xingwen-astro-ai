{
  "$defs": {
    "IntegrationCaseCategory": {
      "description": "Why a case exists in the frozen corpus.",
      "enum": [
        "integration",
        "failure_injection",
        "repair_probe"
      ],
      "title": "IntegrationCaseCategory",
      "type": "string"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "Observed outcome of one frozen case; never mutates production state.",
  "properties": {
    "case_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/IntegrationCaseCategory"
    },
    "expected_error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Error Code"
    },
    "failure_detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Detail"
    },
    "input_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Hash"
    },
    "observed": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Observed",
      "type": "object"
    },
    "observed_error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Error Code"
    },
    "output_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Hash"
    },
    "reproduced_output_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reproduced Output Hash"
    },
    "status": {
      "pattern": "^(passed|failed)$",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "category",
    "status"
  ],
  "title": "IntegrationCaseResult",
  "type": "object"
}
