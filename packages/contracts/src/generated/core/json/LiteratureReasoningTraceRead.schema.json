        },
        "direction": {
          "$ref": "#/$defs/LiteratureRelationDirectionCandidate"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "failure_stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiteratureRelationFailureStage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "model_response_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
