{
  "$defs": {
    "BenchmarkDataType": {
      "description": "Provenance class of a benchmark document (fakes must never impersonate).",
      "enum": [
        "fixture",
        "golden",
        "recorded",
        "live"
      ],
      "title": "BenchmarkDataType",
      "type": "string"
    },
    "GoldenExpectedAnnotation": {
      "additionalProperties": false,
      "description": "Machine-readable expected structure for one Golden Set entry (D-10 D3).\n\nLets the benchmark answer \"how much of the key structure was recovered?\"\ninstead of merely \"did a block get accepted?\". Committed fixtures carry a\nfull annotation; local-only/restricted entries may carry only a page_count\nand license/provenance. ``None`` means \"not annotated in this checkout\".",
      "properties": {
        "critical_headings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Critical Headings",
          "type": "array"
        },
        "expected_page_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Page Count"
        },
        "selected_cells": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Selected Cells",
          "type": "array"
        },
        "selected_figure_caption_links": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Selected Figure Caption Links",
          "type": "array"
        },
        "selected_formulas": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Selected Formulas",
          "type": "array"
        },
        "selected_paragraph_block_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Selected Paragraph Block Ids",
          "type": "array"
        },
        "selected_reading_order": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Selected Reading Order",
          "type": "array"
        },
        "selected_scientific_values": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Selected Scientific Values",
          "type": "array"
        },
        "selected_tables": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Selected Tables",
          "type": "array"
        }
      },
      "title": "GoldenExpectedAnnotation",
      "type": "object"
    },
    "GoldenSetEntry": {
      "additionalProperties": false,
      "description": "One Golden Set entry manifest (license/provenance governed).",
      "properties": {
        "availability": {
          "minLength": 1,
          "title": "Availability",
          "type": "string"
        },
        "case_key": {
          "minLength": 1,
          "title": "Case Key",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "coverage_tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Coverage Tags",
          "type": "array"
        },
        "data_type": {
          "$ref": "#/$defs/BenchmarkDataType"
        },
        "doi_or_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi Or Identifier"
        },
        "entry_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Entry Id",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoldenExpectedAnnotation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "license_note": {
          "minLength": 1,
          "title": "License Note",
          "type": "string"
        },
        "local_only": {
          "default": false,
          "title": "Local Only",
          "type": "boolean"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "entry_id",
        "case_key",
        "title",
        "data_type",
        "source",
        "license_note",
        "availability"
      ],
      "title": "GoldenSetEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Machine-readable Golden Set manifest (version + hash locked).",
  "properties": {
    "case_key": {
      "default": "exoplanet_host_star",
      "title": "Case Key",
      "type": "string"
    },
    "entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GoldenSetEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "manifest_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Manifest Id",
      "type": "string"
    },
    "sample_count": {
      "minimum": 0,
      "title": "Sample Count",
      "type": "integer"
    },
    "version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "manifest_id",
    "version",
    "generated_at",
    "sample_count"
  ],
  "title": "GoldenSetManifest",
  "type": "object"
}
