{
  "$defs": {
    "PaperSummaryEvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "paper_text",
            "paper_metadata"
          ],
          "title": "Kind",
          "type": "string"
        },
        "metadata_field": {
          "anyOf": [
            {
              "enum": [
                "source_record_id",
                "title",
                "authors",
                "year",
                "doi",
                "arxiv_id",
                "url"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Field"
        },
        "paragraph": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "text_range": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Range"
        }
      },
      "required": [
        "kind",
        "source_url"
      ],
      "title": "PaperSummaryEvidenceLocator",
      "type": "object"
    },
    "PaperSummarySupportStatus": {
      "enum": [
        "supported",
        "unsupported",
        "unverifiable"
      ],
      "title": "PaperSummarySupportStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Candidate Id",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Evidence Id",
      "type": "string"
    },
    "locator": {
      "$ref": "#/$defs/PaperSummaryEvidenceLocator"
    },
    "paper_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Paper Id",
      "type": "string"
    },
    "quote_or_value": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Quote Or Value",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_record_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Source Record Id",
      "type": "string"
    },
    "source_snapshot_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Snapshot Content Hash",
      "type": "string"
    },
    "source_snapshot_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Snapshot Id",
      "type": "string"
    },
    "source_snapshot_version": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Source Snapshot Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/PaperSummarySupportStatus"
    },
    "validation_code": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Validation Code",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "paper_id",
    "candidate_id",
    "source_id",
    "source_record_id",
    "source_snapshot_id",
    "source_snapshot_version",
    "source_snapshot_content_hash",
    "locator",
    "quote_or_value",
    "status",
    "validation_code"
  ],
  "title": "PaperSummaryEvidence",
  "type": "object"
}
