{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "dataset",
        "field_dictionary",
        "source_collection",
        "paper_collection",
        "paper_summary",
        "literature_claims",
        "literature_relations",
        "reasoning_traces",
        "graph",
        "export"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "SourceMode": {
      "enum": [
        "fixture",
        "live",
        "cached"
      ],
      "title": "SourceMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Redacted immutable version metadata safe for an anonymous share response.",
  "properties": {
    "artifact_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ArtifactKind"
    },
    "schema_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_mode": {
      "$ref": "#/$defs/SourceMode"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "version_number": {
      "minimum": 1,
      "title": "Version Number",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "artifact_id",
    "kind",
    "title",
    "version_number",
    "schema_version",
    "content_hash",
    "source_mode",
    "created_at"
  ],
  "title": "PublicArtifactVersion",
  "type": "object"
}
