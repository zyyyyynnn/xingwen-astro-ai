{
  "$defs": {
    "CrossmatchSide": {
      "enum": [
        "left",
        "right"
      ],
      "title": "CrossmatchSide",
      "type": "string"
    },
    "LimitStatus": {
      "enum": [
        "measured",
        "lower_limit",
        "upper_limit",
        "not_applicable"
      ],
      "title": "LimitStatus",
      "type": "string"
    },
    "LimitValue": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceCellLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_flag": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Flag"
        },
        "status": {
          "$ref": "#/$defs/LimitStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "LimitValue",
      "type": "object"
    },
    "NullReason": {
      "description": "Controlled reasons for a nullable scientific value.",
      "enum": [
        "not_in_source",
        "not_measured",
        "not_applicable",
        "unresolved_conflict",
        "below_detection_limit"
      ],
      "title": "NullReason",
      "type": "string"
    },
    "SourceCellLocator": {
      "additionalProperties": false,
      "properties": {
        "query_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Query Hash",
          "type": "string"
        },
        "raw_field": {
          "minLength": 1,
          "title": "Raw Field",
          "type": "string"
        },
        "raw_record_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Raw Record Content Hash",
          "type": "string"
        },
        "row_key": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "minLength": 1,
                "type": "string"
              }
            ],
            "type": "array"
          },
          "minItems": 1,
          "title": "Row Key",
          "type": "array"
        },
        "side": {
          "$ref": "#/$defs/CrossmatchSide"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_snapshot_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Snapshot Content Hash",
          "type": "string"
        },
        "source_snapshot_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "side",
        "source_snapshot_id",
        "source_snapshot_content_hash",
        "source_id",
        "query_hash",
        "row_key",
        "raw_record_content_hash",
        "raw_field"
      ],
      "title": "SourceCellLocator",
      "type": "object"
    },
    "UncertaintyStatus": {
      "enum": [
        "complete",
        "partial",
        "missing",
        "not_applicable"
      ],
      "title": "UncertaintyStatus",
      "type": "string"
    },
    "UncertaintyValue": {
      "additionalProperties": false,
      "properties": {
        "canonical_negative": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Negative"
        },
        "canonical_positive": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Positive"
        },
        "negative_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceCellLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "positive_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceCellLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_negative": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Negative"
        },
        "source_positive": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Positive"
        },
        "status": {
          "$ref": "#/$defs/UncertaintyStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "UncertaintyValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alias_priority": {
      "exclusiveMinimum": 0,
      "title": "Alias Priority",
      "type": "integer"
    },
    "canonical_field_id": {
      "pattern": "^(?:planet|star|system)\\.[a-z][a-z0-9_]*$",
      "title": "Canonical Field Id",
      "type": "string"
    },
    "canonical_unit": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Canonical Unit",
      "type": "string"
    },
    "canonical_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Canonical Value"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "conversion_rule_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Conversion Rule Id",
      "type": "string"
    },
    "conversion_rule_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Conversion Rule Version",
      "type": "string"
    },
    "evidence_locator": {
      "$ref": "#/$defs/SourceCellLocator"
    },
    "limit": {
      "$ref": "#/$defs/LimitValue"
    },
    "null_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/NullReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provenance_field": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provenance Field"
    },
    "provenance_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provenance Value"
    },
    "query_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Query Hash",
      "type": "string"
    },
    "raw_field": {
      "minLength": 1,
      "title": "Raw Field",
      "type": "string"
    },
    "raw_record_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Raw Record Content Hash",
      "type": "string"
    },
    "raw_record_row_key": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "minLength": 1,
            "type": "string"
          },
          {
            "minLength": 1,
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Raw Record Row Key",
      "type": "array"
    },
    "raw_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Value"
    },
    "reference_field": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Field"
    },
    "reference_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Value"
    },
    "source_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_priority": {
      "exclusiveMinimum": 0,
      "title": "Source Priority",
      "type": "integer"
    },
    "source_snapshot_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Snapshot Content Hash",
      "type": "string"
    },
    "source_snapshot_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Snapshot Id",
      "type": "string"
    },
    "source_table": {
      "minLength": 1,
      "title": "Source Table",
      "type": "string"
    },
    "source_unit": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Unit",
      "type": "string"
    },
    "source_value_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Value Id",
      "type": "string"
    },
    "transformation_rule_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Transformation Rule Version",
      "type": "string"
    },
    "uncertainty": {
      "$ref": "#/$defs/UncertaintyValue"
    }
  },
  "required": [
    "source_value_id",
    "canonical_field_id",
    "source_id",
    "source_table",
    "source_snapshot_id",
    "source_snapshot_content_hash",
    "query_hash",
    "raw_record_row_key",
    "raw_record_content_hash",
    "raw_field",
    "raw_value",
    "source_unit",
    "canonical_value",
    "canonical_unit",
    "alias_priority",
    "source_priority",
    "transformation_rule_version",
    "conversion_rule_id",
    "conversion_rule_version",
    "uncertainty",
    "limit",
    "evidence_locator",
    "content_hash"
  ],
  "title": "SourceValueCandidate",
  "type": "object"
}
