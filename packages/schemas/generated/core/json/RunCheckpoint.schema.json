{
  "$defs": {
    "RepairCandidateCoordinate": {
      "additionalProperties": false,
      "properties": {
        "declination_degrees": {
          "maximum": 90,
          "minimum": -90,
          "title": "Declination Degrees",
          "type": "number"
        },
        "frame": {
          "const": "ICRS",
          "default": "ICRS",
          "title": "Frame",
          "type": "string"
        },
        "right_ascension_degrees": {
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Right Ascension Degrees",
          "type": "number"
        }
      },
      "required": [
        "right_ascension_degrees",
        "declination_degrees"
      ],
      "title": "RepairCandidateCoordinate",
      "type": "object"
    },
    "RepairCandidateIdentity": {
      "additionalProperties": false,
      "description": "One user-readable canonical identity carried by a repair candidate.",
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "RepairCandidateIdentity",
      "type": "object"
    },
    "RepairCandidateSummary": {
      "additionalProperties": false,
      "description": "Domain facts needed to judge a candidate without exposing opaque IDs.",
      "properties": {
        "candidate_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "coordinate": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepairCandidateCoordinate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entity_label": {
          "minLength": 1,
          "title": "Entity Label",
          "type": "string"
        },
        "identities": {
          "items": {
            "$ref": "#/$defs/RepairCandidateIdentity"
          },
          "minItems": 1,
          "title": "Identities",
          "type": "array"
        },
        "source_label": {
          "minLength": 1,
          "title": "Source Label",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "source_label",
        "entity_label",
        "identities"
      ],
      "title": "RepairCandidateSummary",
      "type": "object"
    },
    "RepairCheckpointContext": {
      "additionalProperties": false,
      "description": "Immutable defect and RuleSet facts shown at a scientific repair checkpoint.",
      "properties": {
        "before_output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Before Output Hash",
          "type": "string"
        },
        "defects": {
          "items": {
            "$ref": "#/$defs/RepairDefect"
          },
          "minItems": 1,
          "title": "Defects",
          "type": "array"
        },
        "rule_set": {
          "$ref": "#/$defs/RepairRuleSetReference"
        },
        "source_input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Input Hash",
          "type": "string"
        }
      },
      "required": [
        "rule_set",
        "source_input_hash",
        "before_output_hash",
        "defects"
      ],
      "title": "RepairCheckpointContext",
      "type": "object"
    },
    "RepairDecisionInput": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "accepted",
            "rejected",
            "keep_unresolved"
          ],
          "title": "Action",
          "type": "string"
        },
        "defect_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Defect Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "defect_id",
        "action",
        "rationale"
      ],
      "title": "RepairDecisionInput",
      "type": "object"
    },
    "RepairDefect": {
      "additionalProperties": false,
      "description": "One cross-source conflict that cannot be resolved without human authority.",
      "properties": {
        "conflict_code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Conflict Code",
          "type": "string"
        },
        "defect_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Defect Id",
          "type": "string"
        },
        "defect_type": {
          "const": "cross_source_conflict",
          "default": "cross_source_conflict",
          "title": "Defect Type",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/RepairEvidenceFact"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "left_candidates": {
          "items": {
            "$ref": "#/$defs/RepairCandidateSummary"
          },
          "minItems": 1,
          "title": "Left Candidates",
          "type": "array"
        },
        "logical_match_key": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Logical Match Key",
          "type": "string"
        },
        "right_candidates": {
          "items": {
            "$ref": "#/$defs/RepairCandidateSummary"
          },
          "minItems": 1,
          "title": "Right Candidates",
          "type": "array"
        }
      },
      "required": [
        "defect_id",
        "logical_match_key",
        "conflict_code",
        "left_candidates",
        "right_candidates",
        "evidence"
      ],
      "title": "RepairDefect",
      "type": "object"
    },
    "RepairEvidenceFact": {
      "additionalProperties": false,
      "description": "User-readable evidence for one candidate pair at a repair checkpoint.",
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "left_candidate_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Left Candidate Id",
          "type": "string"
        },
        "right_candidate_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Right Candidate Id",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "left_candidate_id",
        "right_candidate_id",
        "confidence",
        "summary"
      ],
      "title": "RepairEvidenceFact",
      "type": "object"
    },
    "RepairOutcome": {
      "additionalProperties": false,
      "description": "Deterministic revalidation closure for one submitted repair batch.",
      "properties": {
        "after_evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "After Evidence Ids",
          "type": "array"
        },
        "after_output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "After Output Hash",
          "type": "string"
        },
        "before_evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Before Evidence Ids",
          "type": "array"
        },
        "quality_result_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Quality Result Hash",
          "type": "string"
        },
        "resolved_defect_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Resolved Defect Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "revalidated",
            "false_repair"
          ],
          "title": "Status",
          "type": "string"
        },
        "unresolved_defect_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Unresolved Defect Ids",
          "type": "array"
        }
      },
      "required": [
        "after_output_hash",
        "quality_result_hash",
        "before_evidence_ids",
        "after_evidence_ids",
        "resolved_defect_ids",
        "unresolved_defect_ids",
        "status"
      ],
      "title": "RepairOutcome",
      "type": "object"
    },
    "RepairRuleSetReference": {
      "additionalProperties": false,
      "properties": {
        "allowed_actions": {
          "default": [
            "accepted",
            "rejected",
            "keep_unresolved"
          ],
          "items": {
            "enum": [
              "accepted",
              "rejected",
              "keep_unresolved"
            ],
            "type": "string"
          },
          "title": "Allowed Actions",
          "type": "array"
        },
        "rule_set_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Rule Set Content Hash",
          "type": "string"
        },
        "rule_set_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Rule Set Id",
          "type": "string"
        },
        "rule_set_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Rule Set Version",
          "type": "string"
        }
      },
      "required": [
        "rule_set_id",
        "rule_set_version",
        "rule_set_content_hash"
      ],
      "title": "RepairRuleSetReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One human-input request on a Run's ``waiting_for_input`` boundary.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    },
    "free_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Free Text"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "default": "choice",
      "enum": [
        "choice",
        "scientific_repair"
      ],
      "title": "Kind",
      "type": "string"
    },
    "options": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Options",
      "type": "array"
    },
    "question": {
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "repair_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepairCheckpointContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "repair_decisions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RepairDecisionInput"
      },
      "title": "Repair Decisions",
      "type": "array"
    },
    "repair_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepairOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "run_revision": {
      "minimum": 1,
      "title": "Run Revision",
      "type": "integer"
    },
    "selected_option": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Option"
    },
    "step_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Step Key",
      "type": "string"
    }
  },
  "required": [
    "id",
    "run_id",
    "run_revision",
    "step_key",
    "question",
    "options",
    "created_at"
  ],
  "title": "RunCheckpoint",
  "type": "object"
}
