          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "artifact_version_id",
        "target_type",
        "target_id",
        "evidence_type",
        "source_snapshot_id",
        "locator",
        "extraction_method",
        "confidence",
