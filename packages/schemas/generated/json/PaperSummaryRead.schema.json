      "type": "object"
    },
    "PaperSummaryPaperMetadata": {
      "additionalProperties": false,
      "description": "Bibliographic identity projected from the pinned input PaperCollection.",
      "properties": {
        "authors": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "paper_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Paper Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "required": [
        "paper_id",
        "title"
      ],
      "title": "PaperSummaryPaperMetadata",
      "type": "object"
    },
