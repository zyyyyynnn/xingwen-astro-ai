{
  "$defs": {
    "LiteratureRelationType": {
      "enum": [
        "supports",
        "extends",
        "derived_from",
        "limits",
        "contradicts",
        "uses_same_dataset",
        "compares_method"
      ],
      "title": "LiteratureRelationType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Fingerprint",
      "type": "string"
    },
    "relation_type": {
      "$ref": "#/$defs/LiteratureRelationType"
    },
    "source_claim_artifact_version_id": {
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Source Claim Artifact Version Id",
      "type": "string"
    },
    "source_claim_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Claim Id",
      "type": "string"
    },
    "target_claim_artifact_version_id": {
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Target Claim Artifact Version Id",
      "type": "string"
    },
    "target_claim_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Target Claim Id",
      "type": "string"
    }
  },
  "required": [
    "source_claim_artifact_version_id",
    "source_claim_id",
    "target_claim_artifact_version_id",
    "target_claim_id",
    "relation_type",
    "fingerprint"
  ],
  "title": "LiteratureRelationConfidenceSubject",
  "type": "object"
}
