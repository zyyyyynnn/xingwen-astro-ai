        "model_name",
        "prompt_name",
        "prompt_version",
        "prompt_hash",
        "parameters_version",
        "parameters_hash",
        "input_versions",
        "input_hash",
        "model_response_hash",
        "status",
        "started_at",
        "finished_at",
