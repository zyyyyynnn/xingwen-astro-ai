{
  "$defs": {
    "GraphArtifactVersionReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_version_id": {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Artifact Version Id",
          "type": "string"
        },
        "content_hash": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "input_hash": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "kind": {
          "enum": [
            "literature_relations",
            "dataset",
            "field_dictionary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "output_hash": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "parameters_hash": {
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Parameters Hash",
          "type": "string"
        },
        "producer_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Producer Name",
          "type": "string"
        },
        "producer_type": {
          "enum": [
            "pipeline",
            "model",
            "algorithm"
          ],
          "title": "Producer Type",
          "type": "string"
        },
        "producer_version": {
          "maxLength": 32,
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Producer Version",
          "type": "string"
        },
        "project_id": {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/GraphInputRole"
        },
        "schema_version": {
          "maxLength": 32,
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_mode": {
          "enum": [
            "fixture",
            "live",
            "cached"
          ],
          "title": "Source Mode",
          "type": "string"
        },
        "version_number": {
          "minimum": 1,
          "title": "Version Number",
          "type": "integer"
        }
      },
      "required": [
        "role",
        "artifact_id",
        "artifact_version_id",
        "project_id",
        "version_number",
        "kind",
        "schema_version",
        "content_hash",
        "input_hash",
        "output_hash",
        "source_mode",
        "producer_type",
        "producer_name",
        "producer_version",
        "parameters_hash"
      ],
      "title": "GraphArtifactVersionReference",
      "type": "object"
    },
    "GraphInputRole": {
      "enum": [
        "literature_relations",
        "dataset",
        "field_dictionary"
      ],
      "title": "GraphInputRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Project Id",
      "type": "string"
    },
    "versions": {
      "items": {
        "$ref": "#/$defs/GraphArtifactVersionReference"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Versions",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "versions"
  ],
  "title": "GraphInputVersionClosure",
  "type": "object"
}
