{
  "$defs": {
    "BenchmarkScenarioStatus": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "BenchmarkScenarioStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "failure_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "observed_error_code": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Error Code"
    },
    "result_content_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Content Hash"
    },
    "scenario_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/BenchmarkScenarioStatus"
    }
  },
  "required": [
    "scenario_id",
    "status"
  ],
  "title": "CrossmatchBenchmarkScenarioResult",
  "type": "object"
}
