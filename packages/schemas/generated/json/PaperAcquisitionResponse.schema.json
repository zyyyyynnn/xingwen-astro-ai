{
  "$defs": {
    "PaperAcquisitionRun": {
      "description": "One reproducible paper acquisition run.",
      "properties": {
        "candidate_count": {
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "dedupe_rule": {
          "title": "Dedupe Rule",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "query_id": {
          "title": "Query Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "selected_count": {
          "minimum": 0,
          "title": "Selected Count",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PaperAcquisitionStatus"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "used_cache": {
          "title": "Used Cache",
          "type": "boolean"
        }
      },
      "required": [
        "run_id",
        "task_id",
        "query_id",
        "status",
        "candidate_count",
        "selected_count",
        "dedupe_rule",
        "used_cache",
        "started_at"
      ],
      "title": "PaperAcquisitionRun",
      "type": "object"
    },
    "PaperAcquisitionStatus": {
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "cached"
      ],
      "title": "PaperAcquisitionStatus",
      "type": "string"
    },
    "PaperCandidate": {
      "properties": {
        "abstract": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstract"
        },
        "arxiv_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arxiv Id"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "dedupe_key": {
          "title": "Dedupe Key",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "relevance_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Relevance Score",
          "type": "number"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "selected": {
          "title": "Selected",
          "type": "boolean"
        },
        "selection_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Reason"
        },
        "source_record_id": {
          "title": "Source Record Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "required": [
        "candidate_id",
        "task_id",
        "run_id",
        "source_record_id",
        "title",
        "authors",
        "relevance_score",
        "dedupe_key",
        "selected"
      ],
      "title": "PaperCandidate",
      "type": "object"
    },
    "PaperSearchQuery": {
      "description": "Phase 0 paper query domain model with the legacy Pipeline wire alias.",
      "properties": {
        "case_key": {
          "title": "Case Key",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "filters": {
          "additionalProperties": true,
          "title": "Filters",
          "type": "object"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "query_id": {
          "title": "Query Id",
          "type": "string"
        },
        "query_string": {
          "title": "Query String",
          "type": "string"
        },
        "source_types": {
          "items": {
            "type": "string"
          },
          "title": "Source Types",
          "type": "array"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "query_id",
        "task_id",
        "case_key",
        "keywords",
        "source_types",
        "query_string",
        "filters",
        "created_at"
      ],
      "title": "PaperSearchQuery",
      "type": "object"
    }
  },
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/PaperCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "query": {
      "$ref": "#/$defs/PaperSearchQuery"
    },
    "run": {
      "$ref": "#/$defs/PaperAcquisitionRun"
    }
  },
  "required": [
    "query",
    "run",
    "candidates"
  ],
  "title": "PaperAcquisitionResponse",
  "type": "object"
}
