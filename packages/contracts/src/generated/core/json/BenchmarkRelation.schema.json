{
  "$defs": {
    "BenchmarkAdmissionStatus": {
      "enum": [
        "candidate",
        "accepted",
        "rejected"
      ],
      "title": "BenchmarkAdmissionStatus",
      "type": "string"
    },
    "BenchmarkReviewStatus": {
      "enum": [
        "pending_scientific_review",
        "approved",
        "changes_requested"
      ],
      "title": "BenchmarkReviewStatus",
      "type": "string"
    },
    "LiteratureRelationType": {
      "enum": [
        "supports",
        "extends",
        "derived_from",
        "limits",
        "contradicts",
        "uses_same_dataset",
        "compares_method"
      ],
      "title": "LiteratureRelationType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "comparability_note": {
      "minLength": 1,
      "title": "Comparability Note",
      "type": "string"
    },
    "conditions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Conditions",
      "type": "array"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "reasoning_trace_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reasoning Trace Id"
    },
    "rejection_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejection Reason"
    },
    "relation_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Relation Id",
      "type": "string"
    },
    "relation_type": {
      "$ref": "#/$defs/LiteratureRelationType"
    },
    "review_status": {
      "$ref": "#/$defs/BenchmarkReviewStatus"
    },
    "source_claim_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Claim Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/BenchmarkAdmissionStatus"
    },
    "target_claim_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Target Claim Id",
      "type": "string"
    }
  },
  "required": [
    "relation_id",
    "source_claim_id",
    "target_claim_id",
    "relation_type",
    "conditions",
    "comparability_note",
    "evidence_ids",
    "confidence",
    "status",
    "review_status"
  ],
  "title": "BenchmarkRelation",
  "type": "object"
}
