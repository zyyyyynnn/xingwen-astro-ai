{
  "$defs": {
    "JsonValue": {},
    "ProducerExecutionDetail": {
      "additionalProperties": false,
      "description": "Reproducible producer metadata with private execution state excluded.",
      "properties": {
        "error_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "output_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "parameters_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Parameters Hash",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerReference"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "failed",
            "rejected",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "step_attempt_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Step Attempt Id",
          "type": "string"
        },
        "step_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Step Key",
          "type": "string"
        },
        "token_usage": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Usage"
        }
      },
      "required": [
        "id",
        "run_id",
        "step_key",
        "step_attempt_id",
        "producer",
        "parameters",
        "parameters_hash",
        "input_hash",
        "status",
        "started_at"
      ],
      "title": "ProducerExecutionDetail",
      "type": "object"
    },
    "ProducerReference": {
      "additionalProperties": false,
      "properties": {
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "model_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Provider"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parameters_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters Hash"
        },
        "prompt_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Hash"
        },
        "prompt_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Name"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "type": {
          "enum": [
            "pipeline",
            "model",
            "algorithm"
          ],
          "title": "Type",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "version"
      ],
      "title": "ProducerReference",
      "type": "object"
    },
    "SourceMode": {
      "enum": [
        "fixture",
        "live",
        "cached"
      ],
      "title": "SourceMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_version_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Artifact Version Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "layout_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Layout Hash",
      "type": "string"
    },
    "output_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Output Hash",
      "type": "string"
    },
    "producer_execution": {
      "$ref": "#/$defs/ProducerExecutionDetail"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "report_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Report Hash",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "scientific_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Scientific Hash",
      "type": "string"
    },
    "source_mode": {
      "$ref": "#/$defs/SourceMode"
    },
    "supersedes_version_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Supersedes Version Id"
    },
    "version_number": {
      "minimum": 1,
      "title": "Version Number",
      "type": "integer"
    }
  },
  "required": [
    "artifact_version_id",
    "artifact_id",
    "project_id",
    "version_number",
    "supersedes_version_id",
    "source_mode",
    "schema_version",
    "content_hash",
    "input_hash",
    "scientific_hash",
    "layout_hash",
    "report_hash",
    "output_hash",
    "created_at",
    "producer_execution"
  ],
  "title": "GraphArtifactVersionContext",
  "type": "object"
}
