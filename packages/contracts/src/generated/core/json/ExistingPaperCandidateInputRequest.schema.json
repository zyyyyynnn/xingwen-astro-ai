{
  "$defs": {
    "PaperAccessEvidenceKind": {
      "enum": [
        "publisher_open_access",
        "repository_open_access",
        "author_provided",
        "user_provided"
      ],
      "title": "PaperAccessEvidenceKind",
      "type": "string"
    },
    "PaperCandidateAccessEvidence": {
      "additionalProperties": false,
      "description": "Bounded lawful-access assertion retained without restricted content.",
      "properties": {
        "canonical_paper_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Canonical Paper Id",
          "type": "string"
        },
        "evidence_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Evidence Url",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PaperAccessEvidenceKind"
        },
        "license": {
          "maxLength": 256,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "resource_identity_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Resource Identity Hash",
          "type": "string"
        },
        "resource_type": {
          "enum": [
            "access_url",
            "research_input"
          ],
          "title": "Resource Type",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "license",
        "evidence_url",
        "canonical_paper_id",
        "resource_type",
        "resource_identity_hash"
      ],
      "title": "PaperCandidateAccessEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "access_evidence": {
      "$ref": "#/$defs/PaperCandidateAccessEvidence"
    },
    "mode": {
      "const": "existing_research_input",
      "title": "Mode",
      "type": "string"
    },
    "research_input_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Research Input Id",
      "type": "string"
    }
  },
  "required": [
    "mode",
    "research_input_id",
    "access_evidence"
  ],
  "title": "ExistingPaperCandidateInputRequest",
  "type": "object"
}
