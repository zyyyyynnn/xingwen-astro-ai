          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "source_version_or_etag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version Or Etag"
        }
      },
      "required": [
        "id",
        "source_id",
