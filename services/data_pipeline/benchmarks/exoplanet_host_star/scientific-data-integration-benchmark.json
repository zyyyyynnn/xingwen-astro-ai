  "data_level": "synthetic_fixture_plus_recorded_response",
  "provenance_note": "Frozen integration corpus over independently adjudicated synthetic crossmatch records and hash-pinned Recorded TOI/PS acquisition fixtures. Expected retrievals are scored only after the existing production adapters replay their fixture transports; field values, entity pairs, conflicts, unit outcomes, and repair dispositions remain independent frozen adjudications. Production output is observed but never copied into truth.",
  "adjudication_source": "The pinned TOI and PS recorded acquisition fixtures, crossmatch benchmark corpus, field manifest, mapping rules, and unit catalog, independently reviewed as frozen fixture contracts",
  "adjudicated_at": "2026-08-25T00:00:00Z",
  "inconclusive_policy": "Only explicitly enumerated retrievable source rows and adjudicated observations enter a metric denominator. Truncated or incomplete source status never substitutes whole-case pass/fail for an observation and is excluded unless the frozen corpus declares an expectation.",
  "evaluation_version": "2.1.0",
  "metric_formulas": {
    "source_retrieval_completeness": "formally_acquired_expected_source_rows_with_pinned_snapshot_identity / frozen_recorded_source_row_expectations",
    "field_value_correctness": "exact_canonical_field_values / frozen_field_value_adjudications",
    "entity_alignment_precision": "true_positive_pairs / observed_accepted_pairs",
    "entity_alignment_recall": "true_positive_pairs / frozen_expected_pairs",
    "unit_normalization_success": "exact_canonical_values / frozen_unit_normalization_adjudications",
    "conflict_detection": "correct_conflict_decisions / frozen_conflict_adjudications",
    "repair_success": "resolved_required_repairs / frozen_should_repair_adjudications",
    "false_repair_rate": "incorrectly_resolved_no_repair_cases / frozen_must_not_repair_adjudications",
    "evidence_coverage": "crossmatch_evidence_with_exact_snapshot_source_query_row_field_closure / audited_crossmatch_evidence",
    "reproducibility_hash_stability": "stable_rerun_hashes / successful_scenario_reruns",
    "failure_recovery": "exact_expected_failures / frozen_failure_injections"
  },
