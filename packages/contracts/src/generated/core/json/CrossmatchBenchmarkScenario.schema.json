{
  "$defs": {
    "AdjudicationDecision": {
      "enum": [
        "accepted",
        "rejected",
        "keep_unresolved"
      ],
      "title": "AdjudicationDecision",
      "type": "string"
    },
    "BenchmarkPsRecord": {
      "additionalProperties": false,
      "properties": {
        "declination": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declination"
        },
        "gaia_dr3_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gaia Dr3 Id"
        },
        "hostname": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hostname"
        },
        "planet_name": {
          "minLength": 1,
          "title": "Planet Name",
          "type": "string"
        },
        "record_type": {
          "const": "ps",
          "default": "ps",
          "title": "Record Type",
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "right_ascension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right Ascension"
        },
        "tic_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tic Id"
        }
      },
      "required": [
        "planet_name",
        "reference"
      ],
      "title": "BenchmarkPsRecord",
      "type": "object"
    },
    "BenchmarkToiRecord": {
      "additionalProperties": false,
      "properties": {
        "declination": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declination"
        },
        "record_type": {
          "const": "toi",
          "default": "toi",
          "title": "Record Type",
          "type": "string"
        },
        "right_ascension": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right Ascension"
        },
        "tic_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tic Id"
        },
        "toi": {
          "minLength": 1,
          "title": "Toi",
          "type": "string"
        }
      },
      "required": [
        "toi"
      ],
      "title": "BenchmarkToiRecord",
      "type": "object"
    },
    "CrossmatchBenchmarkExpectation": {
      "additionalProperties": false,
      "properties": {
        "conflict_codes": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Conflict Codes",
          "type": "array"
        },
        "conflict_group_count": {
          "minimum": 0,
          "title": "Conflict Group Count",
          "type": "integer"
        },
        "expected_error_code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Error Code"
        },
        "inconclusive_count": {
          "minimum": 0,
          "title": "Inconclusive Count",
          "type": "integer"
        },
        "manual_adjudication_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Adjudication Count"
        },
        "methods": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CrossmatchMethod"
          },
          "title": "Methods",
          "type": "array"
        },
        "paired_count": {
          "minimum": 0,
          "title": "Paired Count",
          "type": "integer"
        },
        "planet_assertion_count": {
          "minimum": 0,
          "title": "Planet Assertion Count",
          "type": "integer"
        },
        "review_required_count": {
          "minimum": 0,
          "title": "Review Required Count",
          "type": "integer"
        },
        "topologies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MatchTopology"
          },
          "title": "Topologies",
          "type": "array"
        },
        "unmatched_count": {
          "minimum": 0,
          "title": "Unmatched Count",
          "type": "integer"
        }
      },
      "required": [
        "paired_count",
        "conflict_group_count",
        "unmatched_count",
        "inconclusive_count",
        "review_required_count",
        "planet_assertion_count"
      ],
      "title": "CrossmatchBenchmarkExpectation",
      "type": "object"
    },
    "CrossmatchCapacityPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_candidate_pairs": {
          "exclusiveMinimum": 0,
          "maximum": 10000000,
          "title": "Max Candidate Pairs",
          "type": "integer"
        },
        "max_left_records": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Max Left Records",
          "type": "integer"
        },
        "max_right_records": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Max Right Records",
          "type": "integer"
        }
      },
      "required": [
        "max_left_records",
        "max_right_records",
        "max_candidate_pairs"
      ],
      "title": "CrossmatchCapacityPolicy",
      "type": "object"
    },
    "CrossmatchMethod": {
      "enum": [
        "exact_identifier",
        "curated_entity_alias",
        "coordinate",
        "compound"
      ],
      "title": "CrossmatchMethod",
      "type": "string"
    },
    "DataSourceCompletionStatus": {
      "description": "Whether the bounded acquisition proved that its source scope is complete.",
      "enum": [
        "complete",
        "truncated",
        "unknown"
      ],
      "title": "DataSourceCompletionStatus",
      "type": "string"
    },
    "MatchTopology": {
      "enum": [
        "one_to_one",
        "one_to_many",
        "many_to_one",
        "many_to_many"
      ],
      "title": "MatchTopology",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capacity_override": {
      "anyOf": [
        {
          "$ref": "#/$defs/CrossmatchCapacityPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "category": {
      "minLength": 1,
      "title": "Category",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "expectation": {
      "$ref": "#/$defs/CrossmatchBenchmarkExpectation"
    },
    "input_fault": {
      "anyOf": [
        {
          "enum": [
            "duplicate_record_reference",
            "record_source_mismatch"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Fault"
    },
    "left_completion": {
      "$ref": "#/$defs/DataSourceCompletionStatus"
    },
    "left_records": {
      "items": {
        "$ref": "#/$defs/BenchmarkToiRecord"
      },
      "title": "Left Records",
      "type": "array"
    },
    "manual_adjudication": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdjudicationDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "manual_binding": {
      "anyOf": [
        {
          "enum": [
            "valid",
            "stale_input",
            "stale_rule"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manual Binding"
    },
    "right_completion": {
      "$ref": "#/$defs/DataSourceCompletionStatus"
    },
    "right_records": {
      "items": {
        "$ref": "#/$defs/BenchmarkPsRecord"
      },
      "title": "Right Records",
      "type": "array"
    },
    "scenario_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Scenario Id",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "description",
    "category",
    "left_completion",
    "right_completion",
    "left_records",
    "right_records",
    "expectation"
  ],
  "title": "CrossmatchBenchmarkScenario",
  "type": "object"
}
