{
  "$defs": {
    "PaperSummaryBenchmarkCaseResult": {
      "additionalProperties": false,
      "properties": {
        "benchmark_summary_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Benchmark Summary Id",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Case Id",
          "type": "string"
        },
        "core_item_count": {
          "minimum": 0,
          "title": "Core Item Count",
          "type": "integer"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "model_response_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Model Response Hash",
          "type": "string"
        },
        "output_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "schema_valid": {
          "title": "Schema Valid",
          "type": "boolean"
        },
        "supported_core_item_count": {
          "minimum": 0,
          "title": "Supported Core Item Count",
          "type": "integer"
        },
        "unsupported_blocked": {
          "title": "Unsupported Blocked",
          "type": "boolean"
        },
        "unsupported_expected": {
          "title": "Unsupported Expected",
          "type": "boolean"
        }
      },
      "required": [
        "case_id",
        "benchmark_summary_id",
        "schema_valid",
        "core_item_count",
        "supported_core_item_count",
        "unsupported_expected",
        "unsupported_blocked",
        "input_hash",
        "model_response_hash"
      ],
      "title": "PaperSummaryBenchmarkCaseResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "benchmark_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Benchmark Content Hash",
      "type": "string"
    },
    "benchmark_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_schema_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Benchmark Schema Version",
      "type": "string"
    },
    "benchmark_scientific_payload_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Benchmark Scientific Payload Hash",
      "type": "string"
    },
    "benchmark_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Benchmark Version",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/PaperSummaryBenchmarkCaseResult"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "evidence_coverage": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Coverage"
    },
    "evidence_items_supported": {
      "minimum": 0,
      "title": "Evidence Items Supported",
      "type": "integer"
    },
    "evidence_items_total": {
      "minimum": 0,
      "title": "Evidence Items Total",
      "type": "integer"
    },
    "human_review_sample_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Human Review Sample Ids",
      "type": "array"
    },
    "input_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "model_name": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Model Name",
      "type": "string"
    },
    "output_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Output Hash",
      "type": "string"
    },
    "parameters_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Parameters Hash",
      "type": "string"
    },
    "parameters_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Parameters Version",
      "type": "string"
    },
    "prompt_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Prompt Hash",
      "type": "string"
    },
    "prompt_name": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Prompt Name",
      "type": "string"
    },
    "prompt_version": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "report_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Report Version",
      "type": "string"
    },
    "schema_items_total": {
      "minimum": 1,
      "title": "Schema Items Total",
      "type": "integer"
    },
    "schema_items_valid": {
      "minimum": 0,
      "title": "Schema Items Valid",
      "type": "integer"
    },
    "schema_pass_rate": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Schema Pass Rate",
      "type": "number"
    },
    "unsupported_block_rate": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unsupported Block Rate"
    },
    "unsupported_items_blocked": {
      "minimum": 0,
      "title": "Unsupported Items Blocked",
      "type": "integer"
    },
    "unsupported_items_total": {
      "minimum": 0,
      "title": "Unsupported Items Total",
      "type": "integer"
    }
  },
  "required": [
    "benchmark_id",
    "benchmark_schema_version",
    "benchmark_version",
    "benchmark_scientific_payload_hash",
    "benchmark_content_hash",
    "prompt_name",
    "prompt_version",
    "prompt_hash",
    "model_name",
    "parameters_version",
    "parameters_hash",
    "cases",
    "schema_items_valid",
    "schema_items_total",
    "schema_pass_rate",
    "evidence_items_supported",
    "evidence_items_total",
    "unsupported_items_blocked",
    "unsupported_items_total",
    "human_review_sample_ids",
    "input_hash",
    "output_hash"
  ],
  "title": "PaperSummaryBenchmarkReport",
  "type": "object"
}
