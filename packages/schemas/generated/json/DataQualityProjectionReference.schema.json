{
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "type": "string"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Version"
    }
  },
  "required": [
    "id",
    "version",
    "content_hash"
  ],
  "title": "DataQualityProjectionReference",
  "type": "object"
}
