{
  "$defs": {
    "ConfidenceBand": {
      "enum": [
        "high",
        "medium",
        "low",
        "not_applicable"
      ],
      "title": "ConfidenceBand",
      "type": "string"
    },
    "CrossmatchMethod": {
      "enum": [
        "exact_identifier",
        "curated_entity_alias",
        "coordinate",
        "compound"
      ],
      "title": "CrossmatchMethod",
      "type": "string"
    },
    "EntityLevel": {
      "enum": [
        "host_star",
        "planet_candidate",
        "planet_assertion"
      ],
      "title": "EntityLevel",
      "type": "string"
    },
    "MatchDecision": {
      "enum": [
        "accepted",
        "rejected",
        "review_required",
        "conflict",
        "inconclusive",
        "unmatched"
      ],
      "title": "MatchDecision",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "condition_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Condition Ids",
      "type": "array"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "confidence_band": {
      "$ref": "#/$defs/ConfidenceBand"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/MatchDecision"
    },
    "edge_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Edge Id",
      "type": "string"
    },
    "entity_level": {
      "$ref": "#/$defs/EntityLevel"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "left_candidate_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Left Candidate Id",
      "type": "string"
    },
    "logical_match_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Logical Match Key",
      "type": "string"
    },
    "method": {
      "$ref": "#/$defs/CrossmatchMethod"
    },
    "right_candidate_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Right Candidate Id",
      "type": "string"
    }
  },
  "required": [
    "edge_id",
    "logical_match_key",
    "entity_level",
    "left_candidate_id",
    "right_candidate_id",
    "method",
    "decision",
    "confidence",
    "confidence_band",
    "condition_ids",
    "evidence_ids",
    "content_hash"
  ],
  "title": "CandidateEdge",
  "type": "object"
}
