{
  "$defs": {
    "BenchmarkDataType": {
      "description": "Provenance class of a benchmark document (fakes must never impersonate).",
      "enum": [
        "fixture",
        "golden",
        "recorded",
        "live"
      ],
      "title": "BenchmarkDataType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One Golden Set entry manifest (license/provenance governed).",
  "properties": {
    "availability": {
      "minLength": 1,
      "title": "Availability",
      "type": "string"
    },
    "case_key": {
      "minLength": 1,
      "title": "Case Key",
      "type": "string"
    },
    "content_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "coverage_tags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Coverage Tags",
      "type": "array"
    },
    "data_type": {
      "$ref": "#/$defs/BenchmarkDataType"
    },
    "doi_or_identifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi Or Identifier"
    },
    "entry_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Entry Id",
      "type": "string"
    },
    "license_note": {
      "minLength": 1,
      "title": "License Note",
      "type": "string"
    },
    "local_only": {
      "default": false,
      "title": "Local Only",
      "type": "boolean"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "entry_id",
    "case_key",
    "title",
    "data_type",
    "source",
    "license_note",
    "availability"
  ],
  "title": "GoldenSetEntry",
  "type": "object"
}
