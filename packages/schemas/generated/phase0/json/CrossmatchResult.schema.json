{
  "$defs": {
    "AdjudicationDecision": {
      "enum": [
        "accepted",
        "rejected",
        "keep_unresolved"
      ],
      "title": "AdjudicationDecision",
      "type": "string"
    },
    "CandidateEdge": {
      "additionalProperties": false,
      "properties": {
        "condition_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Condition Ids",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "confidence_band": {
          "$ref": "#/$defs/ConfidenceBand"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/MatchDecision"
        },
        "edge_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Edge Id",
          "type": "string"
        },
        "entity_level": {
          "$ref": "#/$defs/EntityLevel"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "left_candidate_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Left Candidate Id",
          "type": "string"
        },
        "logical_match_key": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Logical Match Key",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/CrossmatchMethod"
        },
        "right_candidate_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Right Candidate Id",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "logical_match_key",
        "entity_level",
        "left_candidate_id",
        "right_candidate_id",
        "method",
        "decision",
        "confidence",
        "confidence_band",
        "condition_ids",
        "evidence_ids",
        "content_hash"
      ],
      "title": "CandidateEdge",
      "type": "object"
    },
    "CanonicalIdentityValue": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "pattern": "^(planet|star|system)\\.[a-z][a-z0-9_]*$",
          "title": "Field Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/EvidenceLocator"
        },
        "normalization_rule_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Normalization Rule Version",
          "type": "string"
        },
        "normalized_value": {
          "minLength": 1,
          "title": "Normalized Value",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "normalized_value",
        "normalization_rule_version",
        "locator"
      ],
      "title": "CanonicalIdentityValue",
      "type": "object"
    },
    "ConditionOperator": {
      "enum": [
        "exact",
        "curated_alias",
        "angular_separation_lte",
        "angular_separation_gt",
        "contradicts",
        "source_scope"
      ],
      "title": "ConditionOperator",
      "type": "string"
    },
    "ConfidenceBand": {
      "enum": [
        "high",
        "medium",
        "low",
        "not_applicable"
      ],
      "title": "ConfidenceBand",
      "type": "string"
    },
    "ConfidenceDistribution": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "minimum": 0,
          "title": "High",
          "type": "integer"
        },
        "low": {
          "minimum": 0,
          "title": "Low",
          "type": "integer"
        },
        "medium": {
          "minimum": 0,
          "title": "Medium",
          "type": "integer"
        },
        "not_applicable": {
          "minimum": 0,
          "title": "Not Applicable",
          "type": "integer"
        }
      },
      "required": [
        "high",
        "medium",
        "low",
        "not_applicable"
      ],
      "title": "ConfidenceDistribution",
      "type": "object"
    },
    "ConflictGroup": {
      "additionalProperties": false,
      "properties": {
        "adjudicated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudicated At"
        },
        "adjudicated_by": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudicated By"
        },
        "adjudication": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdjudicationDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "adjudication_rationale": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudication Rationale"
        },
        "adjudication_rule_or_actor": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudication Rule Or Actor"
        },
        "conflict_code": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Conflict Code",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "decision": {
          "const": "conflict",
          "default": "conflict",
          "title": "Decision",
          "type": "string"
        },
        "entity_level": {
          "$ref": "#/$defs/EntityLevel"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "left_candidate_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Left Candidate Ids",
          "type": "array"
        },
        "logical_match_key": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Logical Match Key",
          "type": "string"
        },
        "manual_decision_content_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Decision Content Hash"
        },
        "manual_decision_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Decision Id"
        },
        "method": {
          "$ref": "#/$defs/CrossmatchMethod"
        },
        "record_type": {
          "const": "conflict_group",
          "default": "conflict_group",
          "title": "Record Type",
          "type": "string"
        },
        "reviewer_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewerKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "right_candidate_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Right Candidate Ids",
          "type": "array"
        }
      },
      "required": [
        "logical_match_key",
        "entity_level",
        "left_candidate_ids",
        "right_candidate_ids",
        "method",
        "conflict_code",
        "evidence_ids",
        "content_hash"
      ],
      "title": "ConflictGroup",
      "type": "object"
    },
    "CrossmatchCondition": {
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Condition Id",
          "type": "string"
        },
        "field_id": {
          "anyOf": [
            {
              "pattern": "^(planet|star|system)\\.[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Id"
        },
        "left_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Left Value"
        },
        "manual_review_threshold_arcsec": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Review Threshold Arcsec"
        },
        "operator": {
          "$ref": "#/$defs/ConditionOperator"
        },
        "right_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right Value"
        },
        "rule_reference": {
          "minLength": 1,
          "title": "Rule Reference",
          "type": "string"
        },
        "separation_arcsec": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Separation Arcsec"
        },
        "strict_threshold_arcsec": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strict Threshold Arcsec"
        }
      },
      "required": [
        "condition_id",
        "operator",
        "rule_reference"
      ],
      "title": "CrossmatchCondition",
      "type": "object"
    },
    "CrossmatchEvidence": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "items": {
            "$ref": "#/$defs/CrossmatchCondition"
          },
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "confidence_band": {
          "$ref": "#/$defs/ConfidenceBand"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/MatchDecision"
        },
        "entity_level": {
          "$ref": "#/$defs/EntityLevel"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "left_candidate_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Left Candidate Id",
          "type": "string"
        },
        "left_locators": {
          "items": {
            "$ref": "#/$defs/EvidenceLocator"
          },
          "minItems": 1,
          "title": "Left Locators",
          "type": "array"
        },
        "method": {
          "$ref": "#/$defs/CrossmatchMethod"
        },
        "right_candidate_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Right Candidate Id",
          "type": "string"
        },
        "right_locators": {
          "items": {
            "$ref": "#/$defs/EvidenceLocator"
          },
          "minItems": 1,
          "title": "Right Locators",
          "type": "array"
        },
        "rule_set_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Rule Set Content Hash",
          "type": "string"
        },
        "rule_set_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Rule Set Id",
          "type": "string"
        },
        "rule_set_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Rule Set Version",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "entity_level",
        "method",
        "decision",
        "confidence",
        "confidence_band",
        "left_candidate_id",
        "right_candidate_id",
        "left_locators",
        "right_locators",
        "conditions",
        "rule_set_id",
        "rule_set_version",
        "rule_set_content_hash",
        "content_hash"
      ],
      "title": "CrossmatchEvidence",
      "type": "object"
    },
    "CrossmatchMethod": {
      "enum": [
        "exact_identifier",
        "curated_entity_alias",
        "coordinate",
        "compound"
      ],
      "title": "CrossmatchMethod",
      "type": "string"
    },
    "CrossmatchMetrics": {
      "additionalProperties": false,
      "properties": {
        "ambiguous_group_count": {
          "minimum": 0,
          "title": "Ambiguous Group Count",
          "type": "integer"
        },
        "candidate_pair_count": {
          "minimum": 0,
          "title": "Candidate Pair Count",
          "type": "integer"
        },
        "confidence_distribution": {
          "$ref": "#/$defs/ConfidenceDistribution"
        },
        "conflict_group_count": {
          "minimum": 0,
          "title": "Conflict Group Count",
          "type": "integer"
        },
        "conflict_rate": {
          "$ref": "#/$defs/RatioMetric"
        },
        "error_example_references": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Error Example References",
          "type": "array"
        },
        "evidence_coverage": {
          "$ref": "#/$defs/RatioMetric"
        },
        "inconclusive_record_count": {
          "minimum": 0,
          "title": "Inconclusive Record Count",
          "type": "integer"
        },
        "left_candidate_count": {
          "minimum": 0,
          "title": "Left Candidate Count",
          "type": "integer"
        },
        "left_record_count": {
          "minimum": 0,
          "title": "Left Record Count",
          "type": "integer"
        },
        "low_confidence_count": {
          "minimum": 0,
          "title": "Low Confidence Count",
          "type": "integer"
        },
        "manual_adjudication_count": {
          "minimum": 0,
          "title": "Manual Adjudication Count",
          "type": "integer"
        },
        "manual_review_required_count": {
          "minimum": 0,
          "title": "Manual Review Required Count",
          "type": "integer"
        },
        "many_to_many_count": {
          "minimum": 0,
          "title": "Many To Many Count",
          "type": "integer"
        },
        "many_to_one_count": {
          "minimum": 0,
          "title": "Many To One Count",
          "type": "integer"
        },
        "match_coverage": {
          "$ref": "#/$defs/RatioMetric"
        },
        "matched_group_count": {
          "minimum": 0,
          "title": "Matched Group Count",
          "type": "integer"
        },
        "method_distribution": {
          "$ref": "#/$defs/MethodDistribution"
        },
        "one_to_many_count": {
          "minimum": 0,
          "title": "One To Many Count",
          "type": "integer"
        },
        "one_to_one_count": {
          "minimum": 0,
          "title": "One To One Count",
          "type": "integer"
        },
        "paired_group_count": {
          "minimum": 0,
          "title": "Paired Group Count",
          "type": "integer"
        },
        "right_candidate_count": {
          "minimum": 0,
          "title": "Right Candidate Count",
          "type": "integer"
        },
        "right_record_count": {
          "minimum": 0,
          "title": "Right Record Count",
          "type": "integer"
        },
        "unmatched_left_record_count": {
          "minimum": 0,
          "title": "Unmatched Left Record Count",
          "type": "integer"
        },
        "unmatched_rate": {
          "$ref": "#/$defs/RatioMetric"
        },
        "unmatched_record_count": {
          "minimum": 0,
          "title": "Unmatched Record Count",
          "type": "integer"
        },
        "unmatched_right_record_count": {
          "minimum": 0,
          "title": "Unmatched Right Record Count",
          "type": "integer"
        }
      },
      "required": [
        "left_record_count",
        "right_record_count",
        "left_candidate_count",
        "right_candidate_count",
        "candidate_pair_count",
        "paired_group_count",
        "matched_group_count",
        "ambiguous_group_count",
        "conflict_group_count",
        "unmatched_record_count",
        "unmatched_left_record_count",
        "unmatched_right_record_count",
        "inconclusive_record_count",
        "manual_review_required_count",
        "low_confidence_count",
        "manual_adjudication_count",
        "one_to_one_count",
        "one_to_many_count",
        "many_to_one_count",
        "many_to_many_count",
        "confidence_distribution",
        "method_distribution",
        "error_example_references",
        "match_coverage",
        "conflict_rate",
        "unmatched_rate",
        "evidence_coverage"
      ],
      "title": "CrossmatchMetrics",
      "type": "object"
    },
    "CrossmatchProducerExecution": {
      "additionalProperties": false,
      "properties": {
        "producer_name": {
          "minLength": 1,
          "title": "Producer Name",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Producer Version",
          "type": "string"
        },
        "rule_set_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Rule Set Content Hash",
          "type": "string"
        },
        "rule_set_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Rule Set Id",
          "type": "string"
        },
        "rule_set_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Rule Set Version",
          "type": "string"
        }
      },
      "required": [
        "producer_name",
        "producer_version",
        "rule_set_id",
        "rule_set_version",
        "rule_set_content_hash"
      ],
      "title": "CrossmatchProducerExecution",
      "type": "object"
    },
    "CrossmatchSide": {
      "enum": [
        "left",
        "right"
      ],
      "title": "CrossmatchSide",
      "type": "string"
    },
    "DataQueryCursor": {
      "additionalProperties": false,
      "properties": {
        "tid": {
          "minimum": 0,
          "title": "Tid",
          "type": "integer"
        },
        "toi": {
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
          "title": "Toi",
          "type": "string"
        }
      },
      "required": [
        "tid",
        "toi"
      ],
      "title": "DataQueryCursor",
      "type": "object"
    },
    "DataSourceCompletion": {
      "additionalProperties": false,
      "description": "Typed source-completion semantics consumed by downstream data stages.",
      "properties": {
        "continuation_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataQueryCursor"
            },
            {
              "$ref": "#/$defs/SupplementalDataQueryCursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Continuation Cursor"
        },
        "status": {
          "$ref": "#/$defs/DataSourceCompletionStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "DataSourceCompletion",
      "type": "object"
    },
    "DataSourceCompletionStatus": {
      "description": "Whether the bounded acquisition proved that its source scope is complete.",
      "enum": [
        "complete",
        "truncated",
        "unknown"
      ],
      "title": "DataSourceCompletionStatus",
      "type": "string"
    },
    "DataSourceDataLevel": {
      "description": "Acquisition evidence level, kept separate from the source origin.",
      "enum": [
        "live_result",
        "recorded_response",
        "fixture",
        "seed"
      ],
      "title": "DataSourceDataLevel",
      "type": "string"
    },
    "EntityCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "coordinate": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkyCoordinate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entity_level": {
          "$ref": "#/$defs/EntityLevel"
        },
        "identity_values": {
          "items": {
            "$ref": "#/$defs/CanonicalIdentityValue"
          },
          "minItems": 1,
          "title": "Identity Values",
          "type": "array"
        },
        "side": {
          "$ref": "#/$defs/CrossmatchSide"
        },
        "source_record": {
          "$ref": "#/$defs/SourceRecordReference"
        }
      },
      "required": [
        "candidate_id",
        "side",
        "entity_level",
        "source_record",
        "identity_values",
        "content_hash"
      ],
      "title": "EntityCandidate",
      "type": "object"
    },
    "EntityLevel": {
      "enum": [
        "host_star",
        "planet_candidate",
        "planet_assertion"
      ],
      "title": "EntityLevel",
      "type": "string"
    },
    "EvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "query_hash": {
