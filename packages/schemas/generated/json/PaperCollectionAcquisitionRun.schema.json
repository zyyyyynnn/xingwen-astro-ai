{
  "additionalProperties": false,
  "description": "Pipeline-local acquisition execution, never a ResearchRun state owner.",
  "properties": {
    "acquisition_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Acquisition Id",
      "type": "string"
    },
    "candidate_count": {
      "minimum": 0,
      "title": "Candidate Count",
      "type": "integer"
    },
    "duplicate_group_count": {
      "minimum": 0,
      "title": "Duplicate Group Count",
      "type": "integer"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "selected_count": {
      "minimum": 0,
      "title": "Selected Count",
      "type": "integer"
    },
    "source_failure_count": {
      "minimum": 0,
      "title": "Source Failure Count",
      "type": "integer"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "acquisition_id",
    "status",
    "started_at",
    "finished_at",
    "candidate_count",
    "duplicate_group_count",
    "selected_count",
    "source_failure_count"
  ],
  "title": "PaperCollectionAcquisitionRun",
  "type": "object"
}
