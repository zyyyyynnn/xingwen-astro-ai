{
  "$defs": {
    "SourceColumnContractReference": {
      "additionalProperties": false,
      "description": "Immutable reference to the evidence-backed source-column adjudication.",
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "snapshot_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Snapshot Version",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "snapshot_version",
        "path",
        "content_hash"
      ],
      "title": "SourceColumnContractReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An approved source table declaration; it performs no I/O.",
  "properties": {
    "approved_columns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Approved Columns",
      "type": "array"
    },
    "column_contract": {
      "$ref": "#/$defs/SourceColumnContractReference"
    },
    "declaration_mode": {
      "const": "metadata_only",
      "default": "metadata_only",
      "title": "Declaration Mode",
      "type": "string"
    },
    "documentation_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Documentation Url",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "provenance_columns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Provenance Columns",
      "type": "array"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "provider_source_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Provider Source Id",
      "type": "string"
    },
    "reference_columns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Reference Columns",
      "type": "array"
    },
    "row_key_fields": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Row Key Fields",
      "type": "array"
    },
    "source_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Source Id",
      "type": "string"
    },
    "source_table": {
      "minLength": 1,
      "title": "Source Table",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "provider_source_id",
    "provider",
    "name",
    "source_table",
    "documentation_url",
    "approved_columns",
    "row_key_fields",
    "reference_columns",
    "provenance_columns",
    "column_contract"
  ],
  "title": "SourceDefinition",
  "type": "object"
}
