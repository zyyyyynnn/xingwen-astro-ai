{
  "$defs": {
    "CrossmatchSourceOriginPolicy": {
      "additionalProperties": false,
      "properties": {
        "data_levels": {
          "items": {
            "$ref": "#/$defs/DataSourceDataLevel"
          },
          "minItems": 1,
          "title": "Data Levels",
          "type": "array"
        },
        "source_mode": {
          "$ref": "#/$defs/SourceMode"
        }
      },
      "required": [
        "source_mode",
        "data_levels"
      ],
      "title": "CrossmatchSourceOriginPolicy",
      "type": "object"
    },
    "DataSourceCompletionStatus": {
      "description": "Whether the bounded acquisition proved that its source scope is complete.",
      "enum": [
        "complete",
        "truncated",
        "unknown"
      ],
      "title": "DataSourceCompletionStatus",
      "type": "string"
    },
    "DataSourceDataLevel": {
      "description": "Acquisition evidence level, kept separate from the source origin.",
      "enum": [
        "live_result",
        "recorded_response",
        "fixture",
        "seed"
      ],
      "title": "DataSourceDataLevel",
      "type": "string"
    },
    "SourceMode": {
      "description": "Actual origin of an ArtifactVersion-compatible pipeline payload.",
      "enum": [
        "fixture",
        "live",
        "cached"
      ],
      "title": "SourceMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_origins": {
      "items": {
        "$ref": "#/$defs/CrossmatchSourceOriginPolicy"
      },
      "minItems": 1,
      "title": "Allowed Origins",
      "type": "array"
    },
    "completion_statuses": {
      "items": {
        "$ref": "#/$defs/DataSourceCompletionStatus"
      },
      "minItems": 1,
      "title": "Completion Statuses",
      "type": "array"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "policy_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Policy Id",
      "type": "string"
    },
    "version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "version",
    "allowed_origins",
    "completion_statuses",
    "content_hash"
  ],
  "title": "CrossmatchSourcePolicy",
  "type": "object"
}
