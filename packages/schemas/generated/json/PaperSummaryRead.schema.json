{
  "$defs": {
    "EvidenceDetail": {
      "additionalProperties": false,
      "description": "Evidence bound to one immutable version and source snapshot.",
      "properties": {
        "artifact_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Version Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evidence Type",
          "type": "string"
        },
        "extraction_method": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Extraction Method",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Locator",
          "type": "object"
        },
        "paper_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Id"
        },
        "quote_or_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "target_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "target_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "artifact_version_id",
        "target_type",
        "target_id",
        "evidence_type",
        "source_snapshot_id",
        "locator",
        "extraction_method",
        "confidence",
        "created_at"
      ],
      "title": "EvidenceDetail",
      "type": "object"
    },
    "JsonValue": {},
    "PaperBenchmarkReference": {
      "additionalProperties": false,
      "properties": {
        "benchmark_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Benchmark Id",
          "type": "string"
        },
        "benchmark_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Benchmark Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Scenario Id",
          "type": "string"
        },
        "schema_version": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_payload_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Scientific Payload Hash",
          "type": "string"
        },
        "x00_main_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "X00 Main Sha",
          "type": "string"
        }
      },
      "required": [
        "benchmark_id",
        "schema_version",
        "benchmark_version",
        "scientific_payload_hash",
        "content_hash",
        "scenario_id",
        "x00_main_sha"
      ],
      "title": "PaperBenchmarkReference",
      "type": "object"
    },
    "PaperSummaryArtifactContent": {
      "additionalProperties": false,
      "description": "Publisher-ready D-03 content used directly by the core Artifact discriminator.",
      "properties": {
        "benchmark": {
          "$ref": "#/$defs/PaperBenchmarkReference"
        },
        "dataset": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaperSummaryStatement"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/PaperSummaryEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/PaperSummaryStatement"
          },
          "title": "Findings",
          "type": "array"
        },
        "future_work": {
          "items": {
            "$ref": "#/$defs/PaperSummaryStatement"
          },
          "title": "Future Work",
          "type": "array"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "input_versions": {
          "$ref": "#/$defs/PaperSummaryInputVersions"
        },
        "kind": {
          "const": "paper_summary",
          "title": "Kind",
          "type": "string"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/PaperSummaryStatement"
          },
          "title": "Limitations",
          "type": "array"
        },
        "method": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaperSummaryStatement"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "paper_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Paper Id",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/PaperSummaryProducerExecution"
        },
        "research_goal": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaperSummaryStatement"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_conflicts": {
          "items": {
            "$ref": "#/$defs/PaperSummarySourceConflict"
          },
          "title": "Source Conflicts",
          "type": "array"
        },
        "summary_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Summary Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "summary_id",
        "paper_id",
        "benchmark",
        "input_versions",
        "research_goal",
        "method",
        "dataset",
        "findings",
        "limitations",
        "future_work",
        "evidence_ids",
        "evidence",
        "source_conflicts",
        "producer",
        "input_hash",
        "output_hash"
      ],
      "title": "PaperSummaryArtifactContent",
      "type": "object"
    },
    "PaperSummaryCacheAudit": {
      "additionalProperties": false,
      "description": "Why a cached source was used and the immutable origin it came from.",
      "properties": {
        "cache_applicability": {
          "minLength": 1,
          "title": "Cache Applicability",
          "type": "string"
        },
        "cache_version": {
          "minLength": 1,
          "title": "Cache Version",
          "type": "string"
        },
        "live_failure_class": {
          "$ref": "#/$defs/UpstreamFailureClass"
        },
        "live_failure_code": {
          "minLength": 1,
          "title": "Live Failure Code",
          "type": "string"
        },
        "origin_artifact_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Origin Artifact Version Id",
          "type": "string"
        },
        "origin_run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Origin Run Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_snapshot_id",
        "cache_version",
        "cache_applicability",
        "live_failure_class",
        "live_failure_code",
        "origin_run_id",
        "origin_artifact_version_id"
      ],
      "title": "PaperSummaryCacheAudit",
      "type": "object"
    },
    "PaperSummaryEvidence": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/PaperSummaryEvidenceLocator"
        },
        "paper_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Paper Id",
          "type": "string"
        },
        "quote_or_value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Quote Or Value",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_record_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "source_snapshot_content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Snapshot Content Hash",
          "type": "string"
        },
        "source_snapshot_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "source_snapshot_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Snapshot Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PaperSummarySupportStatus"
        },
        "validation_code": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Validation Code",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "paper_id",
        "candidate_id",
        "source_id",
        "source_record_id",
        "source_snapshot_id",
        "source_snapshot_version",
        "source_snapshot_content_hash",
        "locator",
        "quote_or_value",
        "status",
        "validation_code"
      ],
      "title": "PaperSummaryEvidence",
      "type": "object"
    },
    "PaperSummaryEvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "paper_text",
            "paper_metadata"
          ],
          "title": "Kind",
          "type": "string"
        },
        "metadata_field": {
          "anyOf": [
            {
              "enum": [
                "source_record_id",
                "title",
                "authors",
                "year",
                "doi",
                "arxiv_id",
                "url"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Field"
        },
        "paragraph": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "text_range": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Range"
        }
      },
      "required": [
        "kind",
        "source_url"
      ],
      "title": "PaperSummaryEvidenceLocator",
      "type": "object"
    },
    "PaperSummaryInputVersions": {
      "additionalProperties": false,
      "properties": {
        "paper_collection_output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
