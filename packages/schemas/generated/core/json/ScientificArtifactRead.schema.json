{
  "$defs": {
    "AnalysisReportArtifactContent": {
      "additionalProperties": false,
      "description": "Evidence-backed result of one or more bounded analysis skills.",
      "properties": {
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScientificFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "human_required": {
          "default": [],
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Human Required",
          "type": "array"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "kind": {
          "const": "analysis_report",
          "default": "analysis_report",
          "title": "Kind",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "metrics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScientificMetric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "related_artifact_version_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Related Artifact Version Ids",
          "type": "array"
        },
        "report_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Report Id",
          "type": "string"
        },
        "result_blocks": {
          "items": {
            "$ref": "#/$defs/ScientificResultBlock"
          },
          "minItems": 1,
          "title": "Result Blocks",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScientificEvidence"
          },
          "title": "Scientific Evidence",
          "type": "array"
        },
        "skill_executions": {
          "items": {
            "$ref": "#/$defs/ScientificSkillExecution"
          },
          "minItems": 1,
          "title": "Skill Executions",
          "type": "array"
        },
        "source_snapshot_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "title",
        "summary",
        "skill_executions",
        "result_blocks",
        "source_snapshot_ids",
        "evidence_ids",
        "input_hash",
        "output_hash"
      ],
      "title": "AnalysisReportArtifactContent",
      "type": "object"
    },
    "ChartAxis": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "scale": {
          "default": "linear",
          "enum": [
            "linear",
            "log",
            "time",
            "category"
          ],
          "title": "Scale",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "field",
        "label"
      ],
      "title": "ChartAxis",
      "type": "object"
    },
    "ChartPoint": {
      "additionalProperties": false,
      "description": "One bounded, publication-owned datum for a declarative chart.",
      "properties": {
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Y"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "ChartPoint",
      "type": "object"
    },
    "ChartSeries": {
      "additionalProperties": false,
      "properties": {
        "color_token": {
          "default": "brand",
          "enum": [
            "brand",
            "information",
            "success",
            "warning",
            "error",
            "neutral"
          ],
          "title": "Color Token",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "mark": {
          "enum": [
            "line",
            "point",
            "bar",
            "area"
          ],
          "title": "Mark",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/ChartPoint"
          },
          "maxItems": 2000,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "series_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Series Id",
          "type": "string"
        },
        "x_field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "X Field",
          "type": "string"
        },
        "y_field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Y Field",
          "type": "string"
        }
      },
      "required": [
        "series_id",
        "label",
        "x_field",
        "y_field",
        "mark",
        "points"
      ],
      "title": "ChartSeries",
      "type": "object"
    },
    "ChartVisualizationSpec": {
      "additionalProperties": false,
      "properties": {
        "dataset_artifact_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Dataset Artifact Version Id",
          "type": "string"
        },
        "mode": {
          "const": "chart",
          "default": "chart",
          "title": "Mode",
          "type": "string"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/ChartSeries"
          },
          "minItems": 1,
          "title": "Series",
          "type": "array"
        },
        "x_axis": {
          "$ref": "#/$defs/ChartAxis"
        },
        "y_axis": {
          "$ref": "#/$defs/ChartAxis"
        }
      },
      "required": [
        "dataset_artifact_version_id",
        "x_axis",
        "y_axis",
        "series"
      ],
      "title": "ChartVisualizationSpec",
      "type": "object"
    },
    "EvidenceDetail": {
      "additionalProperties": false,
      "description": "Evidence bound to one immutable version and source snapshot.",
      "properties": {
        "artifact_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Version Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evidence Type",
          "type": "string"
        },
        "extraction_method": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Extraction Method",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Locator",
          "type": "object"
        },
        "paper_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Id"
        },
        "quote_or_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "target_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "target_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "artifact_version_id",
        "target_type",
        "target_id",
        "evidence_type",
        "source_snapshot_id",
        "locator",
        "extraction_method",
        "confidence",
        "created_at"
      ],
      "title": "EvidenceDetail",
      "type": "object"
    },
    "FitsImageVisualizationSpec": {
      "additionalProperties": false,
      "properties": {
        "color_map": {
          "default": "gray",
          "enum": [
            "gray",
            "viridis",
            "magma",
            "inferno"
          ],
          "title": "Color Map",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "content_ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Content Ref",
          "type": "string"
        },
        "mode": {
          "const": "fits_image",
          "default": "fits_image",
          "title": "Mode",
          "type": "string"
        },
        "source_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "stretch": {
          "default": "sqrt",
          "enum": [
            "linear",
            "sqrt",
            "log",
            "power",
            "histogram_equalization"
          ],
          "title": "Stretch",
          "type": "string"
        }
      },
      "required": [
        "source_snapshot_id",
        "content_ref",
        "content_hash"
      ],
      "title": "FitsImageVisualizationSpec",
      "type": "object"
    },
    "JsonValue": {},
    "ModelBinaryReference": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "content_ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Content Ref",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "application/onnx",
            "application/vnd.sklearn",
            "application/octet-stream"
          ],
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "content_ref",
        "content_hash",
        "media_type"
      ],
      "title": "ModelBinaryReference",
      "type": "object"
    },
    "ModelDiagnosticVisualizationSpec": {
      "additionalProperties": false,
      "properties": {
        "diagnostic": {
          "enum": [
            "confusion_matrix",
            "roc_curve",
            "precision_recall",
            "residuals",
            "forecast",
            "feature_importance"
          ],
          "title": "Diagnostic",
          "type": "string"
        },
        "mode": {
          "const": "model_diagnostic",
          "default": "model_diagnostic",
          "title": "Mode",
          "type": "string"
        },
        "model_evaluation_artifact_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Model Evaluation Artifact Version Id",
          "type": "string"
        }
      },
      "required": [
        "model_evaluation_artifact_version_id",
        "diagnostic"
      ],
      "title": "ModelDiagnosticVisualizationSpec",
      "type": "object"
    },
    "ModelEvaluationArtifactContent": {
      "additionalProperties": false,
      "description": "Reproducible evaluation metadata for a bounded scientific model task.",
      "properties": {
        "algorithm": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Algorithm",
          "type": "string"
        },
        "algorithm_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Algorithm Version",
          "type": "string"
        },
        "baseline_metrics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScientificMetric"
          },
          "title": "Baseline Metrics",
          "type": "array"
        },
        "dataset_artifact_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Dataset Artifact Version Id",
          "type": "string"
        },
        "diagnostic_visualization_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Diagnostic Visualization Ids",
          "type": "array"
        },
        "evaluation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evaluation Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "feature_fields": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Feature Fields",
          "type": "array"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "kind": {
          "const": "model_evaluation",
          "default": "model_evaluation",
          "title": "Kind",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/ScientificMetric"
          },
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "model_binary": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelBinaryReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ScientificEvidence"
          },
          "title": "Scientific Evidence",
          "type": "array"
        },
        "skill_execution": {
          "$ref": "#/$defs/ScientificSkillExecution"
        },
        "source_snapshot_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "split": {
          "$ref": "#/$defs/ModelSplitReference"
        },
        "target_field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Field",
          "type": "string"
        },
        "task_kind": {
          "$ref": "#/$defs/ModelTaskKind"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "evaluation_id",
        "title",
        "task_kind",
        "algorithm",
        "algorithm_version",
        "dataset_artifact_version_id",
        "feature_fields",
        "target_field",
        "split",
        "metrics",
        "skill_execution",
        "source_snapshot_ids",
        "evidence_ids",
        "input_hash",
        "output_hash"
      ],
      "title": "ModelEvaluationArtifactContent",
      "type": "object"
    },
    "ModelSplitReference": {
      "additionalProperties": false,
      "properties": {
        "random_seed": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Random Seed"
        },
        "strategy": {
          "enum": [
            "holdout",
            "stratified_holdout",
            "time_ordered"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "test_fraction": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Test Fraction",
          "type": "number"
        },
        "train_fraction": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Train Fraction",
          "type": "number"
        },
        "validation_fraction": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Validation Fraction",
          "type": "number"
        }
      },
      "required": [
        "strategy",
        "train_fraction",
        "validation_fraction",
        "test_fraction"
      ],
      "title": "ModelSplitReference",
      "type": "object"
    },
    "ModelTaskKind": {
      "enum": [
        "classification",
        "regression",
        "forecast",
        "image_classification"
      ],
      "title": "ModelTaskKind",
      "type": "string"
    },
    "ProducerExecutionDetail": {
      "additionalProperties": false,
