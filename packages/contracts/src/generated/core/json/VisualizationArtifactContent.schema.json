{
  "$defs": {
    "ChartAxis": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "scale": {
          "default": "linear",
          "enum": [
            "linear",
            "log",
            "time",
            "category"
          ],
          "title": "Scale",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "field",
        "label"
      ],
      "title": "ChartAxis",
      "type": "object"
    },
    "ChartPoint": {
      "additionalProperties": false,
      "description": "One bounded, publication-owned datum for a declarative chart.",
      "properties": {
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Y"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "ChartPoint",
      "type": "object"
    },
    "ChartSeries": {
      "additionalProperties": false,
      "properties": {
        "color_token": {
          "default": "brand",
          "enum": [
            "brand",
            "information",
            "success",
            "warning",
            "error",
            "neutral"
          ],
          "title": "Color Token",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "mark": {
          "enum": [
            "line",
            "point",
            "bar",
            "area"
          ],
          "title": "Mark",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/ChartPoint"
          },
          "maxItems": 2000,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "series_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Series Id",
          "type": "string"
        },
        "x_field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "X Field",
          "type": "string"
        },
        "y_field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Y Field",
          "type": "string"
        }
      },
      "required": [
        "series_id",
        "label",
        "x_field",
        "y_field",
        "mark",
        "points"
      ],
      "title": "ChartSeries",
      "type": "object"
    },
    "ChartVisualizationSpec": {
      "additionalProperties": false,
      "properties": {
        "dataset_artifact_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Dataset Artifact Version Id",
          "type": "string"
        },
        "mode": {
          "const": "chart",
          "default": "chart",
          "title": "Mode",
          "type": "string"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/ChartSeries"
          },
          "minItems": 1,
          "title": "Series",
          "type": "array"
        },
        "x_axis": {
          "$ref": "#/$defs/ChartAxis"
        },
        "y_axis": {
          "$ref": "#/$defs/ChartAxis"
        }
      },
      "required": [
        "dataset_artifact_version_id",
        "x_axis",
        "y_axis",
        "series"
      ],
      "title": "ChartVisualizationSpec",
      "type": "object"
    },
    "FitsImageVisualizationSpec": {
      "additionalProperties": false,
      "properties": {
        "color_map": {
          "default": "gray",
          "enum": [
            "gray",
            "viridis",
            "magma",
            "inferno"
          ],
          "title": "Color Map",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "content_ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Content Ref",
          "type": "string"
        },
        "mode": {
          "const": "fits_image",
          "default": "fits_image",
          "title": "Mode",
          "type": "string"
        },
        "source_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "stretch": {
          "default": "sqrt",
          "enum": [
            "linear",
            "sqrt",
            "log",
            "power",
            "histogram_equalization"
          ],
          "title": "Stretch",
          "type": "string"
        }
      },
      "required": [
        "source_snapshot_id",
        "content_ref",
        "content_hash"
      ],
      "title": "FitsImageVisualizationSpec",
      "type": "object"
    },
    "JsonValue": {},
    "ModelDiagnosticVisualizationSpec": {
      "additionalProperties": false,
      "properties": {
        "diagnostic": {
          "enum": [
            "confusion_matrix",
            "roc_curve",
            "precision_recall",
            "residuals",
            "forecast",
            "feature_importance"
          ],
          "title": "Diagnostic",
          "type": "string"
        },
        "mode": {
          "const": "model_diagnostic",
          "default": "model_diagnostic",
          "title": "Mode",
          "type": "string"
        },
        "model_evaluation_artifact_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Model Evaluation Artifact Version Id",
          "type": "string"
        }
      },
      "required": [
        "model_evaluation_artifact_version_id",
        "diagnostic"
      ],
      "title": "ModelDiagnosticVisualizationSpec",
      "type": "object"
    },
    "ScientificEvidence": {
      "additionalProperties": false,
      "description": "Evidence materialized with a newly published scientific ArtifactVersion.",
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "service_response",
            "input_snapshot",
            "computation"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "extraction_method": {
          "const": "registered_scientific_skill",
          "default": "registered_scientific_skill",
          "title": "Extraction Method",
          "type": "string"
        },
        "locator": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Locator",
          "type": "object"
        },
        "quote_or_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "target_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "target_type": {
          "enum": [
            "result_block",
            "metric",
            "visualization",
            "spectrum",
            "light_curve",
            "evaluation",
            "model"
          ],
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "target_type",
        "target_id",
        "source_snapshot_id",
        "evidence_type",
        "locator"
      ],
      "title": "ScientificEvidence",
      "type": "object"
    },
    "ScientificSkillExecution": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "execution_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Execution Id",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "output_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "skill_id": {
          "$ref": "#/$defs/ScientificSkillId"
        },
        "skill_revision": {
          "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
          "title": "Skill Revision",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ScientificSkillStatus"
        },
        "warnings": {
          "default": [],
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "execution_id",
        "skill_id",
        "skill_revision",
        "status",
        "input_hash",
        "duration_ms"
      ],
      "title": "ScientificSkillExecution",
      "type": "object"
    },
    "ScientificSkillId": {
      "enum": [
        "catalog_crossmatch",
        "data_profile",
        "statistical_analysis",
        "correlation_analysis",
        "clustering_analysis",
        "anomaly_detection",
        "chart_visualization",
        "simbad_lookup",
        "skyview_fits",
        "ephemeris",
        "celestial_events",
        "gaia_cone_search",
        "vizier_tap",
        "fits_image_analysis",
        "spectrum_analysis",
        "spectrum_acquisition",
        "light_curve_analysis",
        "light_curve_acquisition",
        "tabular_machine_learning",
        "time_series_classification",
        "time_series_forecast",
        "image_classification",
        "model_inference",
        "wwt_scene"
      ],
      "title": "ScientificSkillId",
      "type": "string"
    },
    "ScientificSkillStatus": {
      "enum": [
        "completed",
        "partial",
        "unsupported",
        "failed"
      ],
      "title": "ScientificSkillStatus",
      "type": "string"
    },
    "WwtAnnotation": {
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Annotation Id",
          "type": "string"
        },
        "color_token": {
          "default": "brand",
          "enum": [
            "brand",
            "information",
            "success",
            "warning",
            "error",
            "neutral"
          ],
          "title": "Color Token",
          "type": "string"
        },
        "fill": {
          "default": false,
          "title": "Fill",
          "type": "boolean"
        },
        "fill_color_token": {
          "default": "brand",
          "enum": [
            "brand",
            "information",
            "success",
            "warning",
            "error",
            "neutral"
          ],
          "title": "Fill Color Token",
          "type": "string"
        },
        "kind": {
          "enum": [
            "circle",
            "line",
            "point",
            "label"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "line_width": {
          "default": 2,
          "exclusiveMinimum": 0,
          "maximum": 20,
          "title": "Line Width",
          "type": "number"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/WwtCoordinate"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        },
        "radius_degrees": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Radius Degrees"
        }
      },
      "required": [
        "annotation_id",
        "kind",
        "points"
      ],
      "title": "WwtAnnotation",
      "type": "object"
    },
    "WwtCartesianTableCoordinates": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "enum": [
            "sun",
            "mercury",
            "venus",
            "earth",
            "moon",
            "mars",
            "jupiter",
            "saturn",
            "uranus",
            "neptune",
            "pluto"
          ],
          "title": "Frame",
          "type": "string"
        },
        "kind": {
          "const": "cartesian",
          "default": "cartesian",
          "title": "Kind",
          "type": "string"
        },
        "x_field": {
          "maxLength": 256,
          "minLength": 1,
          "title": "X Field",
          "type": "string"
        },
        "xyz_unit": {
          "enum": [
            "m",
            "km",
            "au",
            "pc",
            "kpc",
            "mpc"
          ],
          "title": "Xyz Unit",
          "type": "string"
        },
        "y_field": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Y Field",
          "type": "string"
        },
        "z_field": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Z Field",
          "type": "string"
        }
      },
      "required": [
        "frame",
        "x_field",
        "y_field",
        "z_field",
        "xyz_unit"
      ],
      "title": "WwtCartesianTableCoordinates",
      "type": "object"
    },
    "WwtConstellationOverlays": {
      "additionalProperties": false,
      "properties": {
        "boundaries": {
          "default": false,
          "title": "Boundaries",
          "type": "boolean"
        },
        "figures": {
          "default": false,
          "title": "Figures",
          "type": "boolean"
        },
        "labels": {
          "default": false,
          "title": "Labels",
          "type": "boolean"
        },
        "pictures": {
          "default": false,
          "title": "Pictures",
          "type": "boolean"
        }
      },
      "title": "WwtConstellationOverlays",
      "type": "object"
    },
    "WwtCoordinate": {
      "additionalProperties": false,
      "properties": {
        "dec_degrees": {
          "maximum": 90,
          "minimum": -90,
          "title": "Dec Degrees",
          "type": "number"
        },
        "ra_hours": {
          "exclusiveMaximum": 24,
          "minimum": 0,
          "title": "Ra Hours",
          "type": "number"
        }
      },
      "required": [
        "ra_hours",
        "dec_degrees"
      ],
      "title": "WwtCoordinate",
      "type": "object"
    },
    "WwtCoordinateGrid": {
      "additionalProperties": false,
      "properties": {
        "labels": {
          "default": true,
          "title": "Labels",
          "type": "boolean"
        },
        "system": {
          "enum": [
            "equatorial",
            "galactic",
            "ecliptic",
            "altaz"
          ],
          "title": "System",
          "type": "string"
        }
      },
      "required": [
        "system"
      ],
      "title": "WwtCoordinateGrid",
      "type": "object"
    },
    "WwtCoordinateView": {
      "additionalProperties": false,
      "properties": {
        "center": {
          "$ref": "#/$defs/WwtCoordinate"
        },
        "field_of_view_degrees": {
          "exclusiveMinimum": 0,
          "maximum": 180,
          "title": "Field Of View Degrees",
          "type": "number"
        },
        "kind": {
          "const": "coordinates",
          "default": "coordinates",
          "title": "Kind",
          "type": "string"
        },
        "roll_degrees": {
          "default": 0,
          "maximum": 180,
          "minimum": -180,
          "title": "Roll Degrees",
          "type": "number"
        },
        "transition_seconds": {
          "default": 0,
          "maximum": 120,
          "minimum": 0,
          "title": "Transition Seconds",
          "type": "number"
        }
      },
      "required": [
        "center",
        "field_of_view_degrees"
      ],
      "title": "WwtCoordinateView",
      "type": "object"
    },
    "WwtFitsLayer": {
      "additionalProperties": false,
      "properties": {
        "color_map": {
          "default": "gray",
          "enum": [
            "gray",
            "viridis",
            "magma",
            "inferno"
          ],
          "title": "Color Map",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "content_ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Content Ref",
          "type": "string"
        },
        "layer_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Layer Id",
          "type": "string"
        },
        "opacity": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "source_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "stretch": {
          "default": "sqrt",
          "enum": [
            "linear",
            "sqrt",
            "log",
            "power",
            "histogram_equalization"
          ],
          "title": "Stretch",
          "type": "string"
        },
        "vmax": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vmax"
        },
        "vmin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vmin"
        }
      },
      "required": [
        "layer_id",
        "source_snapshot_id",
        "content_ref",
        "content_hash"
      ],
      "title": "WwtFitsLayer",
      "type": "object"
    },
    "WwtForeground": {
      "additionalProperties": false,
      "properties": {
        "image_set": {
          "enum": [
            "digitized_sky_survey",
            "gaia",
            "wise"
          ],
          "title": "Image Set",
          "type": "string"
        },
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        }
      },
      "required": [
        "image_set"
      ],
      "title": "WwtForeground",
      "type": "object"
    },
    "WwtObserver": {
      "additionalProperties": false,
      "properties": {
        "elevation_meters": {
          "default": 0,
          "maximum": 100000,
          "minimum": -500,
          "title": "Elevation Meters",
          "type": "number"
        },
        "latitude_degrees": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude Degrees",
          "type": "number"
        },
        "local_horizon_mode": {
          "default": false,
          "title": "Local Horizon Mode",
          "type": "boolean"
        },
        "longitude_degrees": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude Degrees",
          "type": "number"
        }
      },
      "required": [
        "latitude_degrees",
        "longitude_degrees"
      ],
      "title": "WwtObserver",
      "type": "object"
    },
    "WwtSceneStep": {
      "additionalProperties": false,
      "properties": {
        "hold_seconds": {
          "default": 0,
          "maximum": 3600,
          "minimum": 0,
          "title": "Hold Seconds",
          "type": "number"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "step_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        },
        "view": {
          "discriminator": {
            "mapping": {
              "coordinates": "#/$defs/WwtCoordinateView",
              "tracked_object": "#/$defs/WwtTrackedObjectView"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/WwtCoordinateView"
            },
            {
              "$ref": "#/$defs/WwtTrackedObjectView"
            }
          ],
          "title": "View"
        }
      },
      "required": [
        "step_id",
        "view"
      ],
      "title": "WwtSceneStep",
      "type": "object"
    },
    "WwtSceneVisualizationSpec": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WwtAnnotation"
          },
          "maxItems": 1000,
          "title": "Annotations",
          "type": "array"
        },
        "background": {
          "default": "digitized_sky_survey",
          "enum": [
            "digitized_sky_survey",
            "gaia",
            "wise",
            "solar_system"
          ],
          "title": "Background",
          "type": "string"
        },
        "constellations": {
          "$ref": "#/$defs/WwtConstellationOverlays"
        },
        "coordinate_grids": {
          "default": [
            {
              "labels": true,
              "system": "equatorial"
            }
          ],
          "items": {
            "$ref": "#/$defs/WwtCoordinateGrid"
          },
          "maxItems": 4,
          "title": "Coordinate Grids",
          "type": "array"
        },
        "fits_layers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WwtFitsLayer"
          },
          "maxItems": 64,
          "title": "Fits Layers",
          "type": "array"
        },
        "foreground": {
          "anyOf": [
            {
              "$ref": "#/$defs/WwtForeground"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode": {
          "const": "wwt_scene",
          "default": "wwt_scene",
          "title": "Mode",
          "type": "string"
        },
        "observer": {
