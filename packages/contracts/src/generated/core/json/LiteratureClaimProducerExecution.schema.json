{
  "$defs": {
    "LiteratureClaimInputVersions": {
      "additionalProperties": false,
      "description": "Trace retained even when the requested Summary version cannot be resolved.",
      "properties": {
        "paper_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Paper Id",
          "type": "string"
        },
        "paper_summary_artifact_version_id": {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Paper Summary Artifact Version Id",
          "type": "string"
        },
        "paper_summary_output_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Summary Output Hash"
        },
        "paper_summary_schema_version": {
          "anyOf": [
            {
              "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Summary Schema Version"
        },
        "source_snapshots": {
          "items": {
            "$ref": "#/$defs/PaperSummarySourceSnapshotReference"
          },
          "title": "Source Snapshots",
          "type": "array"
        },
        "summary_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary Id"
        }
      },
      "required": [
        "paper_summary_artifact_version_id",
        "paper_id",
        "source_snapshots"
      ],
      "title": "LiteratureClaimInputVersions",
      "type": "object"
    },
    "LiteratureClaimRejectionReason": {
      "enum": [
        "literature_claim.json_invalid",
        "literature_claim.schema_invalid",
        "literature_claim.input_artifact_version_unknown",
        "literature_claim.input_schema_version_unsupported",
        "literature_claim.evidence_missing",
        "literature_claim.evidence_not_found",
        "literature_claim.source_snapshot_not_found",
        "literature_claim.ownership_mismatch",
        "literature_claim.normalization_unsafe",
        "literature_claim.duplicate"
      ],
      "title": "LiteratureClaimRejectionReason",
      "type": "string"
    },
    "PaperSummarySourceSnapshotReference": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_snapshot_id": {
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "source_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
        "source_snapshot_id",
        "source_id",
        "source_version",
        "content_hash"
      ],
      "title": "PaperSummarySourceSnapshotReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/LiteratureClaimRejectionReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution_id": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Execution Id",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "input_versions": {
      "$ref": "#/$defs/LiteratureClaimInputVersions"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "model_name": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Model Name",
      "type": "string"
    },
    "model_response_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Model Response Hash",
      "type": "string"
    },
    "output_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Output Hash",
      "type": "string"
    },
    "parameters_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Parameters Hash",
      "type": "string"
    },
    "parameters_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Parameters Version",
      "type": "string"
    },
    "producer_name": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Producer Name",
      "type": "string"
    },
    "producer_type": {
      "const": "model",
      "default": "model",
      "title": "Producer Type",
      "type": "string"
    },
    "producer_version": {
      "pattern": "^[1-9]\\d*\\.\\d+\\.\\d+$",
      "title": "Producer Version",
      "type": "string"
    },
    "prompt_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Prompt Hash",
      "type": "string"
    },
    "prompt_name": {
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Prompt Name",
      "type": "string"
    },
    "prompt_version": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "step_key": {
      "const": "reasoning_literature",
      "default": "reasoning_literature",
      "title": "Step Key",
      "type": "string"
    }
  },
  "required": [
    "execution_id",
    "producer_name",
    "producer_version",
    "model_name",
    "prompt_name",
    "prompt_version",
    "prompt_hash",
    "schema_version",
    "parameters_version",
    "parameters_hash",
    "input_versions",
    "input_hash",
    "model_response_hash",
    "output_hash",
    "status",
    "started_at",
    "finished_at",
    "latency_ms"
  ],
  "title": "LiteratureClaimProducerExecution",
  "type": "object"
}
