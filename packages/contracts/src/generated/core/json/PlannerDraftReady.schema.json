{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "dataset",
        "field_dictionary",
        "source_collection",
        "paper_collection",
        "paper_summary",
        "literature_claims",
        "literature_relations",
        "reasoning_traces",
        "graph",
        "export"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "DataRequirements": {
      "additionalProperties": false,
      "properties": {
        "unit_policy": {
          "$ref": "#/$defs/UnitPolicy",
          "default": "canonical"
        }
      },
      "title": "DataRequirements",
      "type": "object"
    },
    "EvidenceRequirements": {
      "additionalProperties": false,
      "properties": {
        "minimum_coverage": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Coverage",
          "type": "number"
        },
        "require_locator": {
          "default": true,
          "title": "Require Locator",
          "type": "boolean"
        },
        "require_source_snapshot": {
          "default": true,
          "title": "Require Source Snapshot",
          "type": "boolean"
        }
      },
      "title": "EvidenceRequirements",
      "type": "object"
    },
    "PaperSearchScope": {
      "additionalProperties": false,
      "properties": {
        "keywords": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "max_candidates": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Candidates",
          "type": "integer"
        },
        "source_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "year_from": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year From"
        },
        "year_to": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year To"
        }
      },
      "title": "PaperSearchScope",
      "type": "object"
    },
    "QualityConstraints": {
      "additionalProperties": false,
      "properties": {
        "source_completeness_min": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Source Completeness Min",
          "type": "number"
        },
        "unit_consistency_min": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Unit Consistency Min",
          "type": "number"
        }
      },
      "title": "QualityConstraints",
      "type": "object"
    },
    "ResearchContractInput": {
      "additionalProperties": false,
      "description": "Shared scientific payload for an editable draft and immutable contract.",
      "properties": {
        "data_requirements": {
          "$ref": "#/$defs/DataRequirements"
        },
        "evidence_requirements": {
          "$ref": "#/$defs/EvidenceRequirements"
        },
        "output_requirements": {
          "items": {
            "$ref": "#/$defs/ArtifactKind"
          },
          "minItems": 1,
          "title": "Output Requirements",
          "type": "array"
        },
        "paper_search_scope": {
          "$ref": "#/$defs/PaperSearchScope"
        },
        "quality_constraints": {
          "$ref": "#/$defs/QualityConstraints"
        },
        "requested_fields": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Requested Fields",
          "type": "array"
        },
        "research_goal": {
          "maxLength": 500,
          "minLength": 4,
          "title": "Research Goal",
          "type": "string"
        },
        "source_scope": {
          "$ref": "#/$defs/SourceScope"
        },
        "target_objects": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Objects",
          "type": "array"
        }
      },
      "required": [
        "research_goal",
        "target_objects",
        "data_requirements",
        "requested_fields",
        "source_scope",
        "paper_search_scope",
        "output_requirements",
        "evidence_requirements",
        "quality_constraints"
      ],
      "title": "ResearchContractInput",
      "type": "object"
    },
    "SourceScope": {
      "additionalProperties": false,
      "properties": {
        "allowed_sources": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Sources",
          "type": "array"
        }
      },
      "required": [
        "allowed_sources"
      ],
      "title": "SourceScope",
      "type": "object"
    },
    "UnitPolicy": {
      "enum": [
        "canonical"
      ],
      "title": "UnitPolicy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assistant_message": {
      "minLength": 1,
      "title": "Assistant Message",
      "type": "string"
    },
    "contract": {
      "$ref": "#/$defs/ResearchContractInput"
    },
    "outcome": {
      "const": "draft_ready",
      "title": "Outcome",
      "type": "string"
    },
    "project_title": {
      "anyOf": [
        {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Title"
    },
    "public_analysis": {
      "maxLength": 500,
      "minLength": 12,
      "title": "Public Analysis",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "outcome",
    "public_analysis",
    "assistant_message",
    "contract"
  ],
  "title": "PlannerDraftReady",
  "type": "object"
}
