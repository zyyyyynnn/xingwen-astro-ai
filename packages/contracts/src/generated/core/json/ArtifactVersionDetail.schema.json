{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "dataset",
        "field_dictionary",
        "source_collection",
        "analysis_report",
        "visualization",
        "spectrum",
        "light_curve",
        "model_evaluation",
        "model_artifact",
        "paper_collection",
        "paper_summary",
        "literature_claims",
        "literature_relations",
        "graph",
        "export"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "EvidenceDetail": {
      "additionalProperties": false,
      "description": "Evidence bound to one immutable version and source snapshot.",
      "properties": {
        "artifact_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Version Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Evidence Type",
          "type": "string"
        },
        "extraction_method": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Extraction Method",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Locator",
          "type": "object"
        },
        "paper_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Id"
        },
        "quote_or_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Snapshot Id",
          "type": "string"
        },
        "target_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "target_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "artifact_version_id",
        "target_type",
        "target_id",
        "evidence_type",
        "source_snapshot_id",
        "locator",
        "extraction_method",
        "confidence",
        "created_at"
      ],
      "title": "EvidenceDetail",
      "type": "object"
    },
    "JsonValue": {},
    "ProducerExecutionDetail": {
      "additionalProperties": false,
      "description": "Reproducible producer metadata with private execution state excluded.",
      "properties": {
        "error_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "output_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Hash"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "parameters_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Parameters Hash",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerReference"
        },
        "provider_request_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Request Id"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "failed",
            "rejected",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "step_attempt_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Step Attempt Id",
          "type": "string"
        },
        "step_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Step Key",
          "type": "string"
        },
        "token_usage": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Usage"
        }
      },
      "required": [
        "id",
        "run_id",
        "step_key",
        "step_attempt_id",
        "producer",
        "parameters",
        "parameters_hash",
        "input_hash",
        "status",
        "started_at"
      ],
      "title": "ProducerExecutionDetail",
      "type": "object"
    },
    "ProducerReference": {
      "additionalProperties": false,
      "properties": {
        "explicit_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explicit Revision"
        },
        "model_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Provider"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parameters_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters Hash"
        },
        "prompt_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Hash"
        },
        "prompt_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Name"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "provider_returned_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Returned Model"
        },
        "requested_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Model"
        },
        "type": {
          "enum": [
            "pipeline",
            "model",
            "algorithm"
          ],
          "title": "Type",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "version"
      ],
      "title": "ProducerReference",
      "type": "object"
    },
    "PublicArtifactPresentation": {
      "additionalProperties": false,
      "description": "Single positive-contract presentation model shared by private/public UI.",
      "properties": {
        "entries": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicPresentationEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "facts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicPresentationFact"
          },
          "title": "Facts",
          "type": "array"
        },
        "graph_edges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicPresentationGraphEdge"
          },
          "title": "Graph Edges",
          "type": "array"
        },
        "graph_nodes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicPresentationGraphNode"
          },
          "title": "Graph Nodes",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "sections": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicPresentationSection"
          },
          "title": "Sections",
          "type": "array"
        },
        "summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "tables": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicPresentationTable"
          },
          "title": "Tables",
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "title": "PublicArtifactPresentation",
      "type": "object"
    },
    "PublicPresentationEntry": {
      "additionalProperties": false,
      "description": "One claim, relation, field, paper, or scientific finding.",
      "properties": {
        "assessment": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessment"
        },
        "can_adjudicate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Can Adjudicate"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "external_url": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Url"
        },
        "facts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicPresentationFact"
          },
          "title": "Facts",
          "type": "array"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "paragraphs": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Paragraphs",
          "type": "array"
        },
        "reasoning_trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicPresentationTrace"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "key",
        "title"
      ],
      "title": "PublicPresentationEntry",
      "type": "object"
    },
    "PublicPresentationFact": {
      "additionalProperties": false,
      "description": "One human-readable fact in the shared scientific presentation model.",
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "values": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "label",
        "values"
      ],
      "title": "PublicPresentationFact",
      "type": "object"
    },
    "PublicPresentationGraphEdge": {
